# ==============================================================================
# EQUISIGHT ALPHA: ZERO-TOUCH OPERATIONAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application & SEO
NODE_ENV=production
SITE_URL=https://equisight-alpha.com
PLATFORM_NAME="EquiSight Alpha"
CONTACT_EMAIL=editorial@equisight-alpha.com

# LLM Synthesis Agent Credentials (100% Free Antigravity Runtime)
# Supports 'agy' (Default free local agent runtime), 'openai', 'anthropic', 'gemini'
LLM_PROVIDER=agy
AGY_MODEL=gemini-3.8-flash-high
AGY_PATH=agy
AGY_TIMEOUT_MS=90000

# Web & Social Scraping Configuration (100% Free, Zero Paid Services)
# SEC EDGAR requires a contact user-agent format: <Organization/App> <contact email>
SEC_EDGAR_USER_AGENT="EquiSightResearch admin@equisight-alpha.com"

# Financial Data APIs (Optional Free Tiers - All 100% Free with Registration)
# Finnhub: Free 60 calls/minute at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here
# Alpha Vantage: Free 25 calls/day at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
# Financial Modeling Prep: Free tier at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_financial_modeling_prep_key_here

# Social Distribution Credentials (Optional Free Tiers)
# Twitter / X API v2
TWITTER_ENABLED=false
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# Reddit API (Free Script App at https://www.reddit.com/prefs/apps)
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_bot_username
REDDIT_PASSWORD=your_reddit_bot_password
REDDIT_SUBREDDIT=stocks

# Telegram Distribution (Free Alerts via Telegram Bot created with @BotFather)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=@equisight_alpha_channel

# Deployment Webhook (Cloudflare Pages, Vercel, or Netlify Free Deploy Hook)
DEPLOY_WEBHOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/xxxx
AUTO_TRIGGER_DEPLOY=false

# Operations & Scheduling
CRON_SCHEDULE_PREMARKET="0 7 * * 1-5"
CRON_SCHEDULE_POSTMARKET="30 16 * * 1-5"
TIMEZONE="America/New_York"

# Monetization & Affiliate IDs
AFFILIATE_IBKR_ID=EQUISIGHT_IBKR
AFFILIATE_WEBULL_ID=EQUISIGHT_WEBULL
AFFILIATE_TRADINGVIEW_ID=equisight_tv
AFFILIATE_SEEKINGALPHA_ID=equisight_sa
AFFILIATE_BENZINGA_ID=equisight_bz
AFFILIATE_LEDGER_ID=equisight_ledger
CARBON_ADS_PLACEMENT=equisight-alpha
GOOGLE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
