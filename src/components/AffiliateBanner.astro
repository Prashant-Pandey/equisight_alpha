---
import type { AffiliateLink } from '../types.js';

export interface Props {
  affiliate: AffiliateLink;
}

const { affiliate } = Astro.props;
---

<div class="my-6 p-5 rounded-xl border border-emerald-500/25 bg-gradient-to-r from-emerald-950/30 via-slate-900/60 to-slate-900/30 backdrop-blur-sm">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 px-2.5 py-0.5 rounded-full">
          {affiliate.badge || 'Sponsored Partner'}
        </span>
        <span class="text-xs text-slate-400 font-medium">{affiliate.name}</span>
      </div>
      <h4 class="text-base font-bold text-white tracking-tight">{affiliate.headline}</h4>
      <p class="text-xs text-slate-300 leading-relaxed max-w-2xl">{affiliate.description}</p>
    </div>
    <a
      href={affiliate.url}
      target="_blank"
      rel="noopener sponsored"
      class="inline-flex shrink-0 items-center justify-center px-5 py-2.5 text-xs font-bold text-slate-950 bg-emerald-400 hover:bg-emerald-300 rounded-lg transition-transform hover:-translate-y-0.5 shadow-lg shadow-emerald-500/10"
    >
      {affiliate.ctaText} &rarr;
    </a>
  </div>
  <div class="mt-3 pt-2 border-t border-slate-800/80 flex items-center justify-between text-[10px] text-slate-500">
    <span>{affiliate.disclosure}</span>
    <span class="text-slate-600 font-mono">FTC Sponsored Disclosure</span>
  </div>
</div>
