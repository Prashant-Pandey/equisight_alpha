      <div class="mt-3 p-3 rounded-lg bg-slate-900/60 border border-slate-800/80 text-xs">
        <div class="flex items-center justify-between gap-2 mb-1.5 flex-wrap">
          <div class="font-mono text-slate-300 font-semibold text-[11px] uppercase tracking-wider">
            Catalyst Dynamics & Expectations Gap
          </div>
          {data.catalystAlignment && (
            <span class={`font-mono text-[10px] font-bold px-2 py-0.5 rounded border ${
              data.catalystAlignment === 'ALIGNED' ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' :
              data.catalystAlignment === 'DIVERGENT_SELL_THE_NEWS' ? 'bg-amber-500/10 text-amber-400 border-amber-500/30' :
              data.catalystAlignment === 'DIVERGENT_RELIEF_RALLY' ? 'bg-indigo-500/10 text-indigo-400 border-indigo-500/30' :
              'bg-slate-700/30 text-slate-300 border-slate-700'
            }`}>
              {data.catalystAlignment}
            </span>
          )}
        </div>
        <div class="text-slate-300 leading-relaxed text-[12px]">{data.catalystSynthesis}</div>
      </div>
    )}
  </div>

  <!-- Bottom Strip: Current Market Price Bar -->
  <div class="px-4 py-2.5 bg-slate-950/80 rounded-xl border border-slate-800 flex flex-wrap items-center justify-between text-xs text-slate-400 gap-2">
    <div class="flex items-center gap-2">
      <span>Market Session Close:</span>
      <span class="text-slate-100 font-bold font-mono text-sm">{currentPrice ? `$${currentPrice.toFixed(2)} ${currency}` : 'N/A'}</span>
      <span class="text-slate-600">&bull;</span>
      <span>Annualized Div Yield: <strong class="text-slate-200 font-mono">{dividendYield !== null && dividendYield !== undefined && dividendYield > 0 ? `${dividendYield.toFixed(2)}%` : '0.00%'}</strong></span>
    </div>
    <div class="text-[11px] font-mono text-slate-400">
      Multi-Factor EquiSight Solvency Score: <strong class="text-emerald-400">{Math.max(1, 10 - riskScore)}/10</strong>
    </div>
  </div>

</div>
