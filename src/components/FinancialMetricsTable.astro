---
export interface Props {
  report?: any;
  metrics?: any;
}

const props = Astro.props;
const data = props.report || props.metrics || {};

const marketCap = data.marketCap ?? null;
const currentPrice = data.currentPrice ?? 0;
const currency = data.currency || 'USD';
const movePercent = data.movePercent ?? 0;
const isPositive = movePercent >= 0;
const peRatio = data.peRatio ?? null;
const forwardPE = data.forwardPE ?? null;
const dividendYield = data.dividendYield ?? null;
const riskScore = data.riskScore ?? 5;
const isPennyStock = data.isPennyStock ?? (currentPrice < 5);
const moneyMarketTradingVenue = data.moneyMarketTradingVenue || (data.exchange ? `${data.exchange} Primary Listed` : 'Nasdaq / NYSE');
const fundamentalRating = data.fundamentalRating || (riskScore <= 3 ? 'Strong' : riskScore <= 6 ? 'Fairly Valued' : 'Weak');
const classification = data.classification || (isPennyStock ? 'Speculative Penny Stock' : (peRatio && peRatio > 25 ? 'Growth Stock' : (dividendYield && dividendYield > 2 ? 'Income Stock' : 'Value / Turnaround')));
const returnOnEquity = data.returnOnEquity ?? null;

// Cash flow
const operatingCashFlow = data.cashFlow?.operatingCashFlow ?? data.operatingCashFlow ?? null;
const freeCashFlow = data.cashFlow?.freeCashFlow ?? data.freeCashFlow ?? null;
const cashFlowStatus = data.cashFlow?.status || (freeCashFlow !== null && freeCashFlow !== undefined ? (freeCashFlow >= 0 ? 'Positive Free Cash Flow' : 'Cash Burn / Capital Intensive') : 'Not Available');

// Debt Analysis
const debt = data.debtAnalysis || {};
const totalDebt = debt.totalDebt ?? null;
const debtToEquity = debt.debtToEquity ?? null;
const shortTermDebt = debt.shortTermDebt ?? null;
const longTermDebt = debt.longTermDebt ?? null;
const shortVsLongTermRatio = debt.shortVsLongTermRatio || 'Not Available';
const recentChanges = debt.recentChanges || 'Not Available';
const debtRisks = debt.risks || 'Not Available';
const debtLeverageLabel = debtToEquity !== null ? (debtToEquity > 1.2 ? 'Elevated Leverage' : 'Healthy Leverage') : 'N/A';

// Price-to-Book Ratio & Benchmarks
const pb = data.priceToBookRatio || {};
const currentPB = pb.current ?? null;
const industryAvgPB = pb.industryAverage ?? null;
const hist5YAvgPB = pb.historicalAverage5Y ?? null;

// Price-to-Earnings Ratio & Benchmarks
const pe = data.priceToEarningsRatio || {};
const currentPE = pe.current !== undefined && pe.current !== null ? pe.current : peRatio;
const industryAvgPE = pe.industryAverage ?? null;
const hist5YAvgPE = pe.historicalAverage5Y ?? null;

// EPS & 8-Quarter EPS Trend (Past 2 Years)
const epsObj = data.earningsPerShare || {};
const currentTTM = epsObj.currentTTM ?? (currentPE && currentPrice ? Number((currentPrice / currentPE).toFixed(2)) : null);
let quarterlyEPS = (epsObj.quarterlyEPSPast2Years && epsObj.quarterlyEPSPast2Years.length > 0)
  ? epsObj.quarterlyEPSPast2Years
  : [];

// Helpers
function formatCurrency(val: number | null | undefined): string {
  if (val === undefined || val === null || isNaN(val)) return 'N/A';
  const abs = Math.abs(val);
  const sign = val < 0 ? '-' : '';
  if (abs >= 1e9) return `${sign}$${(abs / 1e9).toFixed(2)}B`;
  if (abs >= 1e6) return `${sign}$${(abs / 1e6).toFixed(1)}M`;
  return `${sign}$${abs.toLocaleString()}`;
}

function formatEPS(val: number | null | undefined): string {
  if (val === undefined || val === null || isNaN(val)) return 'N/A';
  if (val < 0) return `-$${Math.abs(val).toFixed(2)}`;
  return `$${val.toFixed(2)}`;
}

// Ensure quarterly EPS is in chronological order (oldest -> newest, left -> right)
let sortedQuarterlyEPS = [...quarterlyEPS];
if (sortedQuarterlyEPS.length > 1) {
  const firstQ = sortedQuarterlyEPS[0].quarter || '';
  const lastQ = sortedQuarterlyEPS[sortedQuarterlyEPS.length - 1].quarter || '';
  const firstYearMatch = firstQ.match(/\d{2,4}/);
  const lastYearMatch = lastQ.match(/\d{2,4}/);
  if (firstYearMatch && lastYearMatch) {
    const firstYear = parseInt(firstYearMatch[0], 10);
    const lastYear = parseInt(lastYearMatch[0], 10);
    if (firstYear > lastYear) {
      sortedQuarterlyEPS.reverse();
    }
  }
}

// Volatility Index
const vol = data.volatilityIndex || {};
const volValue = vol.value ?? null;
const volRating = vol.rating || (volValue !== null ? (volValue > 1.3 ? 'High Volatility' : volValue < 0.9 ? 'Low Volatility' : 'Moderate Volatility') : 'Not Rated');

// Management Quality
const mgmt = data.managementQuality || {};
const mgmtRating = mgmt.rating || 'Not Rated';
const trackRecord = mgmt.trackRecord || 'Not Available';

// Competitive Moat
const moat = data.competitiveMoat || {};
const moatRating = moat.rating || 'Not Rated';
const moatSummary = moat.summary || 'Not Available';

// Risk Factor
const riskCategory = riskScore <= 3 ? 'Conservative / Low Risk' : riskScore <= 6 ? 'Core / Moderate Risk' : 'High Risk / Speculative';

// Artificial Inflation
const art = data.artificialInflation || {};
const isInflated = art.isInflated ?? false;
const inflationRiskLevel = art.riskLevel || (isPennyStock ? 'Moderate' : 'Low');
const volumeAnomalyRatio = art.volumeAnomalyRatio ?? null;
const majorPriceDriver = art.majorPriceDriver || 'Not Available';
const sentimentScore = art.sentimentScore !== undefined ? art.sentimentScore : null;
const newsImpact = art.newsImpact || 'Not Available';
const socialMediaImpact = art.socialMediaImpact || 'Not Available';

// Option Gamma Imbalance & Free Float Concentration
const optionGamma = art.optionGammaImbalance || data.optionGammaImbalance || null;
const freeFloat = art.freeFloatConcentration || data.freeFloatConcentration || null;

const volumeStatusLabel = volumeAnomalyRatio !== null ? (volumeAnomalyRatio > 1.5 ? 'Unusual Volume Spike' : 'Within Normal Range') : 'N/A';
const sentimentLabel = sentimentScore !== null ? (sentimentScore >= 0.6 ? 'Constructive / Bullish' : sentimentScore <= 0.4 ? 'Bearish / Defensive' : 'Neutral Skew') : 'N/A';

// Chart calculations for P/B
const validPB = currentPB ?? 0;
const validIndPB = industryAvgPB ?? 0;
const validHistPB = hist5YAvgPB ?? 0;
const maxPB = Math.max(validPB, validIndPB, validHistPB, 1.0) * 1.25;
const pbBarWidthCurrent = currentPB !== null ? Math.max(12, Math.min(220, Math.round((currentPB / maxPB) * 220))) : 0;
const pbBarWidthIndustry = industryAvgPB !== null ? Math.max(12, Math.min(220, Math.round((industryAvgPB / maxPB) * 220))) : 0;
const pbBarWidth5Y = hist5YAvgPB !== null ? Math.max(12, Math.min(220, Math.round((hist5YAvgPB / maxPB) * 220))) : 0;
const pbDiffVal = (currentPB !== null && industryAvgPB) ? (((currentPB - industryAvgPB) / industryAvgPB) * 100) : null;
const pbDiffPercent = pbDiffVal !== null ? pbDiffVal.toFixed(1) : 'N/A';
const isPBDiscount = pbDiffVal !== null ? pbDiffVal <= 0 : true;

// Chart calculations for P/E
const isPEProfitable = currentPE !== null && currentPE > 0;
const validPE = isPEProfitable ? currentPE! : 0;
const validIndPE = industryAvgPE ?? 0;
const validHistPE = hist5YAvgPE ?? 0;
const maxPE = Math.max(validPE, validIndPE, validHistPE, 10) * 1.25;
const peBarWidthCurrent = isPEProfitable ? Math.max(12, Math.min(220, Math.round((validPE / maxPE) * 220))) : 0;
const peBarWidthIndustry = industryAvgPE !== null ? Math.max(12, Math.min(220, Math.round((industryAvgPE / maxPE) * 220))) : 0;
const peBarWidth5Y = hist5YAvgPE !== null ? Math.max(12, Math.min(220, Math.round((validHistPE / maxPE) * 220))) : 0;
const peDiffVal = (isPEProfitable && industryAvgPE) ? (((validPE - industryAvgPE) / industryAvgPE) * 100) : null;
const peDiffPercent = peDiffVal !== null ? peDiffVal.toFixed(1) : 'N/A';
const isPEDiscount = peDiffVal !== null ? peDiffVal <= 0 : true;

// Chart calculations for 8-Quarter EPS
const epsValues = sortedQuarterlyEPS.map((q: any) => Number(q.eps) || 0);
const hasPosEPS = epsValues.some((val: number) => val > 0);
const hasNegEPS = epsValues.some((val: number) => val < 0);
const maxAbsEPS = Math.max(...epsValues.map((val: number) => Math.abs(val)), 0.01);

let zeroY = 90;
let maxBarHeight = 55;
let svgViewBoxHeight = 190;
let xAxisLabelY = 172;

if (hasNegEPS && !hasPosEPS) {
  // All quarters are losses
  zeroY = 35;
  maxBarHeight = 90;
  svgViewBoxHeight = 185;
  xAxisLabelY = 166;
} else if (hasPosEPS && !hasNegEPS) {
  // All quarters are positive
  zeroY = 140;
  maxBarHeight = 90;
  svgViewBoxHeight = 185;
  xAxisLabelY = 166;
} else {
  // Mixed positive and loss quarters
  zeroY = 90;
  maxBarHeight = 55;
  svgViewBoxHeight = 190;
  xAxisLabelY = 172;
}
---

<div class="my-8 rounded-2xl border border-slate-800 bg-slate-900/60 overflow-hidden shadow-xl space-y-6 p-4 sm:p-6">
  
  <!-- Section 1: Dashboard Header & Core Classification Badges -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-5 border-b border-slate-800">
    <div>
      <div class="flex flex-wrap items-center gap-2 mb-1.5">
        <span class="text-xs font-mono uppercase tracking-wider text-slate-400">Institutional Analytics</span>
        <span class="text-slate-600">&bull;</span>
        <span class="text-xs font-mono font-medium px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">
          Venue: {moneyMarketTradingVenue}
        </span>
        {isPennyStock && (
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-amber-950 text-amber-400 border border-amber-800/60">
            Micro-Cap / Penny Stock
          </span>
        )}
      </div>
      <h3 class="text-lg sm:text-xl font-extrabold text-white tracking-tight flex items-center gap-2">
        <span>Comprehensive Stock Analytics & Fundamental Matrix</span>
      </h3>
    </div>

    <!-- Rating Badges -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Fundamental Rating Badge -->
      <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg border text-xs font-bold font-mono"
        class:list={[
          fundamentalRating === 'Strong' ? 'bg-emerald-950/80 border-emerald-500/40 text-emerald-400' :
          fundamentalRating === 'Fairly Valued' ? 'bg-sky-950/80 border-sky-500/40 text-sky-400' :
          'bg-rose-950/80 border-rose-500/40 text-rose-400'
        ]}>
        <span class="text-[10px] uppercase font-sans text-slate-400">Fundamentals:</span>
        <span>{fundamentalRating}</span>
      </div>

      <!-- Classification Badge -->
      <span class="px-3 py-1 rounded-lg bg-indigo-950/80 border border-indigo-500/40 text-indigo-300 text-xs font-mono font-semibold">
        {classification}
      </span>

      <!-- Session Move Badge -->
      <span class={`text-xs font-mono font-bold px-3 py-1 rounded-lg border ${isPositive ? 'bg-emerald-950/80 text-emerald-400 border-emerald-500/40' : 'bg-rose-950/80 text-rose-400 border-rose-500/40'}`}>
        {isPositive ? '+' : ''}{movePercent.toFixed(2)}% Session
      </span>
    </div>
  </div>

  <!-- Section 2: Core Valuation Multiples & Key Financial Indicators -->
  <div>
    <div class="text-xs font-mono font-semibold text-slate-400 uppercase tracking-wider mb-3">
      1. Core Valuation Multiples & Return Metrics
    </div>
    <div class="flex flex-wrap gap-3">
      <!-- Market Cap -->
      <div class="flex-1 min-w-[160px] max-w-full p-3.5 rounded-xl border border-slate-800/80 bg-slate-950/50">
        <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 whitespace-nowrap max-sm:whitespace-normal">Market Cap</div>
        <div class="text-base sm:text-lg font-bold font-mono text-white mt-0.5 whitespace-nowrap max-sm:whitespace-normal">
          {formatCurrency(marketCap)}
        </div>
        <div class="text-[10px] text-slate-500 mt-0.5 whitespace-nowrap max-sm:whitespace-normal">Consolidated Equity</div>
      </div>

      <!-- Trailing P/E -->
      <div class="flex-1 min-w-[160px] max-w-full p-3.5 rounded-xl border border-slate-800/80 bg-slate-950/50">
        <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 whitespace-nowrap max-sm:whitespace-normal">Trailing P/E</div>
        <div class="text-base sm:text-lg font-bold font-mono text-white mt-0.5 whitespace-nowrap max-sm:whitespace-normal">
          {peRatio ? `${peRatio.toFixed(1)}x` : 'N/A (Deficit)'}
        </div>
        <div class="text-[10px] text-slate-500 mt-0.5 whitespace-nowrap max-sm:whitespace-normal">Price / TTM EPS</div>
      </div>

      <!-- Forward P/E -->
      <div class="flex-1 min-w-[160px] max-w-full p-3.5 rounded-xl border border-slate-800/80 bg-slate-950/50">
        <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 whitespace-nowrap max-sm:whitespace-normal">Forward P/E</div>
        <div class="text-base sm:text-lg font-bold font-mono text-white mt-0.5 whitespace-nowrap max-sm:whitespace-normal">
          {forwardPE ? `${forwardPE.toFixed(1)}x` : 'N/A'}
        </div>
        <div class="text-[10px] text-slate-500 mt-0.5 whitespace-nowrap max-sm:whitespace-normal">NTM Consensus</div>
      </div>

      <!-- Return on Equity (ROE) -->
      <div class="flex-1 min-w-[160px] max-w-full p-3.5 rounded-xl border border-slate-800/80 bg-slate-950/50">
        <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 whitespace-nowrap max-sm:whitespace-normal">Return on Equity</div>
        <div class="text-base sm:text-lg font-bold font-mono text-emerald-400 mt-0.5 whitespace-nowrap max-sm:whitespace-normal">
          {returnOnEquity !== null && returnOnEquity !== undefined ? `${returnOnEquity.toFixed(1)}%` : 'N/A'}
        </div>
        <div class="text-[10px] text-slate-500 mt-0.5 whitespace-nowrap max-sm:whitespace-normal">Net Income / Equity</div>
      </div>

      <!-- Earnings Per Share (TTM) -->
      <div class="flex-1 min-w-[160px] max-w-full p-3.5 rounded-xl border border-slate-800/80 bg-slate-950/50">
        <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 whitespace-nowrap max-sm:whitespace-normal">EPS (TTM)</div>
        <div class="text-base sm:text-lg font-bold font-mono text-white mt-0.5 whitespace-nowrap max-sm:whitespace-normal">
          {currentTTM !== null && currentTTM !== undefined ? formatEPS(currentTTM) : 'N/A'}
        </div>
        <div class="text-[10px] text-slate-500 mt-0.5 whitespace-nowrap max-sm:whitespace-normal">Trailing 12-Month</div>
      </div>

      <!-- Volatility Index / Beta -->
      <div class="flex-1 min-w-[180px] max-w-full p-3.5 rounded-xl border border-slate-800/80 bg-slate-950/50">
        <div class="text-[10px] font-mono uppercase tracking-wider text-slate-400 whitespace-nowrap max-sm:whitespace-normal">Volatility (Beta)</div>
        <div class="text-base sm:text-lg font-bold font-mono text-amber-400 mt-0.5 flex items-center justify-between gap-2 whitespace-nowrap max-sm:whitespace-normal">
          <span>{volValue !== null && volValue !== undefined ? volValue.toFixed(2) : 'N/A'}</span>
          <span class="text-[10px] font-normal px-1.5 py-0.2 rounded bg-amber-950/80 border border-amber-800/50 text-amber-300">
            {volRating.replace(' Volatility', '')}
          </span>
        </div>
        <div class="text-[10px] text-slate-500 mt-0.5 whitespace-nowrap max-sm:whitespace-normal">Relative to S&P 500</div>
      </div>
    </div>
  </div>

  <!-- Section 3: Valuation Benchmarks Charts (P/B and P/E vs Industry & 5Y History) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <!-- Chart A: Price-to-Book Ratio Chart -->
    <div class="p-4 sm:p-5 rounded-xl border border-slate-800 bg-slate-950/40 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <div class="text-xs font-mono font-bold text-slate-200">Price-to-Book (P/B) Ratio Comparison</div>
          <span class={`text-[11px] font-mono font-bold px-2 py-0.5 rounded ${isPBDiscount ? 'bg-emerald-950 text-emerald-400 border border-emerald-800/50' : 'bg-rose-950 text-rose-400 border border-rose-800/50'}`}>
            {isPBDiscount ? '' : '+'}{pbDiffPercent}% vs Industry
          </span>
        </div>
        <p class="text-[11px] text-slate-400 mb-3">
          Comparing equity valuation multiples against industry median and 5-year historical average.
        </p>

        <!-- SVG Horizontal Bar Chart -->
        <div class="w-full bg-slate-900/60 p-3 rounded-lg border border-slate-800/70">
          <svg viewBox="0 0 380 120" class="w-full h-auto" role="img" aria-label="Price to Book Ratio Benchmark Chart">
            <!-- Gridlines -->
            <line x1="120" y1="10" x2="120" y2="105" stroke="#334155" stroke-dasharray="3,3" stroke-width="1" />
            <line x1="240" y1="10" x2="240" y2="105" stroke="#334155" stroke-dasharray="3,3" stroke-width="1" />
            <line x1="360" y1="10" x2="360" y2="105" stroke="#334155" stroke-dasharray="3,3" stroke-width="1" />

            <!-- Bar 1: Current Stock P/B -->
            <text x="5" y="30" fill="#94a3b8" font-size="11" font-family="monospace" font-weight="bold">Current Stock</text>
            <rect x="120" y="16" width={pbBarWidthCurrent} height="18" rx="4" fill="#10b981" />
            <text x={125 + pbBarWidthCurrent} y="30" fill="#f8fafc" font-size="11" font-family="monospace" font-weight="bold">
              {currentPB !== null ? `${currentPB.toFixed(2)}x` : 'N/A'}
            </text>

            <!-- Bar 2: Industry Average -->
            <text x="5" y="65" fill="#94a3b8" font-size="11" font-family="monospace">Industry Avg</text>
            <rect x="120" y="51" width={pbBarWidthIndustry} height="18" rx="4" fill="#38bdf8" />
            <text x={125 + pbBarWidthIndustry} y="65" fill="#f8fafc" font-size="11" font-family="monospace" font-weight="bold">
              {industryAvgPB !== null ? `${industryAvgPB.toFixed(2)}x` : 'N/A'}
            </text>

            <!-- Bar 3: 5Y Historical Avg -->
            <text x="5" y="100" fill="#94a3b8" font-size="11" font-family="monospace">5Y Hist. Avg</text>
            <rect x="120" y="86" width={pbBarWidth5Y} height="18" rx="4" fill="#a855f7" />
            <text x={125 + pbBarWidth5Y} y="100" fill="#f8fafc" font-size="11" font-family="monospace" font-weight="bold">
              {hist5YAvgPB !== null ? `${hist5YAvgPB.toFixed(2)}x` : 'N/A'}
            </text>
          </svg>
        </div>
      </div>
      <div class="text-[10px] text-slate-500 mt-2 flex justify-between">
        <span>Current: <strong class="text-slate-300 font-mono">{currentPB !== null ? `${currentPB.toFixed(2)}x` : 'N/A'}</strong></span>
        <span>Industry: <strong class="text-slate-300 font-mono">{industryAvgPB !== null ? `${industryAvgPB.toFixed(2)}x` : 'N/A'}</strong></span>
        <span>5Y Avg: <strong class="text-slate-300 font-mono">{hist5YAvgPB !== null ? `${hist5YAvgPB.toFixed(2)}x` : 'N/A'}</strong></span>
      </div>
    </div>

    <!-- Chart B: Price-to-Earnings Ratio Chart -->
    <div class="p-4 sm:p-5 rounded-xl border border-slate-800 bg-slate-950/40 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-2">
          <div class="text-xs font-mono font-bold text-slate-200">Price-to-Earnings (P/E) Ratio Comparison</div>
          {isPEProfitable ? (
            <span class={`text-[11px] font-mono font-bold px-2 py-0.5 rounded ${isPEDiscount ? 'bg-emerald-950 text-emerald-400 border border-emerald-800/50' : 'bg-rose-950 text-rose-400 border border-rose-800/50'}`}>
              {isPEDiscount ? '' : '+'}{peDiffPercent}% vs Industry
            </span>
          ) : (
            <span class="text-[11px] font-mono font-bold px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700">
              Negative / Unprofitable
            </span>
          )}
        </div>
        <p class="text-[11px] text-slate-400 mb-3">
          Comparing trailing earnings multiple relative to peer sector average and 5-year cyclical median.
        </p>

        <!-- SVG Horizontal Bar Chart -->
        <div class="w-full bg-slate-900/60 p-3 rounded-lg border border-slate-800/70">
          <svg viewBox="0 0 380 120" class="w-full h-auto" role="img" aria-label="Price to Earnings Ratio Benchmark Chart">
            <!-- Gridlines -->
            <line x1="120" y1="10" x2="120" y2="105" stroke="#334155" stroke-dasharray="3,3" stroke-width="1" />
            <line x1="240" y1="10" x2="240" y2="105" stroke="#334155" stroke-dasharray="3,3" stroke-width="1" />
            <line x1="360" y1="10" x2="360" y2="105" stroke="#334155" stroke-dasharray="3,3" stroke-width="1" />

            <!-- Bar 1: Current Stock P/E -->
            <text x="5" y="30" fill="#94a3b8" font-size="11" font-family="monospace" font-weight="bold">Current Stock</text>
            {isPEProfitable ? (
              <g>
                <rect x="120" y="16" width={peBarWidthCurrent} height="18" rx="4" fill="#10b981" />
                <text x={125 + peBarWidthCurrent} y="30" fill="#f8fafc" font-size="11" font-family="monospace" font-weight="bold">
                  {currentPE ? currentPE.toFixed(1) : ''}x
                </text>
              </g>
            ) : (
              <text x="125" y="30" fill="#f43f5e" font-size="11" font-family="monospace" font-weight="bold">
                Deficit / Negative P/E
              </text>
            )}

            <!-- Bar 2: Industry Average -->
            <text x="5" y="65" fill="#94a3b8" font-size="11" font-family="monospace">Industry Avg</text>
            <rect x="120" y="51" width={peBarWidthIndustry} height="18" rx="4" fill="#38bdf8" />
            <text x={125 + peBarWidthIndustry} y="65" fill="#f8fafc" font-size="11" font-family="monospace" font-weight="bold">
              {industryAvgPE !== null ? `${industryAvgPE.toFixed(1)}x` : 'N/A'}
            </text>

            <!-- Bar 3: 5Y Historical Avg -->
            <text x="5" y="100" fill="#94a3b8" font-size="11" font-family="monospace">5Y Hist. Avg</text>
            <rect x="120" y="86" width={peBarWidth5Y} height="18" rx="4" fill="#a855f7" />
            <text x={125 + peBarWidth5Y} y="100" fill="#f8fafc" font-size="11" font-family="monospace" font-weight="bold">
              {hist5YAvgPE !== null ? `${hist5YAvgPE.toFixed(1)}x` : 'N/A'}
            </text>
          </svg>
        </div>
      </div>
      <div class="text-[10px] text-slate-500 mt-2 flex justify-between">
        <span>Current: <strong class="text-slate-300 font-mono">{isPEProfitable && currentPE ? `${currentPE.toFixed(1)}x` : 'N/A'}</strong></span>
        <span>Industry: <strong class="text-slate-300 font-mono">{industryAvgPE !== null ? `${industryAvgPE.toFixed(1)}x` : 'N/A'}</strong></span>
        <span>5Y Avg: <strong class="text-slate-300 font-mono">{hist5YAvgPE !== null ? `${hist5YAvgPE.toFixed(1)}x` : 'N/A'}</strong></span>
      </div>
    </div>
  </div>

  <!-- Section 4: 8-Quarter EPS Trend Chart (Past 2 Years) -->
