---
import ComplianceDisclaimer from './ComplianceDisclaimer.astro';
import { path } from '../utils/paths';
---

<footer class="bg-[#121212] border-t border-[#2e2e2e] text-[#8e8e8e] text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Mandatory Legal Exemption Box -->
    <ComplianceDisclaimer variant="full" />

    <!-- 12-Column Utilitarian Directory Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 my-6 pt-6 border-t border-[#222222]">
      <!-- System Architecture Info (4 cols) -->
      <div class="md:col-span-4 space-y-2">
        <div class="flex items-center gap-2">
          <span class="w-5 h-5 bg-[#0055ff] text-white flex items-center justify-center font-mono font-bold text-xs">E</span>
          <span class="font-mono font-bold text-white tracking-tight uppercase">EquiSight Alpha</span>
        </div>
        <p class="text-[11px] text-[#8e8e8e] leading-relaxed">
          Autonomous equity intelligence terminal. Systematic algorithmic pipeline indexing valuation multiples, DCF consensus models, and balance sheet solvency checks across US & European exchanges.
        </p>
        <div class="font-mono text-[10px] text-[#666666]">
          SPEC: WCAG 2.2 AA · 12-COL MODULAR GRID · ZERO-DECORATION
        </div>
      </div>

      <!-- Navigation & Archetypes (3 cols) -->
      <div class="md:col-span-3">
        <h4 class="text-[11px] font-mono font-bold text-[#e5e5e5] uppercase tracking-wider mb-2 pb-1 border-b border-[#2e2e2e]">Coverage & Screening</h4>
        <ul class="space-y-1.5 text-[11px] font-mono">
          <li><a href={path('/reports')} class="hover:text-[#0055ff] transition-none">&rsaquo; Research Database (All Securities)</a></li>
          <li><a href={path('/#strategy-moat')} class="hover:text-[#0055ff] transition-none">&rsaquo; Wide Moat Archetype</a></li>
          <li><a href={path('/#strategy-pead')} class="hover:text-[#0055ff] transition-none">&rsaquo; PEAD Catalyst Screening</a></li>
          <li><a href={path('/#strategy-contrarian')} class="hover:text-[#0055ff] transition-none">&rsaquo; Contrarian Quality Pullbacks</a></li>
          <li><a href={path('/#strategy-quant')} class="hover:text-[#0055ff] transition-none">&rsaquo; Multi-Factor Quant Composite</a></li>
        </ul>
      </div>

      <!-- Statutory & Legal (3 cols) -->
      <div class="md:col-span-3">
        <h4 class="text-[11px] font-mono font-bold text-[#e5e5e5] uppercase tracking-wider mb-2 pb-1 border-b border-[#2e2e2e]">Regulatory Disclosures</h4>
        <ul class="space-y-1.5 text-[11px] font-mono">
          <li><a href={path('/definitions')} class="hover:text-[#0055ff] transition-none">&rsaquo; Definitions & Heuristics Registry</a></li>
          <li><a href={path('/disclaimer')} class="hover:text-[#0055ff] transition-none">&rsaquo; Publisher's Exemption Statement</a></li>
          <li><a href={path('/disclaimer#sec')} class="hover:text-[#0055ff] transition-none">&rsaquo; Investment Advisers Act of 1940</a></li>
          <li><a href={path('/disclaimer#finra')} class="hover:text-[#0055ff] transition-none">&rsaquo; FINRA Rule 2210 Compliance</a></li>
          <li><a href={path('/disclaimer#methodology')} class="hover:text-[#0055ff] transition-none">&rsaquo; Quantitative Verification Model</a></li>
        </ul>
      </div>

      <!-- Feeds & Machine Readability (2 cols) -->
      <div class="md:col-span-2">
        <h4 class="text-[11px] font-mono font-bold text-[#e5e5e5] uppercase tracking-wider mb-2 pb-1 border-b border-[#2e2e2e]">Data Feeds</h4>
        <ul class="space-y-1.5 text-[11px] font-mono">
          <li><a href={path('/rss.xml')} class="hover:text-[#0055ff] transition-none">&rsaquo; RSS 2.0 XML</a></li>
          <li><a href={path('/sitemap-index.xml')} class="hover:text-[#0055ff] transition-none">&rsaquo; Sitemap Index</a></li>
          <li><a href={path('/definitions')} class="hover:text-[#0055ff] transition-none">&rsaquo; JSON Specs</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright & Utility Bar -->
    <div class="pt-4 border-t border-[#222222] flex flex-col sm:flex-row items-center justify-between text-[11px] font-mono text-[#666666] gap-2">
      <div>
        &copy; {new Date().getFullYear()} EQUISIGHT ANALYTICS MEDIA LLC. FORM FOLLOWS FUNCTION.
      </div>
      <div>
        STATUTORY EXEMPTION UNDER SECTION 202(a)(11)(D). ZERO INVESTMENT ADVICE.
      </div>
    </div>
  </div>
</footer>
