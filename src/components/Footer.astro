---
import ComplianceDisclaimer from './ComplianceDisclaimer.astro';
---

<footer class="bg-slate-950 border-t border-slate-800 text-slate-400 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Mandatory Legal Exemption Box -->
    <ComplianceDisclaimer variant="full" />

    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 my-10 pt-8 border-t border-slate-800/80">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <div class="w-6 h-6 rounded bg-emerald-500 flex items-center justify-center text-slate-950 font-bold text-xs">E</div>
          <span class="text-sm font-bold text-white">EquiSight Alpha</span>
        </div>
        <p class="text-[11px] text-slate-400 leading-relaxed">
          Zero-touch automated equity intelligence and fundamental research engine. Publishing 10 evidence-based deep dives daily across US and European exchanges.
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3">Research Streams</h4>
        <ul class="space-y-2 text-[11px]">
          <li><a href="/reports" class="hover:text-emerald-400 transition-colors">Daily Top 5 Gainers</a></li>
          <li><a href="/reports" class="hover:text-emerald-400 transition-colors">Daily Top 5 Pullbacks</a></li>
          <li><a href="/reports" class="hover:text-emerald-400 transition-colors">European Equities Coverage</a></li>
          <li><a href="/reports" class="hover:text-emerald-400 transition-colors">US Large-Cap Multiples</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3">Regulatory & Legal</h4>
        <ul class="space-y-2 text-[11px]">
          <li><a href="/disclaimer" class="hover:text-amber-400 transition-colors">Publisher's Exemption Statement</a></li>
          <li><a href="/disclaimer#sec" class="hover:text-amber-400 transition-colors">Investment Advisers Act of 1940</a></li>
          <li><a href="/disclaimer#finra" class="hover:text-amber-400 transition-colors">FINRA Rule 2210 Notice</a></li>
          <li><a href="/disclaimer#affiliate" class="hover:text-amber-400 transition-colors">FTC Affiliate Disclosures</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-3">Syndication & Feeds</h4>
        <ul class="space-y-2 text-[11px]">
          <li><a href="/rss.xml" class="hover:text-emerald-400 transition-colors">Automated RSS 2.0 Feed</a></li>
          <li><a href="/sitemap-index.xml" class="hover:text-emerald-400 transition-colors">Dynamic XML Sitemap</a></li>
          <li><a href="https://twitter.com" target="_blank" rel="noopener" class="hover:text-emerald-400 transition-colors">Twitter / X Distribution</a></li>
          <li><a href="https://reddit.com/r/stocks" target="_blank" rel="noopener" class="hover:text-emerald-400 transition-colors">Reddit Analytical Syndication</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-[11px] text-slate-500 gap-4">
      <div>
        &copy; {new Date().getFullYear()} EquiSight Analytics Media LLC. All rights reserved.
      </div>
      <div class="text-[10px] text-slate-400 text-center sm:text-right">
        Algorithmic equity analysis does not constitute investment advice. Capital is subject to market volatility.
      </div>
    </div>
  </div>
</footer>
