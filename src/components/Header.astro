---
import { path } from '../utils/paths';
---

<header class="sticky top-0 z-50 bg-[#121212] border-b border-[#2e2e2e]">
  <!-- Top Utilitarian Utility & Status Bar -->
  <div class="border-b border-[#222222] bg-[#181818] px-4 sm:px-6 lg:px-8 py-1 text-[11px] font-mono text-[#8e8e8e] flex items-center justify-between">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5 text-[#e5e5e5]">
        <span class="inline-block w-2 h-2 bg-[#00cc66]"></span>
        TERMINAL FEED: ACTIVE
      </span>
      <span class="hidden md:inline text-[#2e2e2e]">|</span>
      <span class="hidden md:inline">SYSTEM: RE-SCREENED 10 MIN INTERVALS</span>
    </div>
    <div class="flex items-center gap-4">
      <a href={path('/definitions')} class="hover:text-[#0055ff] transition-none">METHODOLOGY REGISTRY</a>
      <span class="text-[#2e2e2e]">|</span>
      <a href={path('/rss.xml')} class="hover:text-[#0055ff] transition-none flex items-center gap-1">
        <span>RSS FEED</span>
      </a>
    </div>
  </div>

  <!-- Primary Navigation Bar (12-col modular header) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-12 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href={path('/')} class="flex items-center gap-2 font-mono font-bold text-sm text-[#e5e5e5] hover:text-[#0055ff] transition-none">
        <span class="px-1.5 py-0.5 bg-[#0055ff] text-white text-xs font-mono font-black">EQ</span>
        <span class="tracking-tight uppercase">EquiSight Alpha</span>
      </a>

      <!-- Direct Persistent Text Links (Max 5-7 top-level items, instant 2-click access) -->
      <nav class="hidden md:flex items-center gap-1 font-mono text-xs text-[#8e8e8e]" aria-label="Main Navigation">
        <a href={path('/')} class="px-2.5 py-1 text-[#e5e5e5] hover:text-white hover:bg-[#181818] transition-none">
          RADAR
        </a>
        <a href={path('/reports')} class="px-2.5 py-1 hover:text-[#e5e5e5] hover:bg-[#181818] transition-none">
          DATABASE
        </a>
        <a href={path('/definitions')} class="px-2.5 py-1 hover:text-[#e5e5e5] hover:bg-[#181818] transition-none">
          HEURISTICS
        </a>
        <a href={path('/disclaimer')} class="px-2.5 py-1 hover:text-[#e5e5e5] hover:bg-[#181818] transition-none">
          DISCLAIMER
        </a>
      </nav>
    </div>

    <!-- Right Primary Action Button -->
    <div class="flex items-center gap-2">
      <a
        href={path('/reports')}
        class="inline-flex items-center justify-center px-3 py-1 text-xs font-mono font-semibold text-white bg-[#0055ff] hover:bg-[#0044cc] border border-[#0055ff] transition-none tap-target"
      >
        [ ENTER RESEARCH ARCHIVE ]
      </a>
    </div>
  </div>
</header>
