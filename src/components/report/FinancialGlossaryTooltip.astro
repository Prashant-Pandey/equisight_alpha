---
interface Props {
  term: string;
  definition?: string;
  context?: string;
  class?: string;
}

const { term, definition, context, class: extraClass = '' } = Astro.props;

// Default glossary dictionary for financial intelligence
const GLOSSARY: Record<string, { def: string; ctx: string }> = {
  'RVOL': {
    def: 'Relative Volume (RVOL) compares current trading session volume to the historical 90-day moving average volume.',
    ctx: 'Values above 1.5x indicate unusual institutional block accumulation or liquidations rather than retail noise.'
  },
  'Net Gamma Exposure': {
    def: 'Measures options market makers\' directional hedging acceleration as spot price shifts through open interest strikes.',
    ctx: 'Positive gamma dampens volatility; negative gamma forces dealers to aggressively buy in rallies and sell in declines.'
  },
  '3-Stage Moat Fade': {
    def: 'Morningstar discounted cash flow model dividing growth into: (1) Explicit High-Growth, (2) Competitive Fade, and (3) Terminal Perpetual Growth.',
    ctx: 'Companies with Wide Moats fade over 15-20 years, Narrow Moats over 10 years, and No Moat over 3-5 years.'
  },
  'WACC': {
    def: 'Weighted Average Cost of Capital: The blended required rate of return demanding by equity holders and debt providers.',
    ctx: 'Serves as the intrinsic discount rate to pull future projected cash flows into present dollar terms.'
  },
  'Intrinsic FVE': {
    def: 'Consensus Fair Value Estimate: The fundamentally justified per-share intrinsic worth based on discounted multi-method cash flows.',
    ctx: 'Represents long-term enterprise value irrespective of short-term speculative market fluctuations.'
  },
  'Margin of Safety': {
    def: 'The percentage discount between current market price and intrinsic fair value estimate required before deploying capital.',
    ctx: 'Morningstar 5-Star threshold typically requires a 20% to 40% margin of safety depending on uncertainty.'
  },
  'Float Turnover': {
    def: 'The ratio of daily volume traded to total freely floating public shares available on national exchanges.',
    ctx: 'High turnover (>20%) signals speculative churn and potential short/gamma squeeze instability.'
  },
  'Solvency Safe': {
    def: 'A balance sheet health assessment indicating that cash reserves and operating cash flow easily cover short-term debt maturities.',
    ctx: 'Protects equity holders from dilutive emergency capital raises or credit rating downgrades.'
  }
};

const entry = GLOSSARY[term] || {
  def: definition || 'Institutional financial metric used for equity valuation and balance sheet stress testing.',
  ctx: context || 'Contextual analytical metric.'
};

const finalDef = definition || entry.def;
const finalCtx = context || entry.ctx;
---

<span class={`glossary-tooltip-container relative inline-block group cursor-help ${extraClass}`}>
  <span class="border-b border-dotted border-slate-400 group-hover:border-emerald-400 group-hover:text-emerald-300 transition-colors">
    <slot>{term}</slot>
  </span>
  
  <!-- Popover card -->
  <span
    role="tooltip"
    class="invisible group-hover:visible opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 z-50 w-64 p-3 rounded-xl bg-slate-900 border border-slate-700 shadow-2xl text-left"
  >
    <span class="block text-[11px] font-mono font-bold text-emerald-400 mb-1 flex items-center gap-1">
      <svg class="w-3 h-3 inline-block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      {term}
    </span>
    <span class="block text-[11px] text-slate-300 leading-snug mb-1.5 font-sans">
      {finalDef}
    </span>
    {finalCtx && (
      <span class="block text-[10px] text-slate-400 border-t border-slate-800 pt-1 font-sans italic">
        💡 {finalCtx}
      </span>
    )}
    <!-- Pointer arrow -->
    <span class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-700"></span>
  </span>
</span>
