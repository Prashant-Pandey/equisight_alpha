---
import { formatCurrency, formatEPS } from '../../utils/formatters';
import {
  getEconomicMoat,
  getMoatTrend,
  getConsensusVerdict,
  getConsensusVerdictColor,
  getStarRatingString,
  getDebtLeverageLabel
} from '../../utils/financialClassification';

interface Props {
  report: any;
}

const { report } = Astro.props;

// Valuation & Star Ratings
const currentPrice = report.currentPrice || 0;
const starRating = report.starRating || report.morningstarRating?.starRating || null;
const starRatingString = getStarRatingString(
  report.starRatingString || report.morningstarRating?.starRatingString,
  starRating
);
const uncertaintyRating = report.uncertaintyRating || report.morningstarRating?.uncertaintyRating || 'Medium';
const fiveStarPrice = report.fiveStarPrice || report.morningstarRating?.fiveStarPrice || null;
const oneStarPrice = report.oneStarPrice || report.morningstarRating?.oneStarPrice || null;

// Consensus Fair Value
const consensusFairValue = report.valuationModels?.consensusFairValue ?? null;
const consensusUpside = consensusFairValue !== null && currentPrice > 0
  ? Number((((consensusFairValue - currentPrice) / currentPrice) * 100).toFixed(1))
  : null;
const isUndervalued = consensusUpside !== null ? consensusUpside >= 0 : false;
const consensusVerdict = getConsensusVerdict(report.valuationModels?.verdict, consensusUpside);
const consensusVerdictColor = getConsensusVerdictColor(consensusVerdict);

// Catalyst & Headline
const catalystAlignment = report.catalystAlignment || 'ALIGNED';
const catalystHeadline = report.executiveSummaryData?.catalystHeadline
  || report.catalystSynthesis
  || (report.filteredHeadlines && report.filteredHeadlines.length > 0 ? report.filteredHeadlines[0].title : null)
  || report.title;

const catalystColorClass = (() => {
  switch (catalystAlignment) {
    case 'ALIGNED':
      return 'bg-emerald-950/80 text-emerald-400 border-emerald-500/40';
    case 'DIVERGENT_SELL_THE_NEWS':
      return 'bg-amber-950/80 text-amber-400 border-amber-500/40';
    case 'DIVERGENT_RELIEF_RALLY':
      return 'bg-sky-950/80 text-sky-400 border-sky-500/40';
    case 'MACRO_DOMINATED':
      return 'bg-blue-950/80 text-blue-400 border-blue-500/40';
    case 'NOISE_SPECULATION':
    default:
      return 'bg-rose-950/80 text-rose-400 border-rose-500/40';
  }
})();

// Artificial Inflation & Volume Integrity
const art = report.artificialInflation || {};
const isInflated = art.isInflated ?? report.isArtificiallyInflated ?? false;
const inflationRiskLevel = art.riskLevel || report.artificialInflationRisk || (report.isPennyStock ? 'Moderate' : 'Low');
const volumeAnomalyRatio = art.volumeAnomalyRatio ?? report.volumeAnomalyRatio ?? null;
const freeFloat = art.freeFloatConcentration || report.freeFloatConcentration || null;
const optionGamma = art.optionGammaImbalance || report.optionGammaImbalance || null;

// Moat Analysis
const moatResult = getEconomicMoat({
  existingRating: report.competitiveMoat?.rating || report.morningstarRating?.economicMoat,
  existingSummary: report.competitiveMoat?.summary,
  isPennyStock: report.isPennyStock
});
const moatRating = moatResult.rating;
const moatTrend = getMoatTrend({
  existingTrend: report.moatTrend || report.competitiveMoat?.trend,
  revenueGrowthYoY: report.revenueGrowthYoY,
  roic: report.roic ?? report.returnOnInvestedCapital ?? null
});
const moatSources = report.moatSources || report.competitiveMoat?.sources || null;

// Solvency & Cash
const debt = report.debtAnalysis || {};
const totalDebt = debt.totalDebt ?? report.totalDebt ?? 0;
const shortTermDebt = debt.shortTermDebt ?? report.shortTermDebt ?? 0;
const debtToEquity = debt.debtToEquity ?? report.debtToEquity ?? null;
const cashFlow = report.cashFlow || {};
const freeCashFlow = cashFlow.freeCashFlow ?? report.freeCashFlow ?? null;

// Solvency status traffic light
const isSolvencySafe = (shortTermDebt === 0 || (shortTermDebt < (totalDebt * 0.25))) && (debtToEquity === null || debtToEquity < 2.5);

// EPS Progression
const epsObj = report.earningsPerShare || {};
const currentPE = report.peRatio || report.priceToEarningsRatio?.current || null;
const currentTTM = epsObj.currentTTM ?? (currentPE && currentPrice ? Number((currentPrice / currentPE).toFixed(2)) : null);
const quarterlyEPS = epsObj.quarterlyEPSPast2Years || [];
const positiveQuarters = quarterlyEPS.filter((q: any) => Number(q.eps) > 0).length;
---

<section class="my-6 rounded-2xl border border-slate-700/80 bg-gradient-to-br from-slate-900 via-slate-900/95 to-slate-950 p-4 sm:p-6 shadow-2xl backdrop-blur-md" aria-label="First-Glance Quick-View Triage Dashboard">
  <!-- Top Bar: First Glance Section Indicator -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-5 border-b border-slate-800">
    <div class="flex items-center gap-2.5">
      <div class="flex h-3 w-3 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
      </div>
      <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-200">
        Executive Triage &bull; 5-Second Quick-View Dashboard
      </h2>
    </div>
    <div class="flex items-center gap-2 text-[11px] font-mono text-slate-400">
      <span><strong class="text-white">${report.ticker}</strong></span>
      <span>&bull;</span>
      <span><strong class="text-slate-300">{report.exchange}</strong></span>
      <span class={`px-2 py-0.5 rounded text-[10px] font-mono font-bold border ${consensusVerdictColor} bg-slate-900`}>
        {consensusVerdict}
      </span>
    </div>
  </div>

  <!-- 3-Tile Visual Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    
    <!-- TILE 1: Valuation Gauge & Margin of Safety -->
    <div class="flex flex-col justify-between p-4 sm:p-5 rounded-xl border border-slate-800/90 bg-slate-950/70 hover:border-slate-700 transition-all shadow-md">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="text-[11px] font-mono font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
            Valuation & Margin of Safety
          </div>
        </div>

        <!-- Star Rating Callout -->
        <div class="mb-3.5">
          <div class="font-black font-mono tracking-tight">
            <span class="text-[11px] text-slate-400">Rating: </span>
            <span class="text-xl sm:text-2xl text-amber-300">{starRatingString || 'Rating Not Available'}</span>
          </div>
          <div class="text-[11px] font-mono text-slate-400 mt-0.5">
            Morningstar Uncertainty: <strong class="text-slate-200">{uncertaintyRating}</strong>
          </div>
        </div>

        <!-- Price vs Intrinsic FVE Comparison -->
        <div class="p-3 rounded-lg bg-slate-900/90 border border-slate-800 space-y-2 mb-3">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-slate-400">Market Price:</span>
            <span class="font-bold text-white">${currentPrice.toFixed(2)}</span>
          </div>
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-slate-400">Intrinsic FVE:</span>
            <span class="font-bold text-sky-400">
              {consensusFairValue !== null ? `$${consensusFairValue.toFixed(2)}` : 'N/A'}
            </span>
          </div>

          <!-- Spread Visual Meter -->
          {consensusUpside !== null && (
            <div class="pt-1.5 border-t border-slate-800">
              <div class="flex justify-between items-center text-[11px] font-mono mb-1">
                <span class="text-slate-400">Pricing Spread:</span>
                <span class={`font-bold ${isUndervalued ? 'text-emerald-400' : 'text-rose-400'}`}>
                  {isUndervalued ? '+' : ''}{consensusUpside}% {isUndervalued ? 'Discount' : 'Premium'}
                </span>
              </div>
              <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden flex">
                {isUndervalued ? (
                  <div class="bg-emerald-500 h-full rounded-full transition-all" style={`width: ${Math.min(100, Math.max(15, consensusUpside))}%`}></div>
                ) : (
                  <div class="bg-rose-500 h-full rounded-full transition-all" style={`width: ${Math.min(100, Math.max(15, Math.abs(consensusUpside)))}%`}></div>
                )}
              </div>
            </div>
          )}
        </div>
      </div>

      <!-- Entry Hurdles (5-Star Buy / 1-Star Trim) -->
      <div class="pt-2.5 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono">
        <div>
          <span class="text-slate-400">5★ Buy Below: </span>
          <strong class="text-emerald-400">{fiveStarPrice ? `$${fiveStarPrice.toFixed(2)}` : 'N/A'}</strong>
        </div>
        <div>
          <span class="text-slate-400">1★ Trim Above: </span>
          <strong class="text-rose-400">{oneStarPrice ? `$${oneStarPrice.toFixed(2)}` : 'N/A'}</strong>
        </div>
      </div>
    </div>

    <!-- TILE 2: Catalyst Diagnosis & Manipulation Triage -->
    <div class="flex flex-col justify-between p-4 sm:p-5 rounded-xl border border-slate-800/90 bg-slate-950/70 hover:border-slate-700 transition-all shadow-md">
      <div>
        <div class="flex flex-col items-start gap-2 mb-3">
          <div class="text-[11px] font-mono font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
            Catalyst & Order Flow
          </div>
          <span class={`px-2 py-0.5 rounded text-[10px] font-mono font-bold border ${catalystColorClass}`}>
            {catalystAlignment.replace(/_/g, ' ')}
          </span>
        </div>

        <!-- Headline / Synthesis Summary -->
        <div class="mb-3.5">
          <p class="text-xs text-slate-200 leading-relaxed font-sans font-medium">
            "{catalystHeadline}"
          </p>
        </div>

        <!-- Microstructure & Order Flow Indicators -->
        <div class="grid grid-cols-2 gap-2 text-xs font-mono mb-3">
          <div class="p-2.5 rounded-lg bg-slate-900/90 border border-slate-800">
            <div class="text-[10px] text-slate-400 uppercase">Volume Anomaly</div>
            <div class="text-sm font-bold text-white mt-0.5">
              {volumeAnomalyRatio !== null ? `${volumeAnomalyRatio.toFixed(2)}x RVOL` : '1.0x Normal'}
            </div>
          </div>
          <div class="p-2.5 rounded-lg bg-slate-900/90 border border-slate-800">
            <div class="text-[10px] text-slate-400 uppercase">Inflation Risk</div>
            <div class={`text-sm font-bold mt-0.5 ${inflationRiskLevel === 'Low' ? 'text-emerald-400' : inflationRiskLevel === 'Moderate' ? 'text-amber-400' : 'text-rose-400'}`}>
              {inflationRiskLevel}
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Microstructure Summary: Float & Gamma Skew -->
      <div class="pt-2.5 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-1 text-[11px] font-mono text-slate-400">
        <span>Float: <strong class="text-slate-200">{freeFloat?.freeFloatPercent ? `${freeFloat.freeFloatPercent.toFixed(1)}%` : 'Liquid'}</strong></span>
        <span>Gamma: <strong class={optionGamma?.riskLevel === 'Severe' || optionGamma?.riskLevel === 'High' ? 'text-rose-400' : 'text-emerald-400'}>{optionGamma?.netGammaExposure || 'Neutral'}</strong></span>
      </div>
    </div>

    <!-- TILE 3: Economic Moat & Solvency Snapshot -->
    <div class="flex flex-col justify-between p-4 sm:p-5 rounded-xl border border-slate-800/90 bg-slate-950/70 hover:border-slate-700 transition-all shadow-md">
      <div>
        <div class="flex flex-col items-start gap-2 mb-3">
          <div class="text-[11px] font-mono font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
            Moat & Solvency Snapshot
          </div>
          <div class="flex items-center gap-1">
            <span class={`px-1.5 py-0.5 rounded text-[10px] font-mono border ${
              moatTrend === 'Positive' ? 'bg-emerald-950 text-emerald-400 border-emerald-800/60' :
              moatTrend === 'Negative' ? 'bg-rose-950 text-rose-400 border-rose-800/60' :
              'bg-slate-800 text-slate-300 border-slate-700'
            }`}>
              {moatTrend}
            </span>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-950 text-emerald-300 border border-emerald-800/50">
              {moatRating}
            </span>
          </div>
        </div>

        <!-- 5 Moat Pillars Compact Badges -->
        <div class="mb-3.5">
          <div class="text-[10px] font-mono text-slate-400 uppercase tracking-wider mb-1.5">
            5 Competitive Moat Pillars:
          </div>
          <div class="flex flex-row flex-wrap gap-2 text-[10px] font-mono text-center">
            <div class={`p-1 rounded bg-slate-900 border ${moatSources?.intangibleAssets?.rating === 'Wide' ? 'border-emerald-600/60 text-emerald-300' : moatSources?.intangibleAssets?.rating === 'Narrow' ? 'border-sky-700/60 text-sky-300' : 'border-slate-800 text-slate-500'}`}>
              Intangibles
            </div>
            <div class={`p-1 rounded bg-slate-900 border ${moatSources?.switchingCosts?.rating === 'Wide' ? 'border-emerald-600/60 text-emerald-300' : moatSources?.switchingCosts?.rating === 'Narrow' ? 'border-sky-700/60 text-sky-300' : 'border-slate-800 text-slate-500'}`}>
              Switching
            </div>
            <div class={`p-1 rounded bg-slate-900 border ${moatSources?.networkEffect?.rating === 'Wide' ? 'border-emerald-600/60 text-emerald-300' : moatSources?.networkEffect?.rating === 'Narrow' ? 'border-sky-700/60 text-sky-300' : 'border-slate-800 text-slate-500'}`}>
              Network
            </div>
            <div class={`p-1 rounded bg-slate-900 border ${moatSources?.costAdvantage?.rating === 'Wide' ? 'border-emerald-600/60 text-emerald-300' : moatSources?.costAdvantage?.rating === 'Narrow' ? 'border-sky-700/60 text-sky-300' : 'border-slate-800 text-slate-500'}`}>
              Cost Adv
            </div>
            <div class={`col-span-2 p-1 rounded bg-slate-900 border ${moatSources?.efficientScale?.rating === 'Wide' ? 'border-emerald-600/60 text-emerald-300' : moatSources?.efficientScale?.rating === 'Narrow' ? 'border-sky-700/60 text-sky-300' : 'border-slate-800 text-slate-500'}`}>
              Efficient Scale
            </div>
          </div>
        </div>

        <!-- Solvency Health & Cash Runway -->
        <div class="p-2.5 rounded-lg bg-slate-900/90 border border-slate-800 flex items-center justify-between text-xs font-mono mb-3">
          <div>
            <div class="text-[10px] text-slate-400 uppercase">Short-Term Debt Due</div>
            <div class="text-xs font-bold text-white mt-0.5">{formatCurrency(shortTermDebt)}</div>
          </div>
          <div class="text-right">
            <div class="text-[10px] text-slate-400 uppercase">Solvency Posture</div>
            <div class={`text-xs font-bold ${isSolvencySafe ? 'text-emerald-400' : 'text-amber-400'}`}>
              {isSolvencySafe ? 'Secure Runway' : 'Watch Refinancing'}
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom EPS Progress Summary -->
      <div class="pt-2.5 border-t border-slate-800/80 flex items-center justify-between text-[11px] font-mono text-slate-400">
        <span>TTM EPS: <strong class={currentTTM !== null && currentTTM >= 0 ? 'text-emerald-400' : 'text-rose-400'}>{formatEPS(currentTTM)}</strong></span>
        <span>History: <strong class="text-slate-200">{positiveQuarters}/{quarterlyEPS.length || 8} Pos. Qtrs</strong></span>
      </div>
    </div>

  </div>
</section>
