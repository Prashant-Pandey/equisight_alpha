---
import { formatCurrency, formatEPS } from '../../utils/formatters';
import {
  getEconomicMoat,
  getMoatTrend,
  getConsensusVerdict,
  getConsensusVerdictColor,
  getStarRatingString,
  getDebtLeverageLabel
} from '../../utils/financialClassification';
import { generateForensicAnalysisFromReport } from '../../utils/forensicsEngine';

interface Props {
  report: any;
}

const { report } = Astro.props;

// Valuation & Star Ratings
const currentPrice = report.currentPrice || 0;
const starRating = report.starRating || report.morningstarRating?.starRating || null;
const starRatingString = getStarRatingString(
  report.starRatingString || report.morningstarRating?.starRatingString,
  starRating
);
const uncertaintyRating = report.uncertaintyRating || report.morningstarRating?.uncertaintyRating || 'Medium';
const fiveStarPrice = report.fiveStarPrice || report.morningstarRating?.fiveStarPrice || null;
const oneStarPrice = report.oneStarPrice || report.morningstarRating?.oneStarPrice || null;

// Consensus Fair Value
const consensusFairValue = report.valuationModels?.consensusFairValue ?? null;
const consensusUpside = consensusFairValue !== null && currentPrice > 0
  ? Number((((consensusFairValue - currentPrice) / currentPrice) * 100).toFixed(1))
  : null;
const isUndervalued = consensusUpside !== null ? consensusUpside >= 0 : false;
const consensusVerdict = getConsensusVerdict(report.valuationModels?.verdict, consensusUpside);
const consensusVerdictColor = getConsensusVerdictColor(consensusVerdict);

// Catalyst & Headline
const catalystAlignment = report.catalystAlignment || 'ALIGNED';
const catalystHeadline = report.executiveSummaryData?.catalystHeadline
  || report.catalystSynthesis
  || (report.filteredHeadlines && report.filteredHeadlines.length > 0 ? report.filteredHeadlines[0].title : null)
  || report.title;

const catalystColorClass = (() => {
  switch (catalystAlignment) {
    case 'ALIGNED':
      return 'bg-emerald-950/80 text-emerald-400 border-emerald-500/40';
    case 'DIVERGENT_SELL_THE_NEWS':
      return 'bg-amber-950/80 text-amber-400 border-amber-500/40';
    case 'DIVERGENT_RELIEF_RALLY':
      return 'bg-sky-950/80 text-sky-400 border-sky-500/40';
    case 'MACRO_DOMINATED':
      return 'bg-blue-950/80 text-blue-400 border-blue-500/40';
    case 'NOISE_SPECULATION':
    default:
      return 'bg-rose-950/80 text-rose-400 border-rose-500/40';
  }
})();

// Artificial Inflation & Volume Integrity
const art = report.artificialInflation || {};
const isInflated = art.isInflated ?? report.isArtificiallyInflated ?? false;
const inflationRiskLevel = art.riskLevel || report.artificialInflationRisk || (report.isPennyStock ? 'Moderate' : 'Low');
const volumeAnomalyRatio = art.volumeAnomalyRatio ?? report.volumeAnomalyRatio ?? null;
const freeFloat = art.freeFloatConcentration || report.freeFloatConcentration || null;
const optionGamma = art.optionGammaImbalance || report.optionGammaImbalance || null;

// Forensic Risk Engine
const forensic = generateForensicAnalysisFromReport(report);

// Moat Analysis
const moatResult = getEconomicMoat({
  existingRating: report.competitiveMoat?.rating || report.morningstarRating?.economicMoat,
  existingSummary: report.competitiveMoat?.summary,
  isPennyStock: report.isPennyStock
});
const moatRating = moatResult.rating;
const moatTrend = getMoatTrend({
  existingTrend: report.moatTrend || report.competitiveMoat?.trend,
  revenueGrowthYoY: report.revenueGrowthYoY,
  roic: report.roic ?? report.returnOnInvestedCapital ?? null
});
const moatSources = report.moatSources || report.competitiveMoat?.sources || null;

// Solvency & Cash
const debt = report.debtAnalysis || {};
const totalDebt = debt.totalDebt ?? report.totalDebt ?? 0;
const shortTermDebt = debt.shortTermDebt ?? report.shortTermDebt ?? 0;
const debtToEquity = debt.debtToEquity ?? report.debtToEquity ?? null;
const cashFlow = report.cashFlow || {};
const freeCashFlow = cashFlow.freeCashFlow ?? report.freeCashFlow ?? null;

// Solvency status traffic light
const isSolvencySafe = (shortTermDebt === 0 || (shortTermDebt < (totalDebt * 0.25))) && (debtToEquity === null || debtToEquity < 2.5);

// EPS Progression
const epsObj = report.earningsPerShare || {};
const currentPE = report.peRatio || report.priceToEarningsRatio?.current || null;
const currentTTM = epsObj.currentTTM ?? (currentPE && currentPrice ? Number((currentPrice / currentPE).toFixed(2)) : null);
const quarterlyEPS = epsObj.quarterlyEPSPast2Years || [];
const positiveQuarters = quarterlyEPS.filter((q: any) => Number(q.eps) > 0).length;
---

<section class="my-6 border border-[#2e2e2e] bg-[#181818] p-4 font-mono" aria-label="Executive Triage Dashboard">
  <!-- Top Bar: First Glance Section Indicator -->
  <div class="flex flex-wrap items-center justify-between gap-3 pb-3 mb-4 border-b border-[#222222]">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 bg-[#0055ff]"></span>
      <h2 class="text-xs font-bold uppercase tracking-wider text-white">
        EXECUTIVE TRIAGE DASHBOARD // 3-SECOND RAPID AUDIT
      </h2>
    </div>
    <div class="flex items-center gap-2 text-xs">
      <span class="text-white font-bold">${report.ticker}</span>
      <span class="text-[#666666]">|</span>
      <span class="text-[#8e8e8e]">{report.exchange}</span>
      <span class="text-[#666666]">|</span>
      <span class={`px-1.5 py-0.5 text-[10px] font-bold border ${consensusVerdictColor} bg-[#121212] uppercase`}>
        {consensusVerdict}
      </span>
      <span class="text-[#666666]">|</span>
      <button
        type="button"
        onclick="const btn = document.getElementById('tab-btn-forensics'); if(btn) btn.click();"
        class={`px-1.5 py-0.5 text-[10px] font-bold border rounded cursor-pointer transition-colors ${
          forensic.compositeSeverity === 'LOW'
            ? 'border-emerald-600/70 text-emerald-400 bg-emerald-950/40 hover:bg-emerald-900/50'
            : forensic.compositeSeverity === 'MODERATE'
              ? 'border-amber-600/70 text-amber-300 bg-amber-950/40 hover:bg-amber-900/50'
              : 'border-rose-600/70 text-rose-300 bg-rose-950/40 hover:bg-rose-900/50'
        }`}
        title="View Forensic Risk & Red Flag Surveillance"
      >
        FORENSIC: {forensic.compositeScore}/100 ({forensic.compositeSeverity})
      </button>
    </div>
  </div>

  <!-- 3-Column Utilitarian Grid -->
  <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-[#222222] border border-[#222222]">
    
    <!-- TILE 1: Valuation Gauge & Margin of Safety -->
    <div class="p-4 flex flex-col justify-between bg-[#141414]">
      <div>
        <div class="text-[10px] font-bold text-[#8e8e8e] uppercase tracking-wider mb-2 pb-1 border-b border-[#222222]">
          [1] VALUATION & SPREAD
        </div>

        <!-- Rating Callout -->
        <div class="mb-3">
          <div class="text-xs text-[#8e8e8e]">
            RATING: <span class="text-base text-white font-bold">{starRatingString || 'IN REVIEW'}</span>
          </div>
          <div class="text-[11px] text-[#8e8e8e] mt-0.5">
            UNCERTAINTY: <strong class="text-white">{uncertaintyRating}</strong>
          </div>
        </div>

        <!-- Data Table Comparison -->
        <div class="border border-[#2e2e2e] bg-[#121212] p-2.5 space-y-1.5 text-xs mb-3">
          <div class="flex items-center justify-between">
            <span class="text-[#8e8e8e]">SPOT PRICE:</span>
            <span class="font-bold text-white">${currentPrice.toFixed(2)}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-[#8e8e8e]">INTRINSIC FVE:</span>
            <span class="font-bold text-[#0055ff]">
              {consensusFairValue !== null ? `$${consensusFairValue.toFixed(2)}` : 'N/A'}
            </span>
          </div>

          {consensusUpside !== null && (
            <div class="pt-1.5 border-t border-[#222222] flex justify-between items-center text-[11px]">
              <span class="text-[#8e8e8e]">VALUATION SPREAD:</span>
              <span class={`font-bold ${isUndervalued ? 'text-[#00cc66]' : 'text-[#ff3344]'}`}>
                {isUndervalued ? '+' : ''}{consensusUpside}% {isUndervalued ? 'DISCOUNT' : 'PREMIUM'}
              </span>
            </div>
          )}
        </div>
      </div>

      <!-- Entry Hurdles -->
      <div class="pt-2 border-t border-[#222222] flex items-center justify-between text-[11px]">
        <div>
          <span class="text-[#8e8e8e]">5★ BUY &lt; </span>
          <strong class="text-[#00cc66]">{fiveStarPrice ? `$${fiveStarPrice.toFixed(2)}` : 'N/A'}</strong>
        </div>
        <div>
          <span class="text-[#8e8e8e]">1★ TRIM &gt; </span>
          <strong class="text-[#ff3344]">{oneStarPrice ? `$${oneStarPrice.toFixed(2)}` : 'N/A'}</strong>
        </div>
      </div>
    </div>

    <!-- TILE 2: Catalyst Diagnosis & Order Flow -->
    <div class="p-4 flex flex-col justify-between bg-[#141414]">
      <div>
        <div class="flex items-center justify-between gap-2 mb-2 pb-1 border-b border-[#222222]">
          <div class="text-[10px] font-bold text-[#8e8e8e] uppercase tracking-wider">
            [2] CATALYST & ORDER FLOW
          </div>
          <span class={`px-1.5 py-0.5 text-[10px] font-bold border ${catalystColorClass} uppercase`}>
            {catalystAlignment.replace(/_/g, ' ')}
          </span>
        </div>

        <!-- Headline / Synthesis Summary -->
        <p class="text-xs text-[#e5e5e5] leading-relaxed mb-3 line-clamp-2">
          "{catalystHeadline}"
        </p>

        <!-- Microstructure Grid -->
        <div class="grid grid-cols-2 gap-2 text-xs mb-3">
          <div class="p-2 bg-[#121212] border border-[#2e2e2e]">
            <div class="text-[9px] text-[#8e8e8e] uppercase">VOLUME ANOMALY</div>
            <div class="text-xs font-bold text-white mt-0.5">
              {volumeAnomalyRatio !== null ? `${volumeAnomalyRatio.toFixed(2)}x RVOL` : '1.0x NORMAL'}
            </div>
          </div>
          <div class="p-2 bg-[#121212] border border-[#2e2e2e]">
            <div class="text-[9px] text-[#8e8e8e] uppercase">INFLATION RISK</div>
            <div class={`text-xs font-bold mt-0.5 ${inflationRiskLevel === 'Low' ? 'text-[#00cc66]' : inflationRiskLevel === 'Moderate' ? 'text-[#ff9900]' : 'text-[#ff3344]'}`}>
              {inflationRiskLevel.toUpperCase()}
            </div>
          </div>
        </div>
      </div>

      <!-- Float & Gamma -->
      <div class="pt-2 border-t border-[#222222] flex items-center justify-between text-[11px] text-[#8e8e8e]">
        <span>FLOAT: <strong class="text-white">{freeFloat?.freeFloatPercent ? `${freeFloat.freeFloatPercent.toFixed(1)}%` : 'LIQUID'}</strong></span>
        <span>GAMMA: <strong class={optionGamma?.riskLevel === 'Severe' || optionGamma?.riskLevel === 'High' ? 'text-[#ff3344]' : 'text-[#00cc66]'}>{optionGamma?.netGammaExposure || 'NEUTRAL'}</strong></span>
      </div>
    </div>

    <!-- TILE 3: Economic Moat & Solvency Snapshot -->
    <div class="p-4 flex flex-col justify-between bg-[#141414]">
      <div>
        <div class="flex items-center justify-between gap-2 mb-2 pb-1 border-b border-[#222222]">
          <div class="text-[10px] font-bold text-[#8e8e8e] uppercase tracking-wider">
            [3] MOAT & BALANCE SHEET
          </div>
          <div class="flex items-center gap-1">
            <span class="px-1.5 py-0.5 text-[10px] border border-[#2e2e2e] text-white uppercase bg-[#121212]">
              {moatRating}
            </span>
          </div>
        </div>

        <!-- 5 Moat Pillars -->
        <div class="mb-3">
          <div class="text-[9px] text-[#8e8e8e] uppercase mb-1">COMPETITIVE PILLARS:</div>
          <div class="grid grid-cols-3 gap-1 text-[10px] text-center">
            <div class={`p-1 border bg-[#121212] ${moatSources?.intangibleAssets?.rating === 'Wide' ? 'border-[#0055ff] text-[#0055ff] font-bold' : 'border-[#2e2e2e] text-[#8e8e8e]'}`}>
              INTANGIBLES
            </div>
            <div class={`p-1 border bg-[#121212] ${moatSources?.switchingCosts?.rating === 'Wide' ? 'border-[#0055ff] text-[#0055ff] font-bold' : 'border-[#2e2e2e] text-[#8e8e8e]'}`}>
              SWITCHING
            </div>
            <div class={`p-1 border bg-[#121212] ${moatSources?.networkEffect?.rating === 'Wide' ? 'border-[#0055ff] text-[#0055ff] font-bold' : 'border-[#2e2e2e] text-[#8e8e8e]'}`}>
              NETWORK
            </div>
          </div>
        </div>

        <!-- Solvency Box -->
        <div class="p-2 bg-[#121212] border border-[#2e2e2e] flex items-center justify-between text-xs mb-3">
          <div>
            <div class="text-[9px] text-[#8e8e8e] uppercase">SHORT DEBT DUE</div>
            <div class="font-bold text-white mt-0.5">{formatCurrency(shortTermDebt)}</div>
          </div>
          <div class="text-right">
            <div class="text-[9px] text-[#8e8e8e] uppercase">SOLVENCY</div>
            <div class={`font-bold ${isSolvencySafe ? 'text-[#00cc66]' : 'text-[#ff9900]'}`}>
              {isSolvencySafe ? 'STABLE' : 'WATCH'}
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom EPS Progress Summary -->
      <div class="pt-2 border-t border-[#222222] flex items-center justify-between text-[11px] text-[#8e8e8e]">
        <span>TTM EPS: <strong class={currentTTM !== null && currentTTM >= 0 ? 'text-[#00cc66]' : 'text-[#ff3344]'}>{formatEPS(currentTTM)}</strong></span>
        <span>PROFITABLE: <strong class="text-white">{positiveQuarters}/{quarterlyEPS.length || 8} QTRS</strong></span>
      </div>
    </div>

  </div>
</section>
