---
import { path } from '../../utils/paths';
import { getStarRatingString } from '../../utils/financialClassification';

interface Props {
  report: any;
  printUrl: string;
  formattedDate: string;
  publishDateIso: string;
  priceDisplayLabel: string;
  defaultTab?: string;
}

const {
  report,
  printUrl,
  formattedDate,
  publishDateIso,
  priceDisplayLabel,
  defaultTab = 'overview'
} = Astro.props;

const isPositive = report.movePercent >= 0;
const currentPrice = report.currentPrice || 10;
const fiveStarPrice = report.fiveStarPrice || report.morningstarRating?.fiveStarPrice || null;
const oneStarPrice = report.oneStarPrice || report.morningstarRating?.oneStarPrice || null;
const consensusFairValue = report.valuationModels?.consensusFairValue ?? null;
const starRating = report.starRating || report.morningstarRating?.starRating || null;
const starRatingString = getStarRatingString(
  report.starRatingString || report.morningstarRating?.starRatingString,
  starRating
);

// Calculate 52-week & benchmark bounds for visual scale
const lowBound = Math.min(
  currentPrice * 0.55,
  fiveStarPrice ? fiveStarPrice * 0.9 : currentPrice * 0.6
);
const highBound = Math.max(
  currentPrice * 1.35,
  oneStarPrice ? oneStarPrice * 1.15 : currentPrice * 1.4,
  consensusFairValue ? consensusFairValue * 1.15 : currentPrice * 1.3
);
const span = highBound - lowBound || 1;

function toScale(val: number | null): number {
  if (val === null) return 0;
  return Math.max(2, Math.min(98, ((val - lowBound) / span) * 100));
}

const spotPct = toScale(currentPrice);
const fvePct = toScale(consensusFairValue);
const buyPct = toScale(fiveStarPrice);
const trimPct = toScale(oneStarPrice);

const tabs = [
  { id: 'overview', label: 'Overview & Synthesis', shortLabel: 'Overview' },
  { id: 'thesis', label: 'Theses & Citations', shortLabel: 'Theses' },
  { id: 'valuation', label: 'Valuation Models', shortLabel: 'Valuation' },
  { id: 'solvency', label: 'Health & Solvency', shortLabel: 'Solvency' },
  { id: 'microstructure', label: 'Market Flow & Microstructure', shortLabel: 'Order Flow' }
];
---

<!-- Trigger anchor to track when user scrolls past hero -->
<div id="command-bar-hero-sentinel" class="h-0 w-full pointer-events-none"></div>

<!-- Unified Adaptive Command Header & Sticky Bar -->
<section class="mb-6" id="unified-command-section">
  <!-- EXPANDED HERO CARD (Utilitarian Clean Layout) -->
  <div class="border border-[#2e2e2e] bg-[#181818] p-4 sm:p-5 font-mono">
    <!-- Top Metadata Row -->
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 mb-4 border-b border-[#222222]">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <a
          href={path(`/tickers/${report.ticker.toLowerCase()}`)}
          class="font-black px-2 py-0.5 bg-[#121212] text-white border border-[#0055ff] hover:bg-[#0055ff] transition-none"
        >
          ${report.ticker}
        </a>
        <span class="text-white font-bold">{report.companyName}</span>
        <span class="text-[#666666]">|</span>
        <span class="text-[#8e8e8e]">{report.sector}</span>
        <span class="text-[#666666]">|</span>
        <span class="uppercase bg-[#121212] text-[#8e8e8e] px-1.5 py-0.5 border border-[#2e2e2e] text-[10px]">
          {report.exchange} : {report.region}
        </span>
        <time datetime={publishDateIso} class="text-[#8e8e8e] text-[10px]">{formattedDate}</time>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2">
        <!-- PDF Export -->
        <a
          href={`${printUrl}?autoprint=true`}
          target="_blank"
          rel="noopener"
          id="export-pdf-action-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#0055ff] hover:bg-[#0044cc] text-white text-xs font-bold transition-none border border-[#0055ff] cursor-pointer tap-target"
          title="Print / Export Report"
        >
          [ PDF EXPORT ]
        </a>

        <!-- CSV Export -->
        <button
          type="button"
          id="cmd-export-csv-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#121212] hover:bg-[#222222] text-[#e5e5e5] text-xs font-bold transition-none border border-[#2e2e2e] cursor-pointer tap-target"
          title="Export spreadsheet model data to CSV"
        >
          [ CSV MODEL ]
        </button>
      </div>
    </div>

    <!-- Main Title & Price Display (12-Col Modular Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
      <!-- Left 8 Cols: Title & Valuation Tag -->
      <div class="md:col-span-8 space-y-2">
        <h1 class="text-xl sm:text-2xl font-bold text-white tracking-tight uppercase">
          {report.title}
        </h1>
        <div class="flex flex-wrap items-center gap-3 text-xs text-[#8e8e8e]">
          <span class="text-white font-bold">
            RATING: {starRatingString || 'IN REVIEW'}
          </span>
          <span class="text-[#666666]">|</span>
          <span>
            INDUSTRY: <strong class="text-[#e5e5e5]">{report.industry}</strong>
          </span>
        </div>
      </div>

      <!-- Right 4 Cols: Large Price & Move Block -->
      <div class="md:col-span-4 p-3 border border-[#2e2e2e] bg-[#121212] flex items-center justify-between">
        <div>
          <div class="text-[10px] uppercase text-[#8e8e8e]">
            {priceDisplayLabel}
          </div>
          <div class="text-2xl sm:text-3xl font-black text-white mt-0.5">
            ${currentPrice.toFixed(2)} <span class="text-xs text-[#8e8e8e] font-normal">{report.currency || 'USD'}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 52-WEEK RANGE & INTRINSIC BENCHMARK SCALE (Utilitarian High-Contrast) -->
    <div class="mt-4 pt-4 border-t border-[#222222]">
      <div class="flex items-center justify-between text-xs mb-1.5">
        <span class="text-[#8e8e8e] font-bold uppercase">
          52-WEEK RANGE & INTRINSIC FVE SPREAD
        </span>
        <span class="text-xs">
          CONSENSUS FAIR VALUE: <strong class="text-[#0055ff]">{consensusFairValue !== null ? `$${consensusFairValue.toFixed(2)}` : 'N/A'}</strong>
        </span>
      </div>

      <!-- Horizontal Continuous Range Meter -->
      <div class="relative h-4 bg-[#121212] border border-[#2e2e2e] overflow-hidden flex items-center">
        <!-- Undervalued Zone -->
        {fiveStarPrice && (
          <div
            class="absolute left-0 top-0 bottom-0 bg-[#00cc66]/20 border-r border-[#00cc66]"
            style={`width: ${buyPct}%;`}
          ></div>
        )}
        <!-- Overvalued Zone -->
        {oneStarPrice && (
          <div
            class="absolute right-0 top-0 bottom-0 bg-[#ff3344]/20 border-l border-[#ff3344]"
            style={`left: ${trimPct}%; width: ${100 - trimPct}%;`}
          ></div>
        )}

        <!-- Consensus FVE Target Line -->
        {consensusFairValue && (
          <div
            class="absolute top-0 bottom-0 w-0.5 bg-[#0055ff] -translate-x-1/2 z-10"
            style={`left: ${fvePct}%;`}
          ></div>
        )}

        <!-- Spot Market Price Marker -->
        <div
          class="absolute top-0 bottom-0 w-1 bg-white -translate-x-1/2 z-20"
          style={`left: ${spotPct}%;`}
          title={`Spot Price: $${currentPrice.toFixed(2)}`}
        ></div>
      </div>

      <!-- Scale Labels Below Bar -->
      <div class="flex items-center justify-between text-[10px] text-[#8e8e8e] mt-1.5">
        <div>52W LOW: <strong class="text-white">${lowBound.toFixed(2)}</strong></div>
        {fiveStarPrice && <div>5★ BUY &lt; <strong class="text-[#00cc66]">${fiveStarPrice.toFixed(2)}</strong></div>}
        <div class="text-white font-bold">SPOT: ${currentPrice.toFixed(2)}</div>
        {consensusFairValue && <div>FVE: <strong class="text-[#0055ff]">${consensusFairValue.toFixed(2)}</strong></div>}
        {oneStarPrice && <div>1★ TRIM &gt; <strong class="text-[#ff3344]">${oneStarPrice.toFixed(2)}</strong></div>}
        <div>52W HIGH: <strong class="text-white">${highBound.toFixed(2)}</strong></div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupUnifiedCommandBar() {
    const sentinel = document.getElementById('command-bar-hero-sentinel');
    const stickyMiniTicker = document.getElementById('sticky-mini-ticker');
    const stickyBar = document.getElementById('sticky-action-bar');

    if (!sentinel || !stickyMiniTicker || !stickyBar) return;

    // Use IntersectionObserver to toggle mini ticker capsule on scroll
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            // User scrolled past hero: reveal mini ticker capsule
            stickyMiniTicker.classList.remove('hidden');
            stickyMiniTicker.classList.add('flex');
            stickyBar.classList.add('shadow-2xl', 'bg-slate-950/95');
          } else {
            // User at top: hide mini ticker
            stickyMiniTicker.classList.add('hidden');
            stickyMiniTicker.classList.remove('flex');
            stickyBar.classList.remove('shadow-2xl');
          }
        });
      },
      { threshold: 0 }
    );

    observer.observe(sentinel);
  }

  setupUnifiedCommandBar();
  document.addEventListener('astro:page-load', setupUnifiedCommandBar);
</script>
