---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  publishDate?: string;
  ticker?: string;
  companyName?: string;
  sector?: string;
  keywords?: string[];
  ogImage?: string;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <SEOHead {...props} />
    <style is:global>
      /* Utilitarian Design System Reset */
      :root {
        --color-bg: #121212;
        --color-surface: #181818;
        --color-border: #2e2e2e;
        --color-text: #e5e5e5;
        --color-muted: #8e8e8e;
        --color-accent: #38bdf8;
        --color-accent-hover: #7dd3fc;
      }
      html {
        font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 16px;
        line-height: 1.5;
        color: var(--color-text);
        background-color: var(--color-bg);
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      /* Zero rounded corners, zero blur, zero drop shadows in utilitarian mode */
      * {
        border-radius: 0px !important;
        box-shadow: none !important;
        text-shadow: none !important;
      }
      button, input, select, textarea, a.btn {
        border-radius: 2px !important;
      }
      /* High-contrast focus state for WCAG 2.2 AA accessibility */
      :focus-visible {
        outline: 2px solid #38bdf8 !important;
        outline-offset: 2px !important;
      }
      /* Tap target minimum 44px on interactive controls where required */
      .tap-target {
        min-height: 44px;
        min-width: 44px;
      }
    </style>
  </head>
  <body class="bg-[#121212] text-[#e5e5e5] min-h-screen flex flex-col font-sans antialiased selection:bg-[#38bdf8] selection:text-slate-950">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
