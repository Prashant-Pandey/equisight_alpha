---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  FINANCIAL_THRESHOLDS,
  getDefinitionsByCategory,
  listAllDefinitions,
  type FinancialDomainDefinition
} from '../utils/financialDefinitions';
import { path } from '../utils/paths';

const pageTitle = "Financial Definitions & Methodology Registry | EquiSight Alpha";
const pageDescription = "Institutional domain definitions, quantitative thresholds, regulatory anchors, and reviewer guidelines governing automated equity analysis and classifications.";

const definitionsByCategory = getDefinitionsByCategory();
const totalDefinitions = listAllDefinitions().length;
const categories = Object.keys(definitionsByCategory);
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header Bar -->
    <div class="mb-6 pb-4 border-b border-[#2e2e2e] font-mono">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-2">
        <div class="inline-block px-2 py-0.5 text-xs font-bold bg-[#181818] border border-[#38bdf8] text-[#38bdf8] uppercase">
          HEURISTICS & ALGORITHMIC SPECIFICATION REGISTRY
        </div>
        <div class="text-xs text-[#8e8e8e]">
          VERSION 1.2 · ACTIVE DEFINITIONS: <span class="text-white font-bold">{totalDefinitions}</span>
        </div>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight uppercase">
        Financial Definitions & Quantitative Heuristics
      </h1>
      <p class="text-xs text-[#8e8e8e] mt-1 max-w-3xl leading-relaxed">
        Canonical domain definitions, statutory anchors, quantitative thresholds, and reviewer audit instructions governing algorithmic classification across EquiSight Alpha equity research.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-1.5 mt-4 pt-3 border-t border-[#222222]">
        <span class="text-xs text-[#8e8e8e] self-center mr-1 uppercase">CATEGORIES:</span>
        {categories.map((cat, idx) => (
          <a
            href={`#cat-${idx}`}
            class="text-xs px-2.5 py-1 bg-[#181818] border border-[#2e2e2e] text-[#e5e5e5] hover:border-[#38bdf8] hover:text-[#38bdf8] transition-none"
          >
            {cat}
          </a>
        ))}
      </div>
    </div>

    <!-- Reviewer Notice Box -->
    <div class="mb-8 p-4 bg-[#181818] border border-[#2e2e2e] flex items-start gap-3 font-mono text-xs">
      <div class="px-2 py-1 bg-[#121212] border border-[#2e2e2e] text-[#38bdf8] font-bold shrink-0">
        AUDIT
      </div>
      <div class="text-[#8e8e8e] leading-relaxed space-y-1">
        <div class="font-bold text-white uppercase text-xs">Human Reviewer & Compliance Guide</div>
        <p>
          All classifications and ratings in our reports are computed strictly against the centralized rules below. Domain experts reviewing reports should verify that asset profiles conform to these thresholds. Special industry standards (e.g., REIT leverage or high-growth CapEx cycles) are highlighted in the audit notes.
        </p>
      </div>
    </div>

    <!-- Definitions Sections -->
    <div class="space-y-10">
      {categories.map((category, catIdx) => {
        const defs: FinancialDomainDefinition[] = definitionsByCategory[category as keyof typeof definitionsByCategory] || [];
        return (
          <section id={`cat-${catIdx}`} class="scroll-mt-20 font-mono">
            <div class="flex items-center gap-2 mb-4 pb-2 border-b border-[#2e2e2e]">
              <span class="w-2 h-2 bg-[#38bdf8]"></span>
              <h2 class="text-base font-bold text-white uppercase tracking-tight">
                {category}
              </h2>
              <span class="text-xs px-2 py-0.5 border border-[#2e2e2e] bg-[#181818] text-[#8e8e8e]">
                {defs.length} {defs.length === 1 ? 'RULE' : 'RULES'}
              </span>
            </div>

            <div class="space-y-4">
              {defs.map((def) => (
                <div class="border border-[#2e2e2e] bg-[#181818] overflow-hidden">
                  <!-- Definition Card Header -->
                  <div class="p-4 border-b border-[#2e2e2e] bg-[#141414] flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                      <div class="text-[10px] text-[#38bdf8] uppercase tracking-wider mb-0.5 font-bold">
                        RULE ID: {def.id}
                      </div>
                      <h3 class="text-sm sm:text-base font-bold text-white uppercase">
                        {def.term}
                      </h3>
                    </div>
                    {def.regulatoryStandard && (
                      <div class="text-[10px] px-2 py-0.5 border border-[#2e2e2e] bg-[#121212] text-[#e5e5e5] self-start sm:self-auto">
                        STANDARD: {def.regulatoryStandard}
                      </div>
                    )}
                  </div>

                  <!-- Definition Card Body -->
                  <div class="p-4 space-y-4 text-xs">
                    <!-- Academic / Methodology Anchor -->
                    <div>
                      <div class="text-[10px] uppercase text-[#8e8e8e] mb-0.5">METHODOLOGY ANCHOR</div>
                      <div class="text-white font-medium">{def.academicOrMethodologyAnchor}</div>
                    </div>

                    <!-- Logic / Formula -->
                    <div class="p-3 bg-[#121212] border border-[#2e2e2e] text-[11px] text-[#e5e5e5] overflow-x-auto">
                      <div class="text-[9px] uppercase text-[#8e8e8e] mb-1">FORMAL LOGIC FORMULATION:</div>
                      <code>{def.formulaOrLogicSummary}</code>
                    </div>

                    <!-- Methodology Rationale -->
                    <div>
                      <div class="text-[10px] uppercase text-[#8e8e8e] mb-0.5">DOMAIN RATIONALE</div>
                      <p class="leading-relaxed text-[#8e8e8e]">
                        {def.methodologyRationale}
                      </p>
                    </div>

                    <!-- Tiers / Outputs Table if available -->
                    {def.tiers && def.tiers.length > 0 && (
                      <div>
                        <div class="text-[10px] uppercase text-[#8e8e8e] mb-1.5">TIERS & CLASSIFICATION OUTPUT MATRIX</div>
                        <div class="overflow-x-auto border border-[#2e2e2e]">
                          <table class="w-full text-left border-collapse text-[11px]">
                            <thead class="bg-[#121212] text-[#8e8e8e] border-b border-[#2e2e2e]">
                              <tr>
                                <th class="p-2 uppercase font-bold">Tier Label</th>
                                <th class="p-2 uppercase font-bold">Quantitative Criteria</th>
                                <th class="p-2 uppercase font-bold">Analyst Implication</th>
                              </tr>
                            </thead>
                            <tbody class="divide-y divide-[#222222]">
                              {def.tiers.map((tier) => (
                                <tr class="hover:bg-[#1f1f1f]">
                                  <td class="p-2 font-bold text-white whitespace-nowrap">{tier.label}</td>
                                  <td class="p-2 text-[#00cc66] font-mono">{tier.criteria}</td>
                                  <td class="p-2 text-[#8e8e8e]">{tier.analystImplication}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    )}

                    <!-- Reviewer Audit Notes -->
                    <div class="p-3 bg-[#121212] border border-[#2e2e2e] text-[#8e8e8e]">
                      <div class="text-white font-bold text-xs mb-1 uppercase">
                        [ REVIEWER AUDIT NOTE ]
                      </div>
                      <p class="leading-relaxed">
                        {def.reviewerNotes}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>

    <!-- Bottom Back to Top / Links -->
    <div class="mt-8 pt-4 border-t border-[#2e2e2e] flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
      <a href="#cat-0" class="text-[#38bdf8] hover:underline flex items-center gap-1">
        [&uarr; TOP OF REGISTRY]
      </a>
      <div class="flex gap-4 text-[#8e8e8e]">
        <a href={path('/reports')} class="hover:text-white transition-none">RESEARCH DATABASE</a>
        <span>·</span>
        <a href={path('/disclaimer')} class="hover:text-white transition-none">STATUTORY DISCLAIMER</a>
      </div>
    </div>
  </div>
</BaseLayout>
