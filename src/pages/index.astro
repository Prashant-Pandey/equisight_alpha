---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { path } from '../utils/paths';

// Fetch all reports and sort by publishDate descending
const allReports = await getCollection('reports');
const sortedReports = allReports.sort((a, b) => {
  const dateA = new Date(a.data.publishDate).getTime();
  const dateB = new Date(b.data.publishDate).getTime();
  return dateB - dateA;
});

// Extract recent 10 reports and top movers
const recentReports = sortedReports.slice(0, 12);
const topGainers = sortedReports.filter((r) => r.data.category === 'gainer').slice(0, 5);
const topLosers = sortedReports.filter((r) => r.data.category === 'loser').slice(0, 5);

const pageTitle = "Daily Evidence-Based Equity Intelligence & Fundamental Reports";
const pageDescription = "Institutional-grade fundamental and macroeconomic equity research covering top daily market movers across US and European exchanges.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-16 border-b border-slate-800/80 bg-gradient-to-b from-slate-900/60 to-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-950 border border-emerald-500/30 text-emerald-400 mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          Twice-Daily Execution Cycle Active
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Evidence-Based Equity Analysis for <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400">Rational Capital</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          Independent quantitative research isolating fundamental solvency, free cash flow conversion, and macroeconomic headwinds across US and European bourses.
        </p>
      </div>

      <!-- Quick Stats Counter -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/40 backdrop-blur-sm">
          <div class="text-2xl font-black text-white font-mono">10</div>
          <div class="text-xs text-slate-400 font-medium">Daily New Reports</div>
        </div>
        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/40 backdrop-blur-sm">
          <div class="text-2xl font-black text-emerald-400 font-mono">365-Day</div>
          <div class="text-xs text-slate-400 font-medium">Trailing Lockout Rule</div>
        </div>
        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/40 backdrop-blur-sm">
          <div class="text-2xl font-black text-cyan-400 font-mono">5,000+</div>
          <div class="text-xs text-slate-400 font-medium">Annualized Coverage</div>
        </div>
        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/40 backdrop-blur-sm">
          <div class="text-2xl font-black text-amber-400 font-mono">100%</div>
          <div class="text-xs text-slate-400 font-medium">Publisher Exemption</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Market Movers Dashboard Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Top 5 Gainers Section -->
      <div class="rounded-2xl border border-slate-800 bg-slate-900/30 p-6">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm">
              &uarr;
            </div>
            <div>
              <h2 class="text-lg font-bold text-white">Today's Top 5 Outperformers</h2>
              <p class="text-xs text-slate-400">Leading positive session delta across US & EU markets</p>
            </div>
          </div>
          <span class="text-xs font-mono font-medium text-emerald-400 bg-emerald-950/60 px-2.5 py-1 rounded-md border border-emerald-800/40">
            Gainers
          </span>
        </div>

        <div class="space-y-3">
          {topGainers.map((report) => (
            <a
              href={path(`/reports/${report.slug}`)}
              class="block p-4 rounded-xl border border-slate-800/80 bg-slate-900/60 hover:bg-slate-850 hover:border-emerald-500/40 transition-all group"
            >
              <div class="flex items-center justify-between">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-mono font-black text-base text-white group-hover:text-emerald-400 transition-colors">
                      ${report.data.ticker}
                    </span>
                    <span class="text-xs text-slate-400 truncate max-w-[180px] sm:max-w-[240px]">
                      {report.data.companyName}
                    </span>
                    <span class="text-[10px] font-mono uppercase bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded">
                      {report.data.exchange}
                    </span>
                  </div>
                  <div class="text-xs text-slate-400 mt-1 flex items-center gap-3">
                    <span>P/E: <strong class="text-slate-200">{report.data.peRatio ? `${report.data.peRatio.toFixed(1)}x` : 'N/A'}</strong></span>
                    <span>Cap: <strong class="text-slate-200">${(report.data.marketCap / 1e9).toFixed(1)}B</strong></span>
                  </div>
                </div>
                <div class="text-right">
                  <span class="inline-block font-mono font-bold text-sm text-emerald-400 bg-emerald-950/80 px-2.5 py-1 rounded border border-emerald-800/40">
                    +{report.data.movePercent.toFixed(2)}%
                  </span>
                  <div class="text-[10px] text-slate-500 mt-1 font-mono">${report.data.currentPrice.toFixed(2)}</div>
                </div>
              </div>
            </a>
          ))}
          {topGainers.length === 0 && (
            <div class="text-center py-8 text-sm text-slate-500">
              Awaiting pre-market data ingestion cycle...
            </div>
          )}
        </div>
      </div>

      <!-- Top 5 Losers / Pullbacks Section -->
      <div class="rounded-2xl border border-slate-800 bg-slate-900/30 p-6">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-800">
          <div class="flex items-center gap-2.5">
            <div class="w-7 h-7 rounded-lg bg-rose-500/20 text-rose-400 flex items-center justify-center font-bold text-sm">
              &darr;
            </div>
            <div>
              <h2 class="text-lg font-bold text-white">Today's Top 5 Session Pullbacks</h2>
              <p class="text-xs text-slate-400">Significant single-day multiple contractions & volume spikes</p>
            </div>
          </div>
          <span class="text-xs font-mono font-medium text-rose-400 bg-rose-950/60 px-2.5 py-1 rounded-md border border-rose-800/40">
            Pullbacks
          </span>
        </div>

        <div class="space-y-3">
          {topLosers.map((report) => (
            <a
              href={path(`/reports/${report.slug}`)}
              class="block p-4 rounded-xl border border-slate-800/80 bg-slate-900/60 hover:bg-slate-850 hover:border-rose-500/40 transition-all group"
            >
              <div class="flex items-center justify-between">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="font-mono font-black text-base text-white group-hover:text-rose-400 transition-colors">
                      ${report.data.ticker}
                    </span>
                    <span class="text-xs text-slate-400 truncate max-w-[180px] sm:max-w-[240px]">
                      {report.data.companyName}
                    </span>
                    <span class="text-[10px] font-mono uppercase bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded">
                      {report.data.exchange}
                    </span>
                  </div>
                  <div class="text-xs text-slate-400 mt-1 flex items-center gap-3">
                    <span>P/E: <strong class="text-slate-200">{report.data.peRatio ? `${report.data.peRatio.toFixed(1)}x` : 'N/A'}</strong></span>
                    <span>Cap: <strong class="text-slate-200">${(report.data.marketCap / 1e9).toFixed(1)}B</strong></span>
                  </div>
                </div>
                <div class="text-right">
                  <span class="inline-block font-mono font-bold text-sm text-rose-400 bg-rose-950/80 px-2.5 py-1 rounded border border-rose-800/40">
                    {report.data.movePercent.toFixed(2)}%
                  </span>
                  <div class="text-[10px] text-slate-500 mt-1 font-mono">${report.data.currentPrice.toFixed(2)}</div>
                </div>
              </div>
            </a>
          ))}
          {topLosers.length === 0 && (
            <div class="text-center py-8 text-sm text-slate-500">
              Awaiting post-market data ingestion cycle...
            </div>
          )}
        </div>
      </div>

    </div>

    <!-- Latest Reports Stream -->
    <div class="mt-16">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-800">
        <div>
          <h2 class="text-2xl font-bold text-white tracking-tight">Recent Research Feed</h2>
          <p class="text-xs text-slate-400 mt-0.5">Comprehensive balance sheet stress tests and valuation deep dives</p>
        </div>
        <a href={path('/reports')} class="text-xs font-semibold text-emerald-400 hover:text-emerald-300">
          View All Archive &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentReports.map((report) => (
          <article class="p-5 rounded-xl border border-slate-800 bg-slate-900/40 hover:border-slate-700 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs mb-3">
                <a
                  href={path(`/tickers/${report.data.ticker.toLowerCase()}`)}
                  class="font-mono font-bold text-emerald-400 hover:underline"
                  title={`View historical research for $${report.data.ticker}`}
                >
                  ${report.data.ticker}
                </a>
                <span class="text-slate-500 font-mono text-[11px]">
                  {new Date(report.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
              </div>
              <h3 class="text-base font-bold text-white hover:text-emerald-400 transition-colors line-clamp-2">
                <a href={path(`/reports/${report.slug}`)}>{report.data.title}</a>
              </h3>
              <p class="text-xs text-slate-400 mt-2 line-clamp-3 leading-relaxed">
                {report.data.description}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
              <span class="text-slate-400">{report.data.sector}</span>
              <a href={path(`/reports/${report.slug}`)} class="font-semibold text-emerald-400 hover:text-emerald-300">
                Read Deep Dive &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
