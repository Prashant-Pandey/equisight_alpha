---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { path } from '../utils/paths';
import { formatCurrency } from '../utils/formatters';

// Fetch all reports and sort by publishDate descending
const allReports = await getCollection('reports');
const sortedReports = allReports.sort((a, b) => {
  const dateA = new Date(a.data.publishDate).getTime();
  const dateB = new Date(b.data.publishDate).getTime();
  return dateB - dateA;
});

// Helper to resolve archetype (with fallback for legacy reports)
function resolveArchetype(report: any): 'moat' | 'pead' | 'contrarian' | 'quant' {
  if (report.data.archetype) return report.data.archetype;
  if (report.data.competitiveMoat?.rating === 'Wide Moat') return 'moat';
  if (report.data.category === 'loser') return 'contrarian';
  if (report.data.category === 'gainer') return 'pead';
  return 'quant';
}

// Group into 4 Strategy Archetypes
const moatReports = sortedReports.filter((r) => (r.data.archetype || resolveArchetype(r)) === 'moat');
const peadReports = sortedReports.filter((r) => (r.data.archetype || resolveArchetype(r)) === 'pead');
const contrarianReports = sortedReports.filter((r) => (r.data.archetype || resolveArchetype(r)) === 'contrarian');
const quantReports = sortedReports.filter((r) => (r.data.archetype || resolveArchetype(r)) === 'quant');

// Cohort statistics
const totalReportsCount = sortedReports.length;
const totalArchetypeStocks = moatReports.length + peadReports.length + contrarianReports.length + quantReports.length;
const undervaluedReports = sortedReports.filter((r) => {
  const verdict = (r.data.valuationModels?.verdict || '').toLowerCase();
  return verdict.includes('undervalued');
});
const wideMoatReports = sortedReports.filter((r) => r.data.competitiveMoat?.rating === 'Wide Moat');

// Recent research feed
const recentReports = sortedReports.slice(0, 12);

const pageTitle = "EquiSight Alpha | Systematic Fundamental Equity Research & Valuation Models";
const pageDescription = "Institutional-grade fundamental equity research, Morningstar-style economic moats, and multi-model DCF valuations across 4 systematic investment strategies.";

// Valuation metrics helper
// Valuation metrics helper
function getUpsideData(currentPrice: number, fairValue: number | null | undefined) {
  if (!fairValue || currentPrice <= 0) return null;
  const upsidePct = ((fairValue - currentPrice) / currentPrice) * 100;
  const isUndervalued = upsidePct > 0;
  return {
    upsidePct,
    isUndervalued,
    label: isUndervalued
      ? `+${upsidePct.toFixed(1)}% FV`
      : `${upsidePct.toFixed(1)}% FV`
  };
}

function getVerdictBadgeStyle(verdict?: string | null) {
  const v = (verdict || '').toLowerCase();
  if (v.includes('undervalued')) {
    return 'bg-[#181818] text-[#00cc66] border border-[#00cc66]';
  }
  if (v.includes('fairly valued')) {
    return 'bg-[#181818] text-[#8e8e8e] border border-[#3a3a3a]';
  }
  if (v.includes('overvalued')) {
    return 'bg-[#181818] text-[#ff3344] border border-[#ff3344]';
  }
  return 'bg-[#181818] text-[#8e8e8e] border border-[#2e2e2e]';
}

function getMoatBadgeStyle(rating?: string | null) {
  const r = (rating || '').toLowerCase();
  if (r.includes('wide')) {
    return 'bg-[#181818] text-[#0055ff] border border-[#0055ff]';
  }
  if (r.includes('narrow')) {
    return 'bg-[#181818] text-[#e5e5e5] border border-[#3a3a3a]';
  }
  return 'bg-[#181818] text-[#8e8e8e] border border-[#2e2e2e]';
}

// Strategy Definitions
const STRATEGIES = [
  {
    id: 'moat',
    name: 'Wide Moat at a Discount',
    shortName: 'Wide Moat',
    code: 'STRAT-01',
    badge: 'Intrinsic DCF / Moat Lockout',
    thesis: 'High-ROIC businesses protected by structural competitive moats trading below intrinsic fair value.',
    criteria: '5-Yr ROIC >= 15% · Op Margin >= 15% · Net Debt / EBITDA < 2.5x',
    benchmark: 'Morningstar Wide Moat Focus (+320 bps alpha)',
    reports: moatReports.slice(0, 6)
  },
  {
    id: 'pead',
    name: 'Earnings Catalyst & PEAD',
    shortName: 'PEAD Drift',
    code: 'STRAT-02',
    badge: 'Post-Earnings Drift',
    thesis: 'Capturing systematic sell-side consensus underreaction to earnings surprises and forward revisions.',
    criteria: 'EPS Beat >= +5.0% · Rev Beat >= +2.0% · RVOL >= 2.0x',
    benchmark: 'Two Sigma / Ball & Brown SUE Drift (+6.8% - +8.2%)',
    reports: peadReports.slice(0, 6)
  },
  {
    id: 'contrarian',
    name: 'Contrarian Blue-Chip Pullbacks',
    shortName: 'Contrarian Dips',
    code: 'STRAT-03',
    badge: 'Oversold Quality / Mean Reversion',
    thesis: 'S&P 500 / NASDAQ staples sold off on transient macro noise while maintaining solvent balance sheets.',
    criteria: 'S&P 500 / QQQ · RSI <= 35.0 · Altman Z > 2.99',
    benchmark: 'Howard Marks / Piotroski Health (74.2% Win Rate)',
    reports: contrarianReports.slice(0, 6)
  },
  {
    id: 'quant',
    name: 'Multi-Factor Quant Composite',
    shortName: 'Quant Composite',
    code: 'STRAT-04',
    badge: 'Factor Optimization',
    thesis: 'Orthogonal composite balancing Quality (35%), Value (30%), Momentum (20%), and Financial Health (15%).',
    criteria: 'Quality Z-Score · Relative FCF Yield · Leverage Factor',
    benchmark: 'AQR Style Premia (0.85 - 1.10 IR)',
    reports: quantReports.slice(0, 6)
  }
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Top Utilitarian Mission Strip (No marketing fluff, pure density) -->
  <section class="border-b border-[#2e2e2e] bg-[#121212] py-6 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-[#222222]">
        <div>
          <div class="font-mono text-xs text-[#0055ff] font-bold uppercase tracking-wider mb-1">
            EQUITY RESEARCH ENGINE // BATCH-CYCLE 2026.10
          </div>
          <h1 class="text-2xl sm:text-3xl font-mono font-black text-white tracking-tight uppercase">
            Systematic Fundamental Research Terminal
          </h1>
          <p class="text-xs font-mono text-[#8e8e8e] mt-1 max-w-3xl">
            FORM FOLLOWS FUNCTION. Real-time quantitative equity screening across 4 institutional strategies: Wide Moat Intrinsic Value, Post-Earnings Announcement Drift (PEAD), Contrarian Pullbacks, and Multi-Factor Quant Optimization.
          </p>
        </div>

        <!-- Rapid Command Bar (3-second primary task completion) -->
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
          <a
            href={path('/reports')}
            class="px-4 py-2.5 bg-[#0055ff] hover:bg-[#0044cc] text-white font-bold border border-[#0055ff] transition-none tap-target flex items-center gap-2"
          >
            <span>[ SEARCH ARCHIVE ({totalReportsCount}) ]</span>
          </a>
          <a
            href={path('/definitions')}
            class="px-3 py-2.5 bg-[#181818] hover:bg-[#222222] text-[#e5e5e5] border border-[#2e2e2e] transition-none tap-target"
          >
            METHODOLOGY
          </a>
        </div>
      </div>

      <!-- Strategy Fast Filters (Instant Access) -->
      <div class="flex flex-wrap items-center gap-2 pt-3 font-mono text-xs">
        <span class="text-[#8e8e8e] uppercase mr-1">STRATEGIES:</span>
        {STRATEGIES.map((strat) => (
          <a
            href={`#strategy-${strat.id}`}
            class="px-2.5 py-1 bg-[#181818] hover:bg-[#2e2e2e] text-[#e5e5e5] border border-[#2e2e2e] transition-none"
          >
            [{strat.code}] {strat.shortName} ({strat.reports.length})
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 12-Column Barometer Metrics Strip (High Scannability Matrix) -->
  <section class="border-b border-[#2e2e2e] bg-[#181818]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-[#2e2e2e]">
        <!-- Metric 1 -->
        <div class="p-4 font-mono">
          <div class="text-[10px] uppercase text-[#8e8e8e] tracking-wider">COVERED UNIVERSE</div>
          <div class="text-xl font-bold text-white mt-0.5">{totalArchetypeStocks} <span class="text-xs text-[#8e8e8e] font-normal">STOCKS</span></div>
          <div class="text-[10px] text-[#8e8e8e] mt-1">$2B+ Mkt Cap / ADTV > 500k</div>
        </div>

        <!-- Metric 2 -->
        <div class="p-4 font-mono">
          <div class="text-[10px] uppercase text-[#8e8e8e] tracking-wider">UNDERVALUED POOL</div>
          <div class="text-xl font-bold text-[#00cc66] mt-0.5">{undervaluedReports.length} <span class="text-xs text-[#8e8e8e] font-normal">SECURITIES</span></div>
          <div class="text-[10px] text-[#8e8e8e] mt-1">Multi-Model DCF Discount</div>
        </div>

        <!-- Metric 3 -->
        <div class="p-4 font-mono">
          <div class="text-[10px] uppercase text-[#8e8e8e] tracking-wider">WIDE MOAT ASSETS</div>
          <div class="text-xl font-bold text-[#0055ff] mt-0.5">{wideMoatReports.length} <span class="text-xs text-[#8e8e8e] font-normal">EQUITIES</span></div>
          <div class="text-[10px] text-[#8e8e8e] mt-1">Durable ROIC Advantage</div>
        </div>

        <!-- Metric 4 -->
        <div class="p-4 font-mono">
          <div class="text-[10px] uppercase text-[#8e8e8e] tracking-wider">PIPELINE AUDIT</div>
          <div class="text-xl font-bold text-[#e5e5e5] mt-0.5">100% <span class="text-xs text-[#00cc66] font-normal">VERIFIED</span></div>
          <div class="text-[10px] text-[#8e8e8e] mt-1">SEC EDGAR Primary Filings</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Utilitarian Strategy Radar Content -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    
    <!-- Strategy Control Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 mb-6 border-b border-[#2e2e2e]">
      <div>
        <h2 class="text-lg font-mono font-bold text-white uppercase tracking-tight">
          Systematic Strategy Screener Matrix
        </h2>
        <p class="text-xs font-mono text-[#8e8e8e]">Left-aligned high-density data matrix. Direct access to all fundamentals and model consensus.</p>
      </div>

      <!-- Tab Buttons (Flat, sharp borders, instant switch) -->
      <div class="flex flex-wrap items-center gap-1 font-mono text-xs" id="strategy-tabs-container">
        <button
          type="button"
          class="strategy-tab-btn px-3 py-1 bg-[#0055ff] text-white border border-[#0055ff] font-bold tap-target cursor-pointer"
          data-tab="all"
        >
          ALL STRATEGIES ({totalArchetypeStocks})
        </button>
        {STRATEGIES.map((strat) => (
          <button
            type="button"
            class="strategy-tab-btn px-3 py-1 bg-[#181818] text-[#8e8e8e] border border-[#2e2e2e] hover:text-[#e5e5e5] hover:border-[#3a3a3a] tap-target cursor-pointer"
            data-tab={strat.id}
          >
            {strat.shortName} ({strat.reports.length})
          </button>
        ))}
      </div>
    </div>

    <!-- Strategy Sections Wrapper -->
    <div class="space-y-8" id="strategy-sections-wrapper">
      {STRATEGIES.map((strat) => (
        <div id={`strategy-${strat.id}`} class="strategy-group-section border border-[#2e2e2e] bg-[#181818] scroll-mt-20" data-strategy={strat.id}>
          <!-- Strategy Module Header Banner (Utilitarian Data Header) -->
          <div class="border-b border-[#2e2e2e] p-4 bg-[#141414] font-mono">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 pb-2 border-b border-[#222222]">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 bg-[#222222] text-[#e5e5e5] text-xs font-bold border border-[#2e2e2e]">{strat.code}</span>
                <h3 class="text-base font-bold text-white uppercase">{strat.name}</h3>
                <span class="text-xs text-[#8e8e8e]">[{strat.badge}]</span>
              </div>
              <div class="text-xs text-[#8e8e8e]">
                ACTIVE QUORUM: <strong class="text-white">{strat.reports.length} SECURITIES</strong>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 pt-2 text-xs text-[#8e8e8e]">
              <div>
                <strong class="text-[#e5e5e5]">THESIS:</strong> {strat.thesis}
              </div>
              <div class="text-left md:text-right">
                <strong class="text-[#e5e5e5]">FILTER:</strong> {strat.criteria}
              </div>
            </div>
          </div>

          <!-- High-Density Utilitarian Data Table (Maximum scannability) -->
          <div class="overflow-x-auto">
            <table class="w-full text-left font-mono text-xs border-collapse">
              <thead>
                <tr class="bg-[#121212] text-[#8e8e8e] border-b border-[#2e2e2e]">
                  <th class="py-2.5 px-3 uppercase tracking-wider font-bold">Ticker</th>
                  <th class="py-2.5 px-3 uppercase tracking-wider font-bold">Company / Sector</th>
                  <th class="py-2.5 px-3 uppercase tracking-wider font-bold text-right">Price</th>
                  <th class="py-2.5 px-3 uppercase tracking-wider font-bold text-right">Consensus FV</th>
                  <th class="py-2.5 px-3 uppercase tracking-wider font-bold text-right">Margin / Spread</th>
                  <th class="py-2.5 px-3 uppercase tracking-wider font-bold text-center">Moat</th>
                  <th class="py-2.5 px-3 uppercase tracking-wider font-bold text-center">Verdict</th>
                  <th class="py-2.5 px-3 uppercase tracking-wider font-bold text-right">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#222222]">
                {strat.reports.map((report) => {
                  const upsideInfo = getUpsideData(report.data.currentPrice, report.data.valuationModels?.consensusFairValue);
                  const verdict = report.data.valuationModels?.verdict;
                  const moatRating = report.data.competitiveMoat?.rating;

                  return (
                    <tr class="hover:bg-[#1f1f1f] transition-none text-[#e5e5e5]">
                      <!-- Ticker -->
                      <td class="py-2.5 px-3 font-bold text-white whitespace-nowrap">
                        <a
                          href={path(`/tickers/${report.data.ticker.toLowerCase()}`)}
                          class="text-[#0055ff] hover:underline"
                        >
                          ${report.data.ticker}
                        </a>
                        <span class="text-[10px] text-[#8e8e8e] ml-1">[{report.data.exchange}]</span>
                      </td>

                      <!-- Company / Sector -->
                      <td class="py-2.5 px-3 max-w-[220px]">
                        <div class="text-white font-medium truncate" title={report.data.companyName}>
                          {report.data.companyName}
                        </div>
                        <div class="text-[10px] text-[#8e8e8e] truncate">
                          {report.data.sector}
                        </div>
                      </td>

                      <!-- Price -->
                      <td class="py-2.5 px-3 text-right font-bold text-white whitespace-nowrap">
                        ${report.data.currentPrice.toFixed(2)}
                      </td>

                      <!-- Fair Value -->
                      <td class="py-2.5 px-3 text-right text-[#8e8e8e] whitespace-nowrap">
                        {report.data.valuationModels?.consensusFairValue
                          ? `$${report.data.valuationModels.consensusFairValue.toFixed(2)}`
                          : 'N/A'}
                      </td>

                      <!-- Upside / Spread -->
                      <td class="py-2.5 px-3 text-right font-bold whitespace-nowrap">
                        {upsideInfo ? (
                          <span class={upsideInfo.isUndervalued ? 'text-[#00cc66]' : 'text-[#ff3344]'}>
                            {upsideInfo.label}
                          </span>
                        ) : (
                          <span class="text-[#8e8e8e]">N/A</span>
                        )}
                      </td>

                      <!-- Moat -->
                      <td class="py-2.5 px-3 text-center whitespace-nowrap">
                        {moatRating ? (
                          <span class={`px-1.5 py-0.5 text-[10px] font-bold ${getMoatBadgeStyle(moatRating)}`}>
                            {moatRating}
                          </span>
                        ) : (
                          <span class="text-[#8e8e8e] text-[10px]">None</span>
                        )}
                      </td>

                      <!-- Verdict -->
                      <td class="py-2.5 px-3 text-center whitespace-nowrap">
                        {verdict ? (
                          <span class={`px-1.5 py-0.5 text-[10px] font-bold uppercase ${getVerdictBadgeStyle(verdict)}`}>
                            {verdict}
                          </span>
                        ) : (
                          <span class="text-[#8e8e8e] text-[10px]">Unrated</span>
                        )}
                      </td>

                      <!-- Action (Immediate 2-click access) -->
                      <td class="py-2.5 px-3 text-right whitespace-nowrap">
                        <a
                          href={path(`/reports/${report.slug}`)}
                          class="px-2.5 py-1 bg-[#121212] hover:bg-[#0055ff] hover:text-white text-[#0055ff] border border-[#2e2e2e] font-bold text-xs transition-none tap-target inline-block"
                        >
                          [ DEEP DIVE ]
                        </a>
                      </td>
                    </tr>
                  );
                })}

                {strat.reports.length === 0 && (
                  <tr>
                    <td colspan="8" class="py-6 text-center text-xs text-[#8e8e8e] font-mono">
                      [ NO ACTIVE SECURITIES IN CURRENT SCREENING CYCLE ]
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>

    <!-- Complete Research Log Stream (Utilitarian List View) -->
    <div class="mt-12 pt-6 border-t border-[#2e2e2e]">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 mb-4 border-b border-[#2e2e2e]">
        <div>
          <h2 class="text-base font-mono font-bold text-white uppercase tracking-tight">
            Latest Fundamental Publications ({recentReports.length} Most Recent)
          </h2>
          <p class="text-xs font-mono text-[#8e8e8e]">Chronological publication feed with direct institutional access.</p>
        </div>
        <a
          href={path('/reports')}
          class="px-3 py-1.5 bg-[#0055ff] hover:bg-[#0044cc] text-white font-mono text-xs font-bold border border-[#0055ff] transition-none tap-target"
        >
          VIEW ALL {totalReportsCount} REPORTS &rarr;
        </a>
      </div>

      <!-- Scannable Publication Rows -->
      <div class="divide-y divide-[#222222] border border-[#2e2e2e] bg-[#181818]">
        {recentReports.map((report) => {
          const arch = report.data.archetype || resolveArchetype(report);
          const strat = STRATEGIES.find((s) => s.id === arch);

          return (
            <article class="p-3.5 hover:bg-[#1f1f1f] transition-none flex flex-col md:flex-row md:items-center justify-between gap-3 font-mono text-xs">
              <div class="flex items-start md:items-center gap-3 flex-1 min-w-0">
                <!-- Ticker badge -->
                <a
                  href={path(`/tickers/${report.data.ticker.toLowerCase()}`)}
                  class="font-black text-[#0055ff] bg-[#121212] px-2 py-1 border border-[#2e2e2e] hover:border-[#0055ff] shrink-0"
                >
                  ${report.data.ticker}
                </a>

                <!-- Meta & Title -->
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2 text-[10px] text-[#8e8e8e] mb-0.5">
                    <time datetime={new Date(report.data.publishDate).toISOString()}>
                      {new Date(report.data.publishDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </time>
                    <span>&bull;</span>
                    <span>{report.data.exchange}</span>
                    <span>&bull;</span>
                    <span>{report.data.sector}</span>
                    {strat && (
                      <span class="text-[#e5e5e5] font-bold">[{strat.code}]</span>
                    )}
                  </div>
                  <h3 class="text-sm font-bold text-white hover:text-[#0055ff] transition-none truncate">
                    <a href={path(`/reports/${report.slug}`)}>{report.data.title}</a>
                  </h3>
                </div>
              </div>

              <!-- Price & Quick Access -->
              <div class="flex items-center justify-between md:justify-end gap-4 shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-[#222222]">
                <div class="text-right">
                  <div class="font-bold text-white">${report.data.currentPrice.toFixed(2)}</div>
                  <div class={`text-[10px] ${report.data.movePercent >= 0 ? 'text-[#00cc66]' : 'text-[#ff3344]'}`}>
                    {report.data.movePercent >= 0 ? '+' : ''}{report.data.movePercent.toFixed(1)}% session
                  </div>
                </div>

                <a
                  href={path(`/reports/${report.slug}`)}
                  class="px-3 py-1 bg-[#121212] hover:bg-[#0055ff] hover:text-white text-[#0055ff] border border-[#2e2e2e] font-bold transition-none tap-target"
                >
                  OPEN &rarr;
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Google Verification -->
  <a href={path('/google610bb287ece732d9.html')} class="sr-only" aria-hidden="true" tabindex="-1" rel="author">Google Site Verification</a>
</BaseLayout>

<script>
  // Utilitarian Strategy Tab Switcher (Fast, zero layout shift)
  document.addEventListener('DOMContentLoaded', () => {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.strategy-tab-btn');
    const sections = document.querySelectorAll<HTMLElement>('.strategy-group-section');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');

        // Reset buttons to utilitarian base state
        tabButtons.forEach((b) => {
          b.classList.remove('bg-[#0055ff]', 'text-white', 'border-[#0055ff]');
          b.classList.add('bg-[#181818]', 'text-[#8e8e8e]', 'border-[#2e2e2e]');
        });

        // Set active button
        btn.classList.remove('bg-[#181818]', 'text-[#8e8e8e]', 'border-[#2e2e2e]');
        btn.classList.add('bg-[#0055ff]', 'text-white', 'border-[#0055ff]');

        // Toggle sections
        sections.forEach((sec) => {
          const secStrategy = sec.getAttribute('data-strategy');
          if (targetTab === 'all' || secStrategy === targetTab) {
            sec.style.display = 'block';
          } else {
            sec.style.display = 'none';
          }
        });
      });
    });
  });
</script>
