---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import { path } from '../../utils/paths';
import { formatPriceTimestamp } from '../../utils/formatters';

const { entry } = Astro.props;
const report = entry.data;

// Render markdown content safely across Astro versions
let ContentComponent;
try {
  if (typeof (entry as any).render === 'function') {
    const rendered = await (entry as any).render();
    ContentComponent = rendered.Content;
  } else {
    const rendered = await render(entry);
    ContentComponent = rendered.Content;
  }
} catch (e) {
  const rendered = await render(entry);
  ContentComponent = rendered.Content;
}

const isPositive = report.movePercent >= 0;
const formattedDate = new Date(report.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
const priceDisplayLabel = formatPriceTimestamp(report.publishDate, report.priceTimestamp);

// Canonical & page meta
const targetReportUrl = path(`/reports/${entry.slug}#sec-institutional-summary`);
const pageTitle = `[Deprecated] ${report.ticker} Complete Institutional Analyst Report | EquiSight`;
const pageDescription = `The standalone institutional-summary view has been consolidated into the primary report page for ${report.companyName} ($${report.ticker}).`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ticker={report.ticker}
  companyName={report.companyName}
  sector={report.sector}
  publishDate={typeof report.publishDate === 'string' ? report.publishDate : report.publishDate.toISOString()}
>
  <!-- SEO & Canonical Header: Auto Redirect to Main Report Section -->
  <head slot="head">
    <meta http-equiv="refresh" content={`0;url=${targetReportUrl}`} />
    <link rel="canonical" href={targetReportUrl} />
  </head>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

    <!-- Prominent Deprecation & Consolidation Banner -->
    <aside class="p-4 sm:p-5 rounded-2xl border border-amber-500/40 bg-amber-950/30 text-amber-200 shadow-xl backdrop-blur-md flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4" role="alert">
      <div class="flex items-start gap-3">
        <div class="p-2 rounded-xl bg-amber-500/20 text-amber-400 shrink-0 mt-0.5">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-sm font-bold text-white tracking-tight">Notice: Institutional Summary Page is Deprecated</h2>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/30 uppercase">Consolidated</span>
          </div>
          <p class="text-xs text-amber-300/90 mt-1 leading-relaxed">
            All institutional summary tools, chapter jump ribbons, table toolkits, and unabridged qualitative research have been permanently unified into the <strong>Complete Institutional Analyst Report</strong> section on the primary research page.
          </p>
        </div>
      </div>
      <a
        href={targetReportUrl}
        class="inline-flex shrink-0 items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs transition-colors shadow-sm"
      >
        <span>Go to Unified Report</span>
        <span>&rarr;</span>
      </a>
    </aside>

    <!-- Top Minimalist Institutional Breadcrumb & Header Bar -->
    <header class="p-5 sm:p-6 rounded-2xl border border-slate-800 bg-slate-900/80 shadow-xl backdrop-blur-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-800">
        <div>
          <div class="flex items-center gap-2 text-xs font-mono text-slate-400 mb-1.5 flex-wrap">
            <a href={path('/reports')} class="hover:text-emerald-400 transition-colors">Reports</a>
            <span>/</span>
            <a href={path(`/reports/${entry.slug}`)} class="hover:text-emerald-400 transition-colors">${report.ticker} Full Suite</a>
            <span>/</span>
            <span class="text-emerald-400 font-semibold">Institutional Summary</span>
          </div>

          <div class="flex items-center gap-3 flex-wrap">
            <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight">
              ${report.ticker} Complete Institutional Analyst Report
            </h1>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-slate-800 text-slate-300 border border-slate-700">
              {report.exchange}
            </span>
            <span class={`px-2.5 py-0.5 rounded-full text-xs font-mono font-bold border ${isPositive ? 'bg-emerald-950/80 text-emerald-300 border-emerald-500/40' : 'bg-rose-950/80 text-rose-300 border-rose-500/40'}`}>
              {isPositive ? '+' : ''}{report.movePercent.toFixed(2)}% (${report.currentPrice ? report.currentPrice.toFixed(2) : 'N/A'})
            </span>
          </div>

          <p class="text-xs text-slate-400 mt-1">
            {report.companyName} &bull; Sector: {report.sector} &bull; {formattedDate} ({priceDisplayLabel})
          </p>
        </div>

        <!-- Utility Link Back to Full Interactive Workspace -->
        <div class="flex items-center gap-2 self-start md:self-center shrink-0">
          <a
            href={path(`/reports/${entry.slug}`)}
            class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-semibold text-slate-200 hover:text-white transition-all flex items-center gap-1.5 shadow-sm"
          >
            <span>&larr;</span>
            <span>Interactive Terminal</span>
          </a>
          <a
            href={path(`/reports/${entry.slug}/print`)}
            target="_blank"
            class="px-3.5 py-2 rounded-xl bg-emerald-950/60 hover:bg-emerald-900/80 border border-emerald-500/40 text-xs font-semibold text-emerald-300 hover:text-emerald-200 transition-all flex items-center gap-1.5 shadow-sm"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span>Print PDF</span>
          </a>
        </div>
      </div>

      <!-- Quick Document Metadata & Reading Time Strip -->
      <div class="pt-3 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-400 font-mono">
        <div class="flex items-center gap-4 flex-wrap">
          <span class="flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Audited Unabridged Synthesis</span>
          </span>
          <span>&bull;</span>
          <span id="read-time-badge">⏱️ Est. ~8-10 min read</span>
          <span>&bull;</span>
          <span id="word-count-badge">📄 ~2,500 words</span>
        </div>

        <div class="flex items-center gap-2">
          <span class="text-[11px] text-slate-400">Desktop View Density:</span>
          <button
            type="button"
            id="btn-density-toggle"
            class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition-colors cursor-pointer"
            title="Toggle between comfortable editorial reading and high-density desk spacing"
          >
            Density: Comfortable
          </button>
        </div>
      </div>
    </header>

    <!-- Interactive Institutional Analyst Report Component Card -->
    <main
      class="institutional-memo-card p-6 sm:p-8 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-2xl backdrop-blur-md relative"
      id="sec-institutional-summary"
    >
      <!-- Reading Progress Bar -->
      <div
        id="reading-progress-bar"
        class="h-1 bg-gradient-to-r from-emerald-500 via-sky-500 to-indigo-500 absolute top-0 left-0 rounded-t-2xl transition-all duration-75 w-0 z-20"
        aria-hidden="true"
      ></div>

      <!-- Section Action Ribbon & Controls -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 mb-5 border-b border-slate-800">
        <div>
          <div class="flex items-center gap-2.5">
            <h2 class="text-lg sm:text-xl font-extrabold text-white tracking-tight flex items-center gap-2">
              <span>Complete Institutional Analyst Report</span>
            </h2>
            <span class="text-[10px] font-mono uppercase tracking-wider text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 px-2 py-0.5 rounded-full font-bold pl-5">
              Unabridged Dossier
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">
            Structured 9-chapter qualitative synthesis, balance sheet stress tests, moat pillars, and multi-model valuation audit.
          </p>
        </div>

        <!-- Global Dossier Folding & Search Controls -->
        <div class="flex items-center gap-2 flex-wrap">
          <!-- In-Document Search Input -->
          <div class="relative">
            <input
              type="text"
              id="memo-search-input"
              placeholder="Search memo (e.g. debt, Sanofi)..."
              class="w-48 sm:w-56 px-2.5 py-1.5 pl-7 rounded-lg bg-slate-950/80 border border-slate-700/80 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors"
            />
            <svg class="w-3.5 h-3.5 text-slate-500 absolute left-2 top-2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span id="memo-search-count" class="hidden absolute right-2 top-1.5 text-[10px] font-mono text-emerald-400"></span>
          </div>

          <!-- Expand / Collapse All -->
          <button
            type="button"
            id="btn-toggle-all-chapters"
            class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs font-mono font-semibold text-slate-300 hover:text-white transition-all cursor-pointer flex items-center gap-1.5 shadow-sm"
          >
            <span id="toggle-all-icon">⊟</span>
            <span id="toggle-all-text">Collapse All</span>
          </button>
        </div>
      </div>

      <!-- Sticky Chapter Jump Ribbon (In-Section Mini-ToC) -->
      <nav
        id="chapter-toc-ribbon"
        class="sticky top-4 z-10 py-2.5 px-3 mb-6 rounded-xl bg-slate-950/90 border border-slate-800 backdrop-blur-md shadow-lg flex items-center gap-1.5 overflow-x-auto scrollbar-thin text-xs font-mono"
        aria-label="Report Chapters Navigation"
      >
        <span class="text-[11px] uppercase tracking-wider text-slate-400 font-bold shrink-0 mr-1.5 flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
          </svg>
          <span>Jump:</span>
        </span>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="exec-summary">
          Exec Summary
        </button>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="ch-1">
          01 Trading & Volume
        </button>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="ch-2">
          02 Debt & Solvency
        </button>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="ch-3">
          03 Margins & EPS
        </button>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="ch-4">
          04 Business Model
        </button>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="ch-5">
          05 Sector Dynamics
        </button>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="ch-6">
          06 Moat & Peers
        </button>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="ch-7">
          07 8-Model Valuation
        </button>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="ch-8">
          08 Macro Vectors
        </button>
        <button type="button" class="toc-chip px-2.5 py-1 rounded-md bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 whitespace-nowrap cursor-pointer transition-colors" data-target="ch-9">
          09 Theses & Chains
        </button>
      </nav>

      <!-- Active Content Container with Enhanced Typography & Chapter Parsing -->
      <div
        id="memo-body-container"
        data-ticker={report.ticker}
        data-company-name={report.companyName}
        class="prose prose-invert prose-emerald max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-emerald-400 hover:prose-a:text-emerald-300 leading-relaxed"
      >
        <ContentComponent />
      </div>

      <!-- Quick Back-to-Top Floating Assistant inside card -->
      <div class="mt-12 pt-6 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
        <div class="font-mono">
          <span>End of Unabridged Institutional Memo &bull; CIK Filings Audited</span>
        </div>
        <button
          type="button"
          id="btn-back-to-top"
          class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white font-mono transition-colors flex items-center gap-1.5 cursor-pointer shadow-sm"
        >
          <span>&uarr;</span>
          <span>Back to Top of Memo</span>
        </button>
      </div>
    </main>

  </div>
</BaseLayout>

<style>
  /* Density Styles */
  .density-compact {
    font-size: 0.8125rem !important; /* 13px */
    line-height: 1.5 !important;
  }
  .density-compact :global(p),
  .density-compact :global(li),
  .density-compact :global(td) {
    margin-top: 0.35rem !important;
    margin-bottom: 0.35rem !important;
    font-size: 0.775rem !important;
  }
  .density-compact :global(h2) {
    margin-top: 1.25rem !important;
    margin-bottom: 0.5rem !important;
    font-size: 1.05rem !important;
  }
  .density-compact :global(h3) {
    margin-top: 1rem !important;
    margin-bottom: 0.35rem !important;
    font-size: 0.925rem !important;
  }

  /* Interactive Chapter Accordion Headings */
  :global(.chapter-accordion-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(51, 65, 85, 0.8);
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    margin-top: 2rem !important;
    margin-bottom: 0.75rem !important;
  }
  :global(.chapter-accordion-header:hover) {
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(16, 185, 129, 0.4);
  }
  :global(.chapter-accordion-icon) {
    transition: transform 0.2s ease;
  }
  :global(.chapter-collapsed .chapter-accordion-icon) {
    transform: rotate(-90deg);
  }
  :global(.chapter-content) {
    transition: all 0.25s ease-in-out;
  }
  :global(.chapter-collapsed .chapter-content) {
    display: none !important;
  }

  /* Table Container Styling with Action Toolbar */
  :global(.interactive-table-wrapper) {
    margin: 2rem 0;
    border-radius: 1rem;
    border: 1px solid rgba(51, 65, 85, 0.7);
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.85) 0%, rgba(2, 6, 23, 0.95) 100%);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
    position: relative;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  :global(.interactive-table-wrapper:hover) {
    border-color: rgba(71, 85, 105, 0.9);
    box-shadow: 0 14px 28px -4px rgba(0, 0, 0, 0.5), 0 0 15px rgba(16, 185, 129, 0.05);
  }
  :global(.table-toolbar) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 1.15rem;
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid rgba(51, 65, 85, 0.75);
    border-top-left-radius: 0.95rem;
    border-top-right-radius: 0.95rem;
    backdrop-blur-md: blur(8px);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.725rem;
    color: #94a3b8;
  }
  :global(.table-toolbar-left) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  :global(.table-tag-badge) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(16, 185, 129, 0.12);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }
  :global(.table-title-text) {
    font-weight: 700;
    color: #f1f5f9;
    font-size: 0.8rem;
    letter-spacing: -0.01em;
  }
  :global(.table-record-pill) {
    font-size: 0.675rem;
    padding: 0.15rem 0.5rem;
    border-radius: 0.375rem;
    background: rgba(30, 41, 59, 0.7);
    color: #94a3b8;
    border: 1px solid rgba(51, 65, 85, 0.6);
  }
  :global(.table-toolbar-right) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  :global(.table-action-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 0.5rem;
    background: rgba(30, 41, 59, 0.9);
    border: 1px solid rgba(71, 85, 105, 0.7);
    color: #cbd5e1;
    font-size: 0.675rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  :global(.table-action-btn:hover) {
    background: rgba(51, 65, 85, 0.95);
    border-color: rgba(16, 185, 129, 0.4);
    color: #ffffff;
  }
  :global(.table-action-btn.active) {
    background: rgba(16, 185, 129, 0.18);
    border-color: rgba(16, 185, 129, 0.5);
    color: #34d399;
  }
  :global(.table-scroll-container) {
    overflow-x: auto;
    max-width: 100%;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(51, 65, 85, 0.8) rgba(15, 23, 42, 0.5);
  }
  :global(.table-scroll-container::-webkit-scrollbar) {
    height: 7px;
  }
  :global(.table-scroll-container::-webkit-scrollbar-track) {
    background: rgba(15, 23, 42, 0.6);
  }
  :global(.table-scroll-container::-webkit-scrollbar-thumb) {
    background: rgba(51, 65, 85, 0.8);
    border-radius: 9999px;
  }
  :global(.table-scroll-container::-webkit-scrollbar-thumb:hover) {
    background: rgba(100, 116, 139, 0.9);
  }
  :global(.table-scroll-container table) {
    margin: 0 !important;
    width: 100%;
    border-collapse: separate !important;
    border-spacing: 0 !important;
    text-align: left;
    font-size: 0.775rem;
    line-height: 1.5;
  }
  :global(.table-scroll-container thead) {
    background: rgba(15, 23, 42, 0.98);
  }
  :global(.table-scroll-container thead th) {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 0.85rem 1rem !important;
    font-size: 0.7rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.06em !important;
    color: #94a3b8 !important;
    background: rgba(15, 23, 42, 0.98) !important;
    border-bottom: 2px solid rgba(51, 65, 85, 0.9) !important;
    border-top: none !important;
    border-left: none !important;
    border-right: 1px solid rgba(30, 41, 59, 0.6) !important;
    white-space: nowrap;
  }
  :global(.table-scroll-container thead th:last-child) {
    border-right: none !important;
  }
  :global(.table-scroll-container tbody tr) {
    border-bottom: 1px solid rgba(30, 41, 59, 0.75);
    transition: background-color 0.15s ease;
  }
  :global(.table-scroll-container tbody tr:last-child) {
    border-bottom: none;
  }
  :global(.table-scroll-container tbody tr:nth-child(even)) {
    background-color: rgba(15, 23, 42, 0.35);
  }
  :global(.table-scroll-container tbody tr:nth-child(odd)) {
    background-color: rgba(2, 6, 23, 0.25);
  }
  :global(.table-scroll-container tbody tr:hover) {
    background-color: rgba(30, 41, 59, 0.65) !important;
  }
  :global(.table-scroll-container tbody tr.row-highlight-target) {
    background: rgba(16, 185, 129, 0.12) !important;
    border-left: 3px solid #10b981;
  }
  :global(.table-scroll-container tbody tr.row-highlight-summary) {
    background: rgba(15, 23, 42, 0.85) !important;
    font-weight: 700;
    border-top: 2px solid rgba(51, 65, 85, 0.9);
  }
  :global(.table-scroll-container tbody td) {
    padding: 0.75rem 1rem !important;
    color: #cbd5e1 !important;
    border-top: none !important;
    border-bottom: 1px solid rgba(30, 41, 59, 0.7) !important;
    border-left: none !important;
    border-right: 1px solid rgba(30, 41, 59, 0.45) !important;
    vertical-align: middle;
  }
  :global(.table-scroll-container tbody td:last-child) {
    border-right: none !important;
  }
  :global(.table-scroll-container tbody td strong) {
    color: #f8fafc;
    font-weight: 600;
  }
  :global(.table-scroll-container tbody td code) {
    background: rgba(30, 41, 59, 0.8);
    color: #38bdf8;
    padding: 0.2rem 0.45rem;
    border-radius: 0.375rem;
    border: 1px solid rgba(51, 65, 85, 0.65);
    font-size: 0.725rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: -0.01em;
  }
  :global(.table-scroll-container table.table-dense thead th) {
    padding: 0.45rem 0.75rem !important;
    font-size: 0.65rem !important;
  }
  :global(.table-scroll-container table.table-dense tbody td) {
    padding: 0.4rem 0.75rem !important;
    font-size: 0.725rem !important;
  }
  :global(.table-footer-strip) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1.15rem;
    background: rgba(15, 23, 42, 0.8);
    border-top: 1px solid rgba(51, 65, 85, 0.5);
    border-bottom-left-radius: 0.95rem;
    border-bottom-right-radius: 0.95rem;
    font-size: 0.675rem;
    color: #64748b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  :global(.table-footer-hint) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  /* Deductive Step Chains Flow */
  :global(.deduction-step-flow) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0.4rem 0 0.8rem 0;
    padding: 0.5rem 0.75rem;
    background: rgba(2, 6, 23, 0.5);
    border: 1px solid rgba(51, 65, 85, 0.6);
    border-radius: 0.5rem;
  }
  :global(.deduction-step-node) {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.55rem;
    border-radius: 0.375rem;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(71, 85, 105, 0.7);
    font-size: 0.725rem;
    font-weight: 500;
    color: #e2e8f0;
  }
  :global(.deduction-arrow) {
    color: #10b981;
    font-weight: bold;
    font-size: 0.8rem;
  }

  /* Highlight Matching for in-document search */
  :global(mark.search-highlight) {
    background-color: rgba(245, 158, 11, 0.45);
    color: #ffffff;
    border-radius: 2px;
    padding: 0 2px;
  }
</style>

<script>
  function initInstitutionalSummary() {
    const memoBody = document.getElementById('memo-body-container');
    if (!memoBody) return;

    // 1. Calculate reading time & word count
    const text = memoBody.innerText || '';
    const words = text.trim().split(/\s+/).length;
    const readMinutes = Math.max(1, Math.ceil(words / 225));
    const wordCountBadge = document.getElementById('word-count-badge');
    const readTimeBadge = document.getElementById('read-time-badge');
    if (wordCountBadge) wordCountBadge.textContent = `📄 ~${words.toLocaleString()} words`;
    if (readTimeBadge) readTimeBadge.textContent = `⏱️ Est. ~${readMinutes} min read`;

    // 2. Reading Progress Indicator
    const progressBar = document.getElementById('reading-progress-bar');
    const container = document.getElementById('sec-institutional-summary');
    if (progressBar && container) {
      window.addEventListener('scroll', () => {
        const rect = container.getBoundingClientRect();
        const winHeight = window.innerHeight;
        const totalHeight = rect.height - winHeight;
        if (totalHeight > 0) {
          const progress = Math.min(100, Math.max(0, ((-rect.top) / totalHeight) * 100));
          progressBar.style.width = `${progress}%`;
        }
      }, { passive: true });
    }

    // 3. Density Mode Toggle
    const densityBtn = document.getElementById('btn-density-toggle');
    let isCompact = false;
    if (densityBtn) {
      densityBtn.addEventListener('click', () => {
        isCompact = !isCompact;
        memoBody.classList.toggle('density-compact', isCompact);
        densityBtn.textContent = isCompact ? 'Density: Compact Desk' : 'Density: Comfortable';
      });
    }

    // 4. Back to top button
    const backToTopBtn = document.getElementById('btn-back-to-top');
    if (backToTopBtn) {
      backToTopBtn.addEventListener('click', () => {
        container?.scrollIntoView({ behavior: 'smooth' });
      });
    }

    // 5. Enhance Tables with Professional Institutional UI Toolkit
    const ticker = memoBody.getAttribute('data-ticker') || '';
    const companyName = memoBody.getAttribute('data-company-name') || '';
    const tables = memoBody.querySelectorAll('table');

    tables.forEach((table, index) => {
      // Check if already enhanced
      if (table.closest('.interactive-table-wrapper')) return;

      // Extract header text to determine dataset semantic type
      const headerThs = Array.from(table.querySelectorAll('thead th'));
      const headerText = headerThs.map((th) => th.innerText.toLowerCase().trim()).join(' ');

      let datasetCategory = 'Financial Dataset';
      let datasetIcon = '📊';
      let datasetAccent = 'emerald';

      if (headerText.includes('session metric') || headerText.includes('analytical parameter') || headerText.includes('trading venue') || headerText.includes('observed level')) {
        datasetCategory = 'Trading & Liquidity Telemetry';
        datasetIcon = '⚡';
        datasetAccent = 'sky';
      } else if (headerText.includes('quarter') && (headerText.includes('diluted eps') || headerText.includes('beat/miss'))) {
        datasetCategory = 'Historical Quarterly EPS Audit';
        datasetIcon = '📈';
        datasetAccent = 'indigo';
      } else if (headerText.includes('moat pillar') || headerText.includes('assessment')) {
        datasetCategory = 'Economic Moat Structural Decomposition';
        datasetIcon = '🏰';
        datasetAccent = 'amber';
      } else if (headerText.includes('ticker') && (headerText.includes('market cap') || headerText.includes('pe') || headerText.includes('ev/ebitda'))) {
        datasetCategory = 'Institutional Peer Benchmarking Matrix';
        datasetIcon = '⚖️';
        datasetAccent = 'purple';
      } else if (headerText.includes('valuation methodology') || headerText.includes('calculated fair value') || headerText.includes('implied upside')) {
        datasetCategory = 'Multi-Model Valuation & DCF Suite';
        datasetIcon = '💎';
        datasetAccent = 'emerald';
      }

      // Format header cells: enhance column headers with icons, clean typography, and uppercase labels
      headerThs.forEach((th, thIdx) => {
        th.classList.add('tracking-wider');
      });

      // Scan and enhance body rows and cells
      const tbodyRows = Array.from(table.querySelectorAll('tbody tr'));
      tbodyRows.forEach((row) => {
        const rowText = row.innerText.trim();
        const rowTextLower = rowText.toLowerCase();

        // 1. Highlight target company in peer matrix
        if (ticker && (rowText.includes(`(${ticker})`) || rowText.includes(` ${ticker} `) || rowText.startsWith(ticker) || (companyName && rowTextLower.includes(companyName.toLowerCase().slice(0, 10))))) {
          row.classList.add('row-highlight-target');
        }

        // 2. Highlight summary or consensus row
        if (rowTextLower.includes('consensus fair value target') || rowTextLower.includes('weighted consensus') || rowTextLower.includes('total / average')) {
          row.classList.add('row-highlight-summary');
        }

        // 3. Enhance specific cells with badges & colored tags
        const cells = Array.from(row.querySelectorAll('td'));
        cells.forEach((cell) => {
          const raw = cell.innerHTML.trim();
          const text = cell.innerText.trim();

          // Numerical upside / downside pill formatting
          if (/^[-+]?\d+(\.\d+)?%$/.test(text)) {
            const isNeg = text.startsWith('-');
            const isPos = text.startsWith('+') && parseFloat(text) > 0;
            const badgeClass = isNeg
              ? 'bg-rose-950/70 text-rose-300 border border-rose-800/60 px-2 py-0.5 rounded font-mono text-[11px] font-bold'
              : (isPos ? 'bg-emerald-950/70 text-emerald-300 border border-emerald-800/60 px-2 py-0.5 rounded font-mono text-[11px] font-bold' : 'font-mono text-slate-300');
            cell.innerHTML = `<span class="${badgeClass}">${text}</span>`;
          }
          // Moat strength pills
          else if (['wide', 'narrow', 'none'].includes(text.toLowerCase())) {
            let color = 'bg-slate-800 text-slate-300 border-slate-700';
            if (text.toLowerCase() === 'wide') color = 'bg-emerald-950 text-emerald-300 border-emerald-700/60';
            if (text.toLowerCase() === 'narrow') color = 'bg-sky-950 text-sky-300 border-sky-700/60';
            if (text.toLowerCase() === 'none') color = 'bg-slate-800 text-slate-400 border-slate-700';
            cell.innerHTML = `<span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider border ${color}">${text}</span>`;
          }
          // Overvalued / Undervalued status chips
          else if (text.includes('Significantly Overvalued')) {
            cell.innerHTML = raw.replace('Significantly Overvalued', '<span class="px-2 py-0.5 rounded bg-rose-950/80 text-rose-300 border border-rose-800/60 text-[10px] font-bold">Significantly Overvalued</span>');
          } else if (text.includes('Significantly Undervalued')) {
            cell.innerHTML = raw.replace('Significantly Undervalued', '<span class="px-2 py-0.5 rounded bg-emerald-950/80 text-emerald-300 border border-emerald-800/60 text-[10px] font-bold">Significantly Undervalued</span>');
          } else if (text.includes('Fairly Valued')) {
            cell.innerHTML = raw.replace('Fairly Valued', '<span class="px-2 py-0.5 rounded bg-amber-950/80 text-amber-300 border border-amber-800/60 text-[10px] font-bold">Fairly Valued</span>');
          }
        });
      });

      // Construct Wrapper and Toolbar
      const wrapper = document.createElement('div');
      wrapper.className = 'interactive-table-wrapper not-prose';

      const toolbar = document.createElement('div');
      toolbar.className = 'table-toolbar';

      // Left Toolbar Section (Badge + Title + Record Count)
      const leftPart = document.createElement('div');
      leftPart.className = 'table-toolbar-left';

      const tagBadge = document.createElement('span');
      tagBadge.className = 'table-tag-badge';
      tagBadge.innerHTML = `<span>${datasetIcon}</span><span>${datasetCategory}</span>`;

      const titleSpan = document.createElement('span');
      titleSpan.className = 'table-title-text';
      titleSpan.textContent = `Table #${index + 1}`;

      const countPill = document.createElement('span');
      countPill.className = 'table-record-pill';
      const recordCount = tbodyRows.length;
      countPill.textContent = `${recordCount} ${recordCount === 1 ? 'row' : 'rows'}`;

      leftPart.appendChild(tagBadge);
      leftPart.appendChild(titleSpan);
      leftPart.appendChild(countPill);

      // Right Toolbar Section (Density Toggle + Copy CSV Button)
      const rightPart = document.createElement('div');
      rightPart.className = 'table-toolbar-right';

      // Quick Density toggle button
      const denseBtn = document.createElement('button');
      denseBtn.type = 'button';
      denseBtn.className = 'table-action-btn';
      denseBtn.title = 'Toggle condensed row padding';
      denseBtn.innerHTML = `<span>↕</span><span>Compact</span>`;
      let isTableDense = false;
      denseBtn.addEventListener('click', () => {
        isTableDense = !isTableDense;
        table.classList.toggle('table-dense', isTableDense);
        denseBtn.classList.toggle('active', isTableDense);
        denseBtn.innerHTML = isTableDense ? `<span>↕</span><span>Relaxed</span>` : `<span>↕</span><span>Compact</span>`;
      });

      // Copy CSV Button
      const copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'table-action-btn';
      copyBtn.title = 'Copy dataset to clipboard in tab-separated spreadsheet format';
      copyBtn.innerHTML = `<span>📋</span><span>Export TSV</span>`;

      copyBtn.addEventListener('click', () => {
        const rows = Array.from(table.querySelectorAll('tr'));
        const csv = rows.map((row) => {
          const cols = Array.from(row.querySelectorAll('th, td'));
          return cols.map((col) => `"${col.innerText.replace(/"/g, '""').trim()}"`).join('\t');
        }).join('\n');

        navigator.clipboard.writeText(csv).then(() => {
          copyBtn.innerHTML = `<span>✓</span><span>Copied!</span>`;
          copyBtn.classList.add('active');
          setTimeout(() => {
            copyBtn.innerHTML = `<span>📋</span><span>Export TSV</span>`;
            copyBtn.classList.remove('active');
          }, 2000);
        });
      });

      rightPart.appendChild(denseBtn);
      rightPart.appendChild(copyBtn);

      toolbar.appendChild(leftPart);
      toolbar.appendChild(rightPart);

      // Scrollable Table Container
      const scrollDiv = document.createElement('div');
      scrollDiv.className = 'table-scroll-container';

      // Footer Strip with Responsive Scroll Hint and Metadata
      const footerStrip = document.createElement('div');
      footerStrip.className = 'table-footer-strip';
      
      const footerHint = document.createElement('div');
      footerHint.className = 'table-footer-hint';

      const footerMeta = document.createElement('span');
      footerMeta.className = 'text-slate-500';
      footerMeta.textContent = `EquiSight Institutional Engine v2.4`;

      footerStrip.appendChild(footerHint);
      footerStrip.appendChild(footerMeta);

      // Insert wrapper into DOM
      table.parentNode?.insertBefore(wrapper, table);
      scrollDiv.appendChild(table);
      wrapper.appendChild(toolbar);
      wrapper.appendChild(scrollDiv);
      wrapper.appendChild(footerStrip);
    });

    // 6. Enhance Deductive Chains (Transform 'A -> B -> C' into Visual Flowchips)
    const listItems = memoBody.querySelectorAll('li');
    listItems.forEach((li) => {
      const html = li.innerHTML;
      if (html.includes('-&gt;') || html.includes('->')) {
        const parts = html.split(/(?:-&gt;|->)/).map((p) => p.trim());
        if (parts.length > 1) {
          const flow = document.createElement('div');
          flow.className = 'deduction-step-flow not-prose';
          parts.forEach((p, idx) => {
            const node = document.createElement('span');
            node.className = 'deduction-step-node';
            node.innerHTML = p;
            flow.appendChild(node);

            if (idx < parts.length - 1) {
              const arrow = document.createElement('span');
              arrow.className = 'deduction-arrow';
              arrow.textContent = '➔';
              flow.appendChild(arrow);
            }
          });
          // Replace or append
          li.innerHTML = '';
          li.appendChild(flow);
        }
      }
    });

    // 7. Group Markdown H2 headings into Progressive Disclosure Chapters
    const h2Elements = Array.from(memoBody.querySelectorAll('h2'));
    const chapters: { id: string; header: HTMLElement; content: HTMLElement[] }[] = [];

    h2Elements.forEach((h2, idx) => {
      let chapterId = `exec-summary`;
      const titleText = h2.innerText.trim();
      const numMatch = titleText.match(/^##?\s*(\d+)\./) || titleText.match(/^(\d+)\./);
      if (numMatch) {
        chapterId = `ch-${numMatch[1]}`;
      } else if (idx === 0) {
        chapterId = 'exec-summary';
      } else {
        chapterId = `sec-${idx}`;
      }

      h2.id = chapterId;

      // Collect all sibling elements until next h2
      const contentNodes: HTMLElement[] = [];
      let sibling = h2.nextElementSibling as HTMLElement | null;
      while (sibling && sibling.tagName !== 'H2') {
        contentNodes.push(sibling);
        sibling = sibling.nextElementSibling as HTMLElement | null;
      }

      chapters.push({ id: chapterId, header: h2, content: contentNodes });
    });

    // Transform H2s into collapsible headers
    chapters.forEach((ch) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'chapter-container';
      wrapper.id = `wrapper-${ch.id}`;

      const headerDiv = document.createElement('div');
      headerDiv.className = 'chapter-accordion-header not-prose';
      headerDiv.setAttribute('role', 'button');
      headerDiv.setAttribute('aria-expanded', 'true');
      headerDiv.tabIndex = 0;

      const titlePart = document.createElement('div');
      titlePart.className = 'flex items-center gap-2.5';
      
      const badge = document.createElement('span');
      badge.className = 'px-2 py-0.5 rounded font-mono text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-800/60';
      badge.textContent = ch.id === 'exec-summary' ? 'SYNOPSIS' : ch.id.toUpperCase();

      const titleLabel = document.createElement('span');
      titleLabel.className = 'font-bold text-white text-sm sm:text-base tracking-tight';
      titleLabel.textContent = ch.header.innerText.replace(/^##?\s*/, '').replace(/^\d+\.\s*/, '');

      titlePart.appendChild(badge);
      titlePart.appendChild(titleLabel);

      const iconPart = document.createElement('span');
      iconPart.className = 'chapter-accordion-icon text-xs text-slate-400 font-mono';
      iconPart.innerHTML = '▼';

      headerDiv.appendChild(titlePart);
      headerDiv.appendChild(iconPart);

      const contentDiv = document.createElement('div');
      contentDiv.className = 'chapter-content';

      // Insert wrapper right before H2
      ch.header.parentNode?.insertBefore(wrapper, ch.header);
      wrapper.appendChild(headerDiv);
      wrapper.appendChild(contentDiv);

      // Move children into contentDiv
      ch.content.forEach((node) => contentDiv.appendChild(node));
      // Remove original H2 from view
      ch.header.style.display = 'none';

      // Toggle behavior
      const toggle = () => {
        const isCollapsed = wrapper.classList.toggle('chapter-collapsed');
        headerDiv.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
      };

      headerDiv.addEventListener('click', toggle);
      headerDiv.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          toggle();
        }
      });
    });

    // 8. Global Expand / Collapse All
    const toggleAllBtn = document.getElementById('btn-toggle-all-chapters');
    const toggleAllIcon = document.getElementById('toggle-all-icon');
    const toggleAllText = document.getElementById('toggle-all-text');
    let allExpanded = true;

    if (toggleAllBtn) {
      toggleAllBtn.addEventListener('click', () => {
        allExpanded = !allExpanded;
        const wrappers = memoBody.querySelectorAll('.chapter-container');
        wrappers.forEach((w) => {
          if (allExpanded) {
            w.classList.remove('chapter-collapsed');
          } else {
            w.classList.add('chapter-collapsed');
          }
        });
        if (toggleAllIcon) toggleAllIcon.textContent = allExpanded ? '⊟' : '⊞';
        if (toggleAllText) toggleAllText.textContent = allExpanded ? 'Collapse All' : 'Expand All';
      });
    }

    // 9. Chapter Navigation Chips (Jump & Auto-Unroll)
    const tocChips = document.querySelectorAll('.toc-chip');
    tocChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const targetId = chip.getAttribute('data-target');
        if (!targetId) return;

        const targetWrapper = document.getElementById(`wrapper-${targetId}`);
        if (targetWrapper) {
          // Unroll if collapsed
          targetWrapper.classList.remove('chapter-collapsed');
          targetWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });

          // Visual highlight pulse
          targetWrapper.classList.add('ring-2', 'ring-emerald-400');
          setTimeout(() => {
            targetWrapper.classList.remove('ring-2', 'ring-emerald-400');
          }, 1500);
        }
      });
    });

    // 10. In-Document Keyword Search with Counter
    const searchInput = document.getElementById('memo-search-input') as HTMLInputElement | null;
    const searchCount = document.getElementById('memo-search-count');

    if (searchInput) {
      let timeoutId: any;
      searchInput.addEventListener('input', () => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => {
          const query = searchInput.value.trim().toLowerCase();
          
          // Clear previous highlights
          memoBody.querySelectorAll('mark.search-highlight').forEach((mark) => {
            const parent = mark.parentNode;
            if (parent) {
              parent.replaceChild(document.createTextNode(mark.textContent || ''), mark);
              parent.normalize();
            }
          });

          if (!query || query.length < 2) {
            searchCount?.classList.add('hidden');
            return;
          }

          let matchCount = 0;
          const walkAndHighlight = (node: Node) => {
            if (node.nodeType === Node.TEXT_NODE) {
              const textVal = node.textContent || '';
              const lower = textVal.toLowerCase();
              const idx = lower.indexOf(query);
              if (idx !== -1) {
                matchCount++;
                const mark = document.createElement('mark');
                mark.className = 'search-highlight';
                const matchText = textVal.substring(idx, idx + query.length);
                mark.textContent = matchText;

                const afterText = textVal.substring(idx + query.length);
                const beforeText = textVal.substring(0, idx);

                const parent = node.parentNode;
                if (parent) {
                  if (beforeText) parent.insertBefore(document.createTextNode(beforeText), node);
                  parent.insertBefore(mark, node);
                  if (afterText) parent.insertBefore(document.createTextNode(afterText), node);
                  parent.removeChild(node);

                  // Ensure parent chapter is unrolled
                  const chapWrapper = mark.closest('.chapter-container');
                  if (chapWrapper) chapWrapper.classList.remove('chapter-collapsed');
                }
              }
            } else if (node.nodeType === Node.ELEMENT_NODE && !['SCRIPT', 'STYLE', 'BUTTON', 'INPUT'].includes((node as Element).tagName)) {
              Array.from(node.childNodes).forEach(walkAndHighlight);
            }
          };

          walkAndHighlight(memoBody);

          if (searchCount) {
            searchCount.textContent = `${matchCount} found`;
            searchCount.classList.remove('hidden');
          }
        }, 250);
      });
    }
  }

  // Run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInstitutionalSummary);
  } else {
    initInstitutionalSummary();
  }
</script>
