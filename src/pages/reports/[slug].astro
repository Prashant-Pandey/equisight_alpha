          <span class="text-xs text-slate-400 group-hover:text-white transition-colors">&rarr;</span>
        </a>

        <!-- LinkedIn -->
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(reportUrl)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-3.5 rounded-xl bg-[#0A66C2]/15 hover:bg-[#0A66C2]/25 border border-[#0A66C2]/40 hover:border-[#0A66C2] transition-all group flex items-center justify-between shadow-sm"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#0A66C2]/20 flex items-center justify-center text-[#0A66C2] shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold text-white group-hover:text-blue-400 transition-colors">LinkedIn Network</div>
              <div class="text-[10px] text-slate-400">Institutional Feed</div>
            </div>
          </div>
          <span class="text-xs text-slate-400 group-hover:text-white transition-colors">&rarr;</span>
        </a>

        <!-- StockTwits -->
        <a
          href={`https://stocktwits.com/symbol/${report.ticker}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-3.5 rounded-xl bg-emerald-950/40 hover:bg-emerald-900/60 border border-emerald-500/40 hover:border-emerald-400 transition-all group flex items-center justify-between shadow-sm"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-emerald-900/60 flex items-center justify-center text-emerald-300 shrink-0 font-bold font-mono text-xs group-hover:scale-105 transition-transform">
              $ST
            </div>
            <div>
              <div class="text-xs font-bold text-white group-hover:text-emerald-400 transition-colors">${report.ticker} Stream</div>
              <div class="text-[10px] text-slate-400">Real-time Retail Stream</div>
            </div>
          </div>
          <span class="text-xs text-slate-400 group-hover:text-white transition-colors">&rarr;</span>
        </a>

        <!-- Copy Direct URL -->
        <button
          type="button"
          class="copy-report-link-btn p-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 hover:border-slate-500 transition-all group flex items-center justify-between shadow-sm cursor-pointer text-left"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-slate-700 flex items-center justify-center text-slate-200 shrink-0 group-hover:scale-105 transition-transform">
              <svg class="w-4 h-4 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
            </div>
