---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import FinancialMetricsTable from '../../components/FinancialMetricsTable.astro';
import ComplianceDisclaimer from '../../components/ComplianceDisclaimer.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import AdSlot from '../../components/AdSlot.astro';
import { path } from '../../utils/paths';
import { resolveThesisSource } from '../../utils/thesisSource';
import { formatPriceTimestamp } from '../../utils/formatters';
import { getConsensusVerdict, getConsensusVerdictColor, getStarRatingString } from '../../utils/financialClassification';

const { entry } = Astro.props;

// Render markdown content safely across Astro versions
let ContentComponent;
try {
  if (typeof (entry as any).render === 'function') {
    const rendered = await (entry as any).render();
    ContentComponent = rendered.Content;
  } else {
    const rendered = await render(entry);
    ContentComponent = rendered.Content;
  }
} catch (e) {
  const rendered = await render(entry);
  ContentComponent = rendered.Content;
}

const report = entry.data;
const isPositive = report.movePercent >= 0;
const primaryAffiliate = report.affiliates?.[0];

// Fetch contextual related research for SEO internal linking
const allReports = await getCollection('reports');
const relatedReports = allReports
  .filter((r) => r.slug !== entry.slug)
  .filter((r) => r.data.sector === report.sector || r.data.category === report.category)
  .slice(0, 3);

if (relatedReports.length < 3) {
  const fallbackFillers = allReports
    .filter((r) => r.slug !== entry.slug && !relatedReports.some((rel) => rel.slug === r.slug))
    .slice(0, 3 - relatedReports.length);
  relatedReports.push(...fallbackFillers);
}

const publishDateIso = typeof report.publishDate === 'string' ? report.publishDate : report.publishDate.toISOString();
const formattedDate = new Date(report.publishDate).toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const priceDisplayLabel = formatPriceTimestamp(report.publishDate, report.priceTimestamp);

const reportUrl = new URL(Astro.url.pathname, Astro.site || 'https://equisight-alpha.com').href;
const xShareText = report.socialHooks?.twitter?.[0] || `${report.companyName} ($${report.ticker}) ${isPositive ? 'surged' : 'dropped'} ${isPositive ? '+' : ''}${report.movePercent.toFixed(1)}% today. Read our institutional fundamental research deep dive:`;
const redditShareTitle = report.socialHooks?.redditTitle || report.title;
const telegramShareText = report.socialHooks?.telegram || `🚨 $${report.ticker} Research: ${report.title}`;

const bullTheses = (report.theses?.bull && report.theses.bull.length > 0) ? report.theses.bull : [];
const bearTheses = (report.theses?.bear && report.theses.bear.length > 0) ? report.theses.bear : [];

// Company Deep Dive Texts
const companyMakesMoney = report.companyDeepDive?.howCompanyMakesMoney ||
  `${report.companyName} generates enterprise revenue through commercial deployment of its specialized ${report.sector.toLowerCase()} products and services within the ${report.industry} market. Its financial model relies on long-term institutional contracts, volume-based client transactions, recurring software or maintenance subscriptions, and professional service engagements, ensuring predictable recurring baseline revenues.`;

const demandAndWhy = report.companyDeepDive?.productsDemandAndWhy ||
  `Demand for ${report.companyName}'s offerings is driven by non-discretionary operational requirements, regulatory compliance mandates, and mission-critical workflows across enterprise clients. Customers adopt ${report.ticker}'s solutions because alternative substitutes present prohibitive switching friction, high integration costs, and operational disruption risks.`;

const pastPerformance = report.companyDeepDive?.pastPerformanceSummary ||
  `Over the past multi-year operational cycle, ${report.companyName} has maintained consistent revenue progression and disciplined capital stewardship. The company has navigated supply chain volatility and macroeconomic rate cycles by optimizing operating expense structures, maintaining positive unit economics, and defending gross margins against input cost pressures.`;

const growthOutlook = report.companyDeepDive?.growthAndProfitabilityOutlook ||
  `Management's medium-term roadmap focuses on expanding operating margins through operational leverage, international or cross-vertical penetration, and high-margin product tier adoption. Continued reinvestment of discretionary free cash flow into proprietary technological enhancements positions the business for durable compound earnings growth.`;

// Industry Deep Dive Texts
const industryCondition = report.industryDeepDive?.industryCondition ||
  `The ${report.industry} sector is undergoing a structural transformation characterized by digital automation, supply chain recalibration, and heightened institutional focus on capital efficiency. Tier-1 players with superior scale and robust balance sheets continue to consolidate share at the expense of marginal competitors.`;

const obstaclesAndChallenges = report.industryDeepDive?.obstaclesAndChallenges ||
  `Primary structural headwinds confronting the sector include sticky wage inflation, procurement cycles experiencing heightened budgetary scrutiny, elevated borrowing costs for debt-dependent expansion, and intermittent regulatory compliance overhead across international jurisdictions.`;

const politicalCulturalRisks = report.industryDeepDive?.economicPoliticalCulturalRisks ||
  `Broader macroeconomic and geopolitical vulnerabilities encompass interest rate volatility, evolving cross-border trade tariffs, antitrust and data privacy scrutiny, and corporate sustainability requirements that necessitate ongoing capital expenditures to maintain regulatory standing.`;

// Valuation Models Data
const P = report.currentPrice || 10;

function getValuationDetails(val: number | null | undefined, p: number) {
  if (val === null || val === undefined || isNaN(val)) {
    return { val: null, upside: null, isPositive: false, status: 'N/A' };
  }
  const upside = Number((((val - p) / p) * 100).toFixed(1));
  const isPositive = upside >= 0;
  const status = upside > 10 ? 'Undervalued' : upside < -5 ? 'Overvalued' : 'Fair Value';
  return { val, upside, isPositive, status };
}

const dcf = getValuationDetails(report.valuationModels?.dcf?.intrinsicValue, P);
const isDDMApplicable = (report.valuationModels?.ddm?.applicable !== undefined) ? report.valuationModels.ddm.applicable : (report.dividendYield > 0);
const ddm = getValuationDetails(isDDMApplicable ? report.valuationModels?.ddm?.intrinsicValue : null, P);
const rel = getValuationDetails(report.valuationModels?.relativeValuation?.intrinsicValue, P);
const rapid = getValuationDetails(report.valuationModels?.rapidStockValuation?.intrinsicValue, P);
const rim = getValuationDetails(report.valuationModels?.residualIncomeModel?.intrinsicValue, P);
const asset = getValuationDetails(report.valuationModels?.assetBasedValuation?.netAssetValue, P);
const excess = getValuationDetails(report.valuationModels?.excessReturnModel?.intrinsicValue, P);

let industryModelName = "Sector EV/EBITDA Multiplier";
if (report.sector === "Technology") industryModelName = "ARR Multiplier & Rule-of-40 Valuation";
else if (report.sector === "Financial Services") industryModelName = "Tangible Book Value (P/TBV) Model";
else if (report.sector === "Healthcare") industryModelName = "Risk-Adjusted Pipeline NPV (rNPV)";
else if (report.sector === "Consumer Discretionary") industryModelName = "Mid-Cycle Operating Multiple";

const ind = getValuationDetails(report.valuationModels?.industrySpecificModel?.intrinsicValue, P);

const validVals = [dcf.val, rel.val, rapid.val, rim.val, asset.val, excess.val, ind.val, ddm.val].filter((v): v is number => v !== null && !isNaN(v));
const consensusFairValue = report.valuationModels?.consensusFairValue ?? (validVals.length > 0 ? Number((validVals.reduce((a, b) => a + b, 0) / validVals.length).toFixed(2)) : null);
const consensusUpside = consensusFairValue !== null ? Number((((consensusFairValue - P) / P) * 100).toFixed(1)) : null;
const isConsensusPositive = consensusUpside !== null ? consensusUpside >= 0 : false;

const consensusVerdict = getConsensusVerdict(report.valuationModels?.verdict, consensusUpside);
const consensusVerdictColor = getConsensusVerdictColor(consensusVerdict);
const consensusTargetColor = consensusFairValue !== null ? (isConsensusPositive ? 'text-emerald-400' : 'text-rose-400') : 'text-slate-400';

const starRating = report.starRating || report.morningstarRating?.starRating || null;
const starRatingString = getStarRatingString(
  report.starRatingString || report.morningstarRating?.starRatingString,
  starRating
);
const uncertaintyRating = report.uncertaintyRating || report.morningstarRating?.uncertaintyRating || 'Medium';
const fiveStarPrice = report.fiveStarPrice || report.morningstarRating?.fiveStarPrice || null;
const oneStarPrice = report.oneStarPrice || report.morningstarRating?.oneStarPrice || null;

const valuationRows = [
  {
    name: '3-Stage Discounted Cash Flow (Moat Fade)',
    assumptions: report.valuationModels?.dcf?.fadeYears
      ? `3-Stage Fade (${report.valuationModels.dcf.fadeYears}Y), Stage 1 Growth ${report.valuationModels.dcf.stage1GrowthRate ?? 5}%, Ke/WACC ${report.valuationModels.dcf.discountRate ?? 8}%, Normalized FCFF $${report.valuationModels.dcf.normalizedFcf ? (report.valuationModels.dcf.normalizedFcf / 1e9).toFixed(2) + 'B' : 'N/A'}`
      : 'WACC 9.2%, Terminal Growth 2.5%, 5Y Free Cash Flow Projections',
    intrinsicValue: dcf.val !== null ? `$${dcf.val.toFixed(2)}` : 'N/A',
    upside: dcf.upside !== null ? `${dcf.upside >= 0 ? '+' : ''}${dcf.upside}%` : 'N/A',
    isPositive: dcf.isPositive,
    status: dcf.status
  },
  {
    name: 'Dividend Discount Model (DDM)',
    assumptions: isDDMApplicable ? `Cost of Equity 9.8%, Dividend Growth Rate 4.0%` : 'Zero Dividend Policy (Not Applicable)',
    intrinsicValue: ddm.val !== null ? `$${ddm.val.toFixed(2)}` : 'N/A',
    upside: ddm.upside !== null ? `${ddm.upside >= 0 ? '+' : ''}${ddm.upside}%` : 'N/A',
    isPositive: ddm.isPositive,
    status: isDDMApplicable ? ddm.status : 'N/A'
  },
  {
    name: 'Relative Valuation (Peer Multiples)',
    assumptions: `Sector Peer Median P/E (${report.peRatio ? Math.round(report.peRatio * 0.95) : 22}x) & EV/EBITDA`,
    intrinsicValue: rel.val !== null ? `$${rel.val.toFixed(2)}` : 'N/A',
    upside: rel.upside !== null ? `${rel.upside >= 0 ? '+' : ''}${rel.upside}%` : 'N/A',
    isPositive: rel.isPositive,
    status: rel.status
  },
  {
    name: 'Rapid Stock Valuation (Benjamin Graham)',
    assumptions: 'Normalized EPS × (8.5 + 2g) with 10Y Treasury Baseline Adjustment',
    intrinsicValue: rapid.val !== null ? `$${rapid.val.toFixed(2)}` : 'N/A',
    upside: rapid.upside !== null ? `${rapid.upside >= 0 ? '+' : ''}${rapid.upside}%` : 'N/A',
    isPositive: rapid.isPositive,
    status: rapid.status
  },
  {
    name: 'Residual Income Model (RIM)',
    assumptions: 'Book Value + PV of Residual Income above Cost of Equity',
    intrinsicValue: rim.val !== null ? `$${rim.val.toFixed(2)}` : 'N/A',
    upside: rim.upside !== null ? `${rim.upside >= 0 ? '+' : ''}${rim.upside}%` : 'N/A',
    isPositive: rim.isPositive,
    status: rim.status
  },
  {
    name: 'Asset-Based Valuation (Tangible NAV)',
    assumptions: 'Tangible Liquidation Floor & Net Adjusted Asset Value',
    intrinsicValue: asset.val !== null ? `$${asset.val.toFixed(2)}` : 'N/A',
    upside: asset.upside !== null ? `${asset.upside >= 0 ? '+' : ''}${asset.upside}%` : 'N/A',
    isPositive: asset.isPositive,
    status: asset.val !== null ? 'Asset Floor' : 'N/A'
  },
  {
    name: 'Excess Return Model (EVA)',
    assumptions: 'Economic Value Added spread between ROIC and WACC capital charge',
    intrinsicValue: excess.val !== null ? `$${excess.val.toFixed(2)}` : 'N/A',
    upside: excess.upside !== null ? `${excess.upside >= 0 ? '+' : ''}${excess.upside}%` : 'N/A',
    isPositive: excess.isPositive,
    status: excess.status
  },
  {
    name: industryModelName,
    assumptions: `Sector specific valuation metrics for ${report.sector}`,
    intrinsicValue: ind.val !== null ? `$${ind.val.toFixed(2)}` : 'N/A',
    upside: ind.upside !== null ? `${ind.upside >= 0 ? '+' : ''}${ind.upside}%` : 'N/A',
    isPositive: ind.isPositive,
    status: ind.status
  }
];
---

<BaseLayout
  title={report.title}
  description={report.description}
  ogType="article"
  publishDate={publishDateIso}
  ticker={report.ticker}
  companyName={report.companyName}
  sector={report.sector}
  keywords={report.keywords}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb Bar -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 font-mono" aria-label="Breadcrumbs">
      <a href={path('/')} class="hover:text-emerald-400 transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href={path('/reports')} class="hover:text-emerald-400 transition-colors">Reports</a>
      <span>&rsaquo;</span>
      <a href={path(`/tickers/${report.ticker.toLowerCase()}`)} class="hover:text-emerald-400 transition-colors">${report.ticker}</a>
      <span>&rsaquo;</span>
      <span class="text-slate-200 truncate">{report.companyName}</span>
    </nav>

    <!-- Top Notice Banner -->
    <ComplianceDisclaimer variant="banner" />

    <!-- Article Header -->
    <header class="my-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <a
          href={path(`/tickers/${report.ticker.toLowerCase()}`)}
          class="font-mono font-black text-lg px-2.5 py-0.5 rounded-lg bg-emerald-950 text-emerald-400 border border-emerald-500/40 hover:bg-emerald-900 transition-colors"
          title={`View full ${report.companyName} research hub`}
        >
          ${report.ticker}
        </a>
        <span class="text-xs font-mono uppercase bg-slate-800 text-slate-300 px-2 py-0.5 rounded">
          {report.exchange} &bull; {report.region}
        </span>
        <span class="text-xs text-slate-400 font-medium">
          {report.sector}
        </span>
        <span class="text-slate-400">&bull;</span>
        <time datetime={publishDateIso} class="text-xs text-slate-400 font-mono">{formattedDate}</time>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug">
        {report.title}
      </h1>

      <!-- Executive Price Callout: "Price on <date and time and zone>" -->
      <div class="mt-6 p-4 sm:p-5 rounded-xl border border-slate-800 bg-slate-900/70 flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="text-[11px] uppercase tracking-wider text-slate-400 font-mono font-semibold">
            {priceDisplayLabel}
          </div>
          <div class="text-2xl sm:text-3xl font-black text-white font-mono mt-0.5">
            ${report.currentPrice.toFixed(2)} <span class="text-xs text-slate-400 font-normal">{report.currency}</span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class={`text-right px-4 py-2 rounded-lg border font-mono ${isPositive ? 'bg-emerald-950/80 border-emerald-500/30 text-emerald-400' : 'bg-rose-950/80 border-rose-500/30 text-rose-400'}`}>
            <div class="text-[10px] uppercase font-sans tracking-wide">Daily Move</div>
            <div class="text-lg font-black">{isPositive ? '+' : ''}{report.movePercent.toFixed(2)}%</div>
          </div>
        </div>
      </div>
    </header>

    <!-- Social Distribution Quick Action Bar -->
    <div class="my-6 p-3.5 sm:p-4 rounded-xl border border-slate-700 bg-slate-900/90 shadow-md flex flex-wrap items-center justify-between gap-3" id="social-distribution-top">
      <div class="flex items-center gap-2">
        <span class="flex h-2.5 w-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-wider text-white">Social Distribution</span>
        <span class="text-xs text-slate-400 hidden sm:inline">&bull; Syndicate Research</span>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <!-- X / Twitter -->
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(xShareText)}&url=${encodeURIComponent(reportUrl)}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-black hover:bg-slate-900 text-white border border-slate-700 hover:border-slate-500 text-xs font-semibold transition-all shadow-sm"
          title="Share research thread on X (Twitter)"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>Share on X</span>
        </a>

        <!-- Reddit -->
        <a
          href={`https://www.reddit.com/submit?url=${encodeURIComponent(reportUrl)}&title=${encodeURIComponent(redditShareTitle)}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#FF4500]/20 hover:bg-[#FF4500]/30 text-orange-300 hover:text-white border border-[#FF4500]/50 hover:border-[#FF4500] text-xs font-semibold transition-all shadow-sm"
          title="Submit deep dive to Reddit r/stocks"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.609a1.246 1.246 0 0 1 1.108-.693zM9.5 13.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm5 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/></svg>
          <span>Reddit DD</span>
        </a>

        <!-- Telegram -->
        <a
          href={`https://t.me/share/url?url=${encodeURIComponent(reportUrl)}&text=${encodeURIComponent(telegramShareText)}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#229ED9]/20 hover:bg-[#229ED9]/30 text-sky-300 hover:text-white border border-[#229ED9]/50 hover:border-[#229ED9] text-xs font-semibold transition-all shadow-sm"
          title="Broadcast research alert on Telegram"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.121l-6.87 4.326-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.458c.535-.194 1.006.128.832.923z"/></svg>
          <span>Telegram</span>
        </a>

        <!-- LinkedIn -->
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(reportUrl)}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#0A66C2]/20 hover:bg-[#0A66C2]/30 text-blue-300 hover:text-white border border-[#0A66C2]/50 hover:border-[#0A66C2] text-xs font-semibold transition-all shadow-sm"
          title="Publish report to LinkedIn"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          <span>LinkedIn</span>
        </a>

        <!-- StockTwits -->
        <a
          href={`https://stocktwits.com/symbol/${report.ticker}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-emerald-950/60 hover:bg-emerald-900/80 text-emerald-300 hover:text-white border border-emerald-500/50 hover:border-emerald-400 text-xs font-semibold transition-all shadow-sm"
          title={`View $${report.ticker} stream on StockTwits`}
        >
          <span class="font-bold font-mono text-[11px]">$ST</span>
          <span>${report.ticker}</span>
        </a>

        <!-- Copy Link Button -->
        <button
          type="button"
          class="copy-report-link-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-slate-600 text-xs font-semibold transition-all shadow-sm cursor-pointer"
          title="Copy research URL to clipboard"
        >
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
          <span class="copy-btn-label">Copy URL</span>
        </button>
      </div>
    </div>

    <!-- Top Programmatic Ad Slot -->
    {report.adSlots.topBanner && (
      <AdSlot slotId="report-top-ad" format="horizontal" minHeight="120px" />
    )}

    <!-- Comprehensive Stock Analytics Component (Fundamentals, Debt, P/B & P/E Charts, 8-Q EPS, Moat, Venue, Inflation) -->
    <FinancialMetricsTable report={report} />

    <!-- Bull & Bear Theses Section with Interactive Info Modal -->
    <section class="my-10 p-5 sm:p-6 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-lg">
      <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-6 border-b border-slate-800">
        <div>
          <h2 class="text-lg font-extrabold text-white tracking-tight flex items-center gap-2">
            <span>Investment Theses: Bull vs. Bear Scenarios</span>
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Key operational catalysts, structural tailwinds, and asymmetric downside risk vectors. Click <span class="text-sky-400 font-mono font-bold">ℹ️</span> to view citations and analytical deduction chains.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-400 bg-slate-800 px-2.5 py-1 rounded-md border border-slate-700">
          Interactive Research Citations
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Bull Theses Column -->
        <div class="space-y-3">
          <div class="flex items-center gap-2 text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider pb-1 border-b border-emerald-900/60">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
