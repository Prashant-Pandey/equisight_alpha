---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import QuickViewDashboard from '../../components/report/QuickViewDashboard.astro';
import UnifiedCommandBar from '../../components/report/UnifiedCommandBar.astro';
import ValuationFootballField from '../../components/report/ValuationFootballField.astro';
import DcfSensitivitySandbox from '../../components/report/DcfSensitivitySandbox.astro';
import AnalysisSidebarToC from '../../components/report/AnalysisSidebarToC.astro';
import ThesisModule from '../../components/report/ThesisModule.astro';
import ValuationModule from '../../components/report/ValuationModule.astro';
import SolvencyModule from '../../components/report/SolvencyModule.astro';
import MicrostructureModule from '../../components/report/MicrostructureModule.astro';
import ComplianceDisclaimer from '../../components/ComplianceDisclaimer.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import AdSlot from '../../components/AdSlot.astro';
import { path } from '../../utils/paths';
import { formatPriceTimestamp } from '../../utils/formatters';

const { entry } = Astro.props;

// Render markdown content safely across Astro versions
let ContentComponent;
try {
  if (typeof (entry as any).render === 'function') {
    const rendered = await (entry as any).render();
    ContentComponent = rendered.Content;
  } else {
    const rendered = await render(entry);
    ContentComponent = rendered.Content;
  }
} catch (e) {
  const rendered = await render(entry);
  ContentComponent = rendered.Content;
}

const report = entry.data;
const isPositive = report.movePercent >= 0;
const primaryAffiliate = report.affiliates?.[0];

// Fetch contextual related research for SEO internal linking
const allReports = await getCollection('reports');
const relatedReports = allReports
  .filter((r) => r.slug !== entry.slug)
  .filter((r) => r.data.sector === report.sector || r.data.category === report.category)
  .slice(0, 3);

if (relatedReports.length < 3) {
  const fallbackFillers = allReports
    .filter((r) => r.slug !== entry.slug && !relatedReports.some((rel) => rel.slug === r.slug))
    .slice(0, 3 - relatedReports.length);
  relatedReports.push(...fallbackFillers);
}

const publishDateIso = typeof report.publishDate === 'string' ? report.publishDate : report.publishDate.toISOString();
const formattedDate = new Date(report.publishDate).toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const priceDisplayLabel = formatPriceTimestamp(report.publishDate, report.priceTimestamp);
const reportUrl = new URL(Astro.url.pathname, Astro.site || 'https://equisight-alpha.com').href;
const printUrl = path(`/reports/${entry.slug}/print`);
const xShareText = report.socialHooks?.twitter?.[0] || `${report.companyName} ($${report.ticker}) ${isPositive ? 'surged' : 'dropped'} ${isPositive ? '+' : ''}${report.movePercent.toFixed(1)}% today. Read our institutional fundamental research deep dive:`;
const redditShareTitle = report.socialHooks?.redditTitle || report.title;
const telegramShareText = report.socialHooks?.telegram || `🚨 $${report.ticker} Research: ${report.title}`;

// Company Deep Dive Texts
const companyMakesMoney = report.companyDeepDive?.howCompanyMakesMoney ||
  `${report.companyName} generates enterprise revenue through commercial deployment of its specialized ${report.sector.toLowerCase()} products and services within the ${report.industry} market. Its financial model relies on long-term institutional contracts, volume-based client transactions, recurring software or maintenance subscriptions, and professional service engagements.`;

function parseBulletSection(text: string) {
  if (!text) return { intro: '', bullets: [], outro: '' };
  const clean = text.replace(/^Title:\s*How Does .* Make Money\??\s*\n+/i, '').trim();
  const lines = clean.split('\n');
  const bulletLines: string[] = [];
  const introLines: string[] = [];
  const outroLines: string[] = [];
  let foundFirstBullet = false;

  for (const line of lines) {
    const trimmed = line.trim();
    if (trimmed.startsWith('- ') || trimmed.startsWith('* ') || trimmed.startsWith('• ')) {
      foundFirstBullet = true;
      bulletLines.push(trimmed.replace(/^[-*•]\s*/, '').trim());
    } else if (!foundFirstBullet) {
      if (introLines.length > 0 || trimmed) {
        introLines.push(line);
      }
    } else {
      if (outroLines.length > 0 || trimmed) {
        outroLines.push(line);
      }
    }
  }

  if (bulletLines.length === 0) {
    return { intro: clean, bullets: [], outro: '' };
  }

  return {
    intro: introLines.join('\n').trim(),
    bullets: bulletLines,
    outro: outroLines.join('\n').trim()
  };
}

function parseSegmentBullet(bullet: string) {
  // Looks for "Segment Name. Details..." or "**Segment Name**: Details..." or "Segment Name: Details..."
  const clean = bullet.trim();
  const boldMatch = clean.match(/^\*\*([^*]+)\*\*[:.]?\s*(.*)$/s);
  if (boldMatch) {
    return { pill: boldMatch[1].trim(), text: boldMatch[2].trim() };
  }
  const bracketMatch = clean.match(/^\[([^\]]+)\][:.-]?\s*(.*)$/s);
  if (bracketMatch) {
    return { pill: bracketMatch[1].trim(), text: bracketMatch[2].trim() };
  }
  const colonMatch = clean.match(/^([A-Za-z0-9&/,'’().\s-]{2,55}?):\s+(.*)$/s);
  if (colonMatch) {
    return { pill: colonMatch[1].trim(), text: colonMatch[2].trim() };
  }
  const dotMatch = clean.match(/^([A-Za-z0-9&/,'’().\s-]{2,55}?)\.\s+(.*)$/s);
  if (dotMatch && !dotMatch[1].includes(':')) {
    return { pill: dotMatch[1].trim(), text: dotMatch[2].trim() };
  }
  return { pill: '', text: clean };
}

function parseGenericBulletSection(text: string, defaultIntro: string, defaultBullets: string[], defaultOutro: string) {
  if (!text) {
    return { intro: defaultIntro, bullets: defaultBullets, outro: defaultOutro };
  }
  const parsed = parseBulletSection(text);
  if (parsed.bullets.length > 0) {
    return {
      intro: parsed.intro || defaultIntro,
      bullets: parsed.bullets,
      outro: parsed.outro || defaultOutro
    };
  }
  // If no bullets in text, split into sentences
  const sentences = text.split(/(?<=[.?!])\s+/).map((s) => s.trim()).filter(Boolean);
  if (sentences.length > 1) {
    return {
      intro: sentences[0],
      bullets: sentences.slice(1),
      outro: defaultOutro
    };
  }
  return {
    intro: text,
    bullets: defaultBullets,
    outro: defaultOutro
  };
}

const parsedMakesMoney = parseBulletSection(companyMakesMoney);

// Default backups with company-specific parameters
const defaultDemandIntro = `Demand for ${report.companyName}'s commercial offerings is anchored in mission-critical operational workflows across the ${report.industry} sector.`;
const defaultDemandBullets = [
  `**Mission-Critical Utility**: Enterprise clients deploy ${report.ticker}'s offerings into essential daily operations where downtime or substitution imposes severe operational drag.`,
  `**High Switching Friction**: Embedded integration across enterprise software, specialized hardware, or proprietary specifications creates substantial client retention lock-in.`,
  `**Secular Industry Adoption**: Structural end-market modernization across ${report.sector} continues to drive baseline procurement volume across core product lines.`
];
const defaultDemandOutro = `Core product integration and non-discretionary utility protect ${report.companyName}'s baseline revenue streams across cyclical sector pullbacks.`;

const parsedDemand = parseGenericBulletSection(
  report.companyDeepDive?.productsDemandAndWhy,
  defaultDemandIntro,
  defaultDemandBullets,
  defaultDemandOutro
);

const debtToEquityStr = report.debtToEquity !== null && report.debtToEquity !== undefined ? `${Number(report.debtToEquity).toFixed(2)}x` : 'N/A';
const totalDebtStr = report.totalDebt ? `$${(report.totalDebt / 1e9).toFixed(2)}B` : '0M';
const marketCapStr = report.marketCap ? `$${(report.marketCap / 1e9).toFixed(2)}B` : 'N/A';

const defaultPerfIntro = `${report.companyName} demonstrates disciplined execution across historical operational and financial reporting cycles:`;
const defaultPerfBullets = [
  `**Scale & Market Presence**: Operates within the **${report.sector}** sector (${report.industry}) with an equity market capitalization of **${marketCapStr}**.`,
  `**Capital Structure & Solvency**: Operates with a debt-to-equity ratio of **${debtToEquityStr}** and total debt obligations of **${totalDebtStr}**.`,
  `**Cash Flow & Resource Allocation**: Disciplined reinvestment into core capabilities while safeguarding balance sheet liquidity and unit economics.`
];
const defaultPerfOutro = `Historical balance sheet discipline provides ${report.companyName} with the solvency headroom required to fund strategic initiatives without dilutive financing.`;

const parsedPerf = parseGenericBulletSection(
  report.companyDeepDive?.pastPerformanceSummary,
  defaultPerfIntro,
  defaultPerfBullets,
  defaultPerfOutro
);

const defaultGrowthIntro = `${report.companyName}'s medium-term roadmap focuses on margin-accretive expansion and disciplined capital stewardship:`;
const defaultGrowthBullets = [
  `**Commercial Expansion**: Accelerating market penetration across high-margin product tiers within **${report.industry}** to drive incremental top-line growth.`,
  `**Operating Leverage**: Scaling fixed platform overhead to expand core operating efficiency and margin resilience over multi-year cycles.`,
  `**Economic Value Creation**: Reinvesting free cash flow into selective capacity expansion and R&D while defending returns on invested capital.`
];
const defaultGrowthOutro = `Execution along this multi-year roadmap positions ${report.companyName} to compound operating cash flows and reinforce competitive barriers.`;

const parsedGrowth = parseGenericBulletSection(
  report.companyDeepDive?.growthAndProfitabilityOutlook,
  defaultGrowthIntro,
  defaultGrowthBullets,
  defaultGrowthOutro
);

// Industry Deep Dive Parsing (Layman + Technical separation)
function parseIndustryItem(text: string, defaultLayman = '', defaultTechnical = '') {
  if (!text) {
    return { layman: defaultLayman || 'Not Available', technical: defaultTechnical || 'Not Available' };
  }
  const clean = text.trim();
  // Check if text has explicit layman / technical tags
  const laymanMatch = clean.match(/(?:layman(?:\s*summary)?|overview):\s*([^\n]+)/i);
  const techMatch = clean.match(/(?:technical(?:\s*details)?|deep-dive|context):\s*([\s\S]+)/i);
  if (laymanMatch && techMatch) {
    return {
      layman: laymanMatch[1].trim(),
      technical: techMatch[1].trim()
    };
  }
  // Otherwise, split by first sentence: sentence 1 is layman, full text is technical
  const sentences = clean.split(/(?<=[.?!])\s+/);
  if (sentences.length >= 2) {
    return {
      layman: sentences[0].trim(),
      technical: clean
    };
  }
  return {
    layman: defaultLayman || clean,
    technical: defaultTechnical || clean
  };
}

const rawIndCondition = report.industryDeepDive?.industryCondition || '';
const simplifiedIndCondition = report.industryDeepDive?.macroConditionSimplified
  || (report as any).macroConditionSimplified
  || '';

// Use simplified non-technical Macro Condition generated by LLM for layman view,
// while retaining technical Macro Condition (rawIndCondition) for institutional deep-dive view.
// Misleading static defaults have been removed.
const parsedIndCondition = simplifiedIndCondition
  ? { layman: simplifiedIndCondition, technical: rawIndCondition || simplifiedIndCondition }
  : parseIndustryItem(rawIndCondition);

const rawObstacles = report.industryDeepDive?.obstaclesAndChallenges || '';
const parsedObstacles = parseIndustryItem(rawObstacles);

const rawRisks = report.industryDeepDive?.economicPoliticalCulturalRisks || '';
const parsedRisks = parseIndustryItem(rawRisks);

const keyTakeaways = report.executiveSummaryData?.keyTakeaways || [
  `Market Reaction: ${report.companyName} ($${report.ticker}) closed ${isPositive ? '+' : ''}${report.movePercent.toFixed(1)}% at $${report.currentPrice.toFixed(2)}.`,
  `Intrinsic Valuation: Consensus Fair Value sits at $${report.valuationModels?.consensusFairValue ? report.valuationModels.consensusFairValue.toFixed(2) : 'N/A'}.`,
  `Balance Sheet: Total debt of $${report.totalDebt ? (report.totalDebt / 1e9).toFixed(2) + 'B' : '0M'} against current liquidity.`
];
---

<BaseLayout
  title={report.title}
  description={report.description}
  ogType="article"
  publishDate={publishDateIso}
  ticker={report.ticker}
  companyName={report.companyName}
  sector={report.sector}
  keywords={report.keywords}
>
  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Breadcrumb Bar -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-4 font-mono no-print" aria-label="Breadcrumbs">
      <a href={path('/')} class="hover:text-emerald-400 transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href={path('/reports')} class="hover:text-emerald-400 transition-colors">Reports</a>
      <span>&rsaquo;</span>
      <a href={path(`/tickers/${report.ticker.toLowerCase()}`)} class="hover:text-emerald-400 transition-colors">${report.ticker}</a>
      <span>&rsaquo;</span>
      <span class="text-slate-200 truncate">{report.companyName}</span>
    </nav>

    <!-- Top Notice Banner -->
    <ComplianceDisclaimer variant="banner" />

    <!-- [TIER 1] UNIFIED COMMAND BAR (Eliminating double-sticky clutter) -->
    <UnifiedCommandBar
      report={report}
      printUrl={printUrl}
      formattedDate={formattedDate}
      publishDateIso={publishDateIso}
      priceDisplayLabel={priceDisplayLabel}
      defaultTab="overview"
    />

    <!-- [TIER 1] 5-SECOND EXECUTIVE TRIAGE DASHBOARD -->
    <QuickViewDashboard report={report} />

    <!-- Top Programmatic Ad Slot -->
    {report.adSlots?.topBanner && (
      <div class="my-4 no-print">
        <AdSlot slotId="report-top-ad" format="horizontal" minHeight="100px" />
      </div>
    )}

    <!-- ==================== TAB PANELS CONTAINER ==================== -->

    <!-- TAB PANEL 1: OVERVIEW & OUTLOOK (70/30 Desk Workstation Layout) -->
    <div id="tab-panel-overview" class="report-tab-panel my-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- LEFT 70% RAIL (Main Analyst Deep-Dive) -->
        <div class="lg:col-span-8 space-y-8">
          
          <!-- Executive Summary & Key Takeaways Card -->
          <section class="p-5 sm:p-6 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-lg space-y-4" id="sec-executive-summary">
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
              <h2 class="text-lg font-extrabold text-white tracking-tight flex items-center gap-2">
                <span>Executive Summary & Strategic Takeaways</span>
              </h2>
              <span class="text-xs font-mono text-emerald-400 bg-emerald-950/80 border border-emerald-500/30 px-2.5 py-0.5 rounded-full">
                Analyst Consensus
              </span>
            </div>

            <!-- Catalyst Headline Box -->
            {report.executiveSummaryData?.catalystHeadline && (
              <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 text-xs sm:text-sm text-slate-200 leading-relaxed font-medium">
                <span class="text-sky-400 font-mono font-bold uppercase text-[11px] block mb-1">Session Driver:</span>
                "{report.executiveSummaryData.catalystHeadline}"
              </div>
            )}

            <!-- Bullet Takeaways -->
            <div class="space-y-2.5">
              <div class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">
                Core Analytical Findings:
              </div>
              <ul class="space-y-2">
                {keyTakeaways.map((item: string, idx: number) => (
                  <li class="flex items-start gap-2.5 text-xs text-slate-300 leading-relaxed p-2.5 rounded-lg bg-slate-950/40 border border-slate-800/80">
                    <span class="font-mono text-emerald-400 font-bold shrink-0 mt-0.5">0{idx + 1}.</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </section>

          <!-- [TIER 2] INSTITUTIONAL VALUATION FOOTBALL FIELD CHART -->
          <ValuationFootballField report={report} />

          <!-- [TIER 3] INTERACTIVE DCF SENSITIVITY SANDBOX -->
          <DcfSensitivitySandbox report={report} />

          <!-- Company Research Deep Dive: 4 Key Core Questions -->
          <section class="p-5 sm:p-6 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-lg space-y-4" id="sec-business-model">
            <div class="pb-3 border-b border-slate-800">
              <h2 class="text-lg font-extrabold text-white tracking-tight">
                Company Research Deep-Dive: Core Business Architecture
              </h2>
              <p class="text-xs text-slate-400 mt-0.5">
                Fundamental dissection of monetization, resilient demand drivers, execution history, and operating roadmap.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Question 1: How Does Company Make Money? -->
              <div class="col-span-1 md:col-span-2 p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 flex flex-col justify-between space-y-3">
                <div class="space-y-2">
                  <div class="text-xs font-mono font-bold text-emerald-400 flex items-center gap-1.5 uppercase">
                    <span>01</span> &bull; <span>How Does {report.companyName} Make Money?</span>
                  </div>
                  {parsedMakesMoney.intro && (
                    <p class="text-xs text-slate-300 leading-relaxed font-medium">
                      {parsedMakesMoney.intro}
                    </p>
                  )}
                  {parsedMakesMoney.bullets.length > 0 && (
                    <ul class="space-y-3.5 my-2.5 pl-0">
                      {parsedMakesMoney.bullets.map((bullet) => {
                        const parsed = parseSegmentBullet(bullet);
                        const subPoints = parsed.text
                          ? parsed.text.split(/(?<=[.?!])\s+/).map((s) => s.trim()).filter(Boolean)
                          : [];
                        return (
                          <li class="text-xs text-slate-300 leading-relaxed flex flex-col gap-1.5">
                            {parsed.pill ? (
                              <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-950/90 text-emerald-300 border border-emerald-700/70 tracking-wide uppercase shadow-sm">
                                  {parsed.pill}
                                </span>
                              </div>
                            ) : null}
                            {subPoints.length > 0 ? (
                              <ul class="space-y-1 pl-2 border-l border-emerald-800/40 ml-1">
                                {subPoints.map((subPoint) => (
                                  <li class="text-xs text-slate-300 leading-relaxed flex items-start gap-1.5">
                                    <span class="text-emerald-400 font-bold shrink-0 mt-0.5">&ndash;</span>
                                    <span set:html={subPoint.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>')} />
                                  </li>
                                ))}
                              </ul>
                            ) : (
                              <div class="flex items-start gap-2">
                                <span class="text-emerald-400 font-bold shrink-0 mt-0.5">&bull;</span>
                                <span set:html={bullet.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>')} />
                              </div>
                            )}
                          </li>
                        );
                      })}
                    </ul>
                  )}
                </div>
                {parsedMakesMoney.outro && (
                  <div class="pt-2.5 border-t border-slate-800/70">
                    <p class="text-[11px] text-slate-400 italic leading-relaxed">
                      <span class="text-emerald-400 font-mono font-semibold not-italic">Strategic Takeaway: </span>
                      {parsedMakesMoney.outro}
                    </p>
                  </div>
                )}
              </div>

              <!-- Question 2: Core Products & Resilient Demand Rationale -->
              <div class="col-span-1 p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 flex flex-col justify-between space-y-3">
                <div class="space-y-2">
                  <div class="text-xs font-mono font-bold text-sky-400 flex items-center gap-1.5 uppercase">
                    <span>02</span> &bull; <span>Core Products & Resilient Demand Rationale</span>
                  </div>
                  {parsedDemand.intro && (
                    <p class="text-xs text-slate-300 leading-relaxed font-medium">
                      {parsedDemand.intro}
                    </p>
                  )}
                  {parsedDemand.bullets.length > 0 && (
                    <ul class="space-y-2 my-2.5 pl-0.5">
                      {parsedDemand.bullets.map((bullet) => (
                        <li class="text-xs text-slate-300 leading-relaxed flex items-start gap-2">
                          <span class="text-sky-400 font-bold shrink-0 mt-0.5">&bull;</span>
                          <span set:html={bullet.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>')} />
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                {parsedDemand.outro && (
                  <div class="pt-2.5 border-t border-slate-800/70">
                    <p class="text-[11px] text-slate-400 italic leading-relaxed">
                      <span class="text-sky-400 font-mono font-semibold not-italic">Demand Floor: </span>
                      {parsedDemand.outro}
                    </p>
                  </div>
                )}
              </div>

              <!-- Question 3: Historical Operational & Financial Performance -->
              <div class="col-span-1 p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 flex flex-col justify-between space-y-3">
                <div class="space-y-2">
                  <div class="text-xs font-mono font-bold text-amber-400 flex items-center gap-1.5 uppercase">
                    <span>03</span> &bull; <span>Historical Operational & Financial Performance</span>
                  </div>
                  {parsedPerf.intro && (
                    <p class="text-xs text-slate-300 leading-relaxed font-medium">
                      {parsedPerf.intro}
                    </p>
                  )}
                  {parsedPerf.bullets.length > 0 && (
                    <ul class="space-y-2 my-2.5 pl-0.5">
                      {parsedPerf.bullets.map((bullet) => (
                        <li class="text-xs text-slate-300 leading-relaxed flex items-start gap-2">
                          <span class="text-amber-400 font-bold shrink-0 mt-0.5">&bull;</span>
                          <span set:html={bullet.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>')} />
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                {parsedPerf.outro && (
                  <div class="pt-2.5 border-t border-slate-800/70">
                    <p class="text-[11px] text-slate-400 italic leading-relaxed">
                      <span class="text-amber-400 font-mono font-semibold not-italic">Operating Resilience: </span>
                      {parsedPerf.outro}
                    </p>
                  </div>
                )}
              </div>

              <!-- Question 4: Medium-Term Growth & Profitability Roadmap -->
              <div class="col-span-1 md:col-span-2 p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 flex flex-col justify-between space-y-3">
                <div class="space-y-2">
                  <div class="text-xs font-mono font-bold text-indigo-400 flex items-center gap-1.5 uppercase">
                    <span>04</span> &bull; <span>Medium-Term Growth & Profitability Roadmap</span>
                  </div>
                  {parsedGrowth.intro && (
                    <p class="text-xs text-slate-300 leading-relaxed font-medium">
                      {parsedGrowth.intro}
                    </p>
                  )}
                  {parsedGrowth.bullets.length > 0 && (
                    <ul class="space-y-2 my-2.5 pl-0.5">
                      {parsedGrowth.bullets.map((bullet) => (
                        <li class="text-xs text-slate-300 leading-relaxed flex items-start gap-2">
                          <span class="text-indigo-400 font-bold shrink-0 mt-0.5">&bull;</span>
                          <span set:html={bullet.replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-semibold">$1</strong>')} />
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                {parsedGrowth.outro && (
                  <div class="pt-2.5 border-t border-slate-800/70">
                    <p class="text-[11px] text-slate-400 italic leading-relaxed">
                      <span class="text-indigo-400 font-mono font-semibold not-italic">Execution Target: </span>
                      {parsedGrowth.outro}
                    </p>
                  </div>
                )}
              </div>
            </div>
          </section>

          <!-- Industry Research Deep Dive: 3 Key Sector Questions -->
          <section class="p-5 sm:p-6 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-lg space-y-4" id="sec-industry-dynamics">
            <div class="pb-3 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h2 class="text-lg font-extrabold text-white tracking-tight flex items-center gap-2">
                  <span>Industry Research Deep-Dive: Sector Dynamics & Headwinds</span>
