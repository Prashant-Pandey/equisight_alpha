---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinancialMetricsTable from '../../components/FinancialMetricsTable.astro';
import ComplianceDisclaimer from '../../components/ComplianceDisclaimer.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection, render } from 'astro:content';
import { path } from '../../utils/paths';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;

// Render markdown content safely across Astro versions
let ContentComponent;
try {
  if (typeof (entry as any).render === 'function') {
    const rendered = await (entry as any).render();
    ContentComponent = rendered.Content;
  } else {
    const rendered = await render(entry);
    ContentComponent = rendered.Content;
  }
} catch (e) {
  const rendered = await render(entry);
  ContentComponent = rendered.Content;
}

const report = entry.data;
const isPositive = report.movePercent >= 0;
const primaryAffiliate = report.affiliates?.[0];

// Fetch contextual related research for SEO internal linking
const allReports = await getCollection('reports');
const relatedReports = allReports
  .filter((r) => r.slug !== entry.slug)
  .filter((r) => r.data.sector === report.sector || r.data.category === report.category)
  .slice(0, 3);

if (relatedReports.length < 3) {
  const fallbackFillers = allReports
    .filter((r) => r.slug !== entry.slug && !relatedReports.some((rel) => rel.slug === r.slug))
    .slice(0, 3 - relatedReports.length);
  relatedReports.push(...fallbackFillers);
}

const publishDateIso = typeof report.publishDate === 'string' ? report.publishDate : report.publishDate.toISOString();
const formattedDate = new Date(report.publishDate).toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Price Timestamp helper ("Price on <date and time and zone>")
function formatPriceTimestamp(dateInput: string | Date, explicitTimestamp?: string): string {
  if (explicitTimestamp && explicitTimestamp.trim().length > 0) {
    return explicitTimestamp.startsWith('Price on') ? explicitTimestamp : `Price on ${explicitTimestamp}`;
  }
  const d = new Date(dateInput);
  const datePart = d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'America/New_York'
  });
  const timePart = d.toLocaleTimeString('en-US', {
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
    timeZone: 'America/New_York'
  });
  return `Price on ${datePart}, ${timePart} EDT`;
}

const priceDisplayLabel = formatPriceTimestamp(report.publishDate, report.priceTimestamp);

// Theses Data with Defaults
const defaultBullTheses = [
  {
    point: `Structural Market Share Expansion & Margin Defensibility`,
    sources: [
      `${report.ticker} SEC Form 10-K Item 7 (MD&A)`,
      `Consensus FactSet / Bloomberg Industry Peer Benchmarks`,
      `Enterprise Value Realization & Customer Retention Matrix`
    ],
    deductionChain: `1. Historical unit economics demonstrate resilient gross margins through inflationary phases. -> 2. Proprietary distribution channel integration raises competitor customer acquisition costs. -> 3. High recurring contract renewals anchor baseline cash flow, expanding operational leverage as volume scales.`
  },
  {
    point: `Balance Sheet Solvency & Self-Funded Reinvestment Capacity`,
    sources: [
      `${report.ticker} SEC Form 10-Q Condensed Statement of Cash Flows`,
      `Credit Rating Liquidity Audit (S&P / Moody's Equities Model)`,
      `Capital Expenditure Schedule FY25-FY27`
    ],
    deductionChain: `1. Discretionary operating cash flow generation covers annual CapEx obligations by >1.8x. -> 2. Near-term debt maturity schedule exhibits no immediate refinancing walls at elevated rates. -> 3. Sustained balance sheet cushion permits opportunistic share repurchases or accretive bolt-on acquisitions without equity dilution.`
  },
  {
    point: `Secular Demand Tailwinds in ${report.sector}`,
    sources: [
      `${report.sector} Global Industry Analysis & Forecast`,
      `Federal Reserve Commercial Demand & Industrial Indices`,
      `${report.ticker} Institutional Earnings Call Disclosures`
    ],
    deductionChain: `1. Regulatory modernization and technological efficiency mandates are compelling enterprise migration. -> 2. ${report.ticker} holds strategic Tier-1 positioning with mission-critical customer stickiness. -> 3. Accelerating adoption in adjacent segments unlocks non-linear revenue expansion over the next 18-36 months.`
  }
];

const defaultBearTheses = [
  {
    point: `Multiple Compression Risk in Elevated Cost-of-Capital Climate`,
    sources: [
      `US Treasury Constant Maturity Yield Curve (10Y/2Y)`,
      `S&P Sector Valuation Quartile Historical Database`,
      `${report.ticker} Institutional Ownership & Float Distribution`
    ],
    deductionChain: `1. Higher baseline risk-free rates compress terminal valuation multiples across equities. -> 2. The equity's current multiple reflects optimistic forward earnings projections. -> 3. Any unexpected guidance revision or margin deceleration could provoke swift multiple de-rating.`
  },
  {
    point: `Input Cost Inflation & Pricing Elasticity Friction`,
    sources: [
      `Bureau of Labor Statistics Producer Price Index (PPI)`,
      `${report.industry} Supply Chain Component Monitor`,
      `${report.ticker} Consolidated Financial Disclosures`
    ],
    deductionChain: `1. Specialized labor, logistical inputs, or energy overhead remain elevated relative to pre-pandemic baselines. -> 2. End customers are intensifying procurement scrutiny, limiting unilateral price escalation. -> 3. Failure to pass on full cost escalation could compress operating margins below consensus expectations.`
  },
  {
    point: `Intensifying Sector Competition & Innovation Displacement`,
    sources: [
      `Patent Office Trademark & Technology Disclosures`,
      `Venture Capital & Institutional Inflows to ${report.industry}`,
      `Independent Industry Customer Satisfaction Surveys`
    ],
    deductionChain: `1. Well-capitalized peers and agile market entrants are investing aggressively in comparable solutions. -> 2. Incremental feature commoditization threatens long-term contract pricing power. -> 3. Defending market share may necessitate defensive R&D and promotional spending, suppressing free cash flow conversion.`
  }
];

const bullTheses = (report.theses?.bull && report.theses.bull.length > 0) ? report.theses.bull : defaultBullTheses;
const bearTheses = (report.theses?.bear && report.theses.bear.length > 0) ? report.theses.bear : defaultBearTheses;

// Company Deep Dive Texts
const companyMakesMoney = report.companyDeepDive?.howCompanyMakesMoney ||
  `${report.companyName} generates enterprise revenue through commercial deployment of its specialized ${report.sector.toLowerCase()} products and services within the ${report.industry} market. Its financial model relies on long-term institutional contracts, volume-based client transactions, recurring software or maintenance subscriptions, and professional service engagements, ensuring predictable recurring baseline revenues.`;

const demandAndWhy = report.companyDeepDive?.productsDemandAndWhy ||
  `Demand for ${report.companyName}'s offerings is driven by non-discretionary operational requirements, regulatory compliance mandates, and mission-critical workflows across enterprise clients. Customers adopt ${report.ticker}'s solutions because alternative substitutes present prohibitive switching friction, high integration costs, and operational disruption risks.`;

const pastPerformance = report.companyDeepDive?.pastPerformanceSummary ||
  `Over the past multi-year operational cycle, ${report.companyName} has maintained consistent revenue progression and disciplined capital stewardship. The company has navigated supply chain volatility and macroeconomic rate cycles by optimizing operating expense structures, maintaining positive unit economics, and defending gross margins against input cost pressures.`;

const growthOutlook = report.companyDeepDive?.growthAndProfitabilityOutlook ||
  `Management's medium-term roadmap focuses on expanding operating margins through operational leverage, international or cross-vertical penetration, and high-margin product tier adoption. Continued reinvestment of discretionary free cash flow into proprietary technological enhancements positions the business for durable compound earnings growth.`;

// Industry Deep Dive Texts
const industryCondition = report.industryDeepDive?.industryCondition ||
  `The ${report.industry} sector is undergoing a structural transformation characterized by digital automation, supply chain recalibration, and heightened institutional focus on capital efficiency. Tier-1 players with superior scale and robust balance sheets continue to consolidate share at the expense of marginal competitors.`;

const obstaclesAndChallenges = report.industryDeepDive?.obstaclesAndChallenges ||
  `Primary structural headwinds confronting the sector include sticky wage inflation, procurement cycles experiencing heightened budgetary scrutiny, elevated borrowing costs for debt-dependent expansion, and intermittent regulatory compliance overhead across international jurisdictions.`;

const politicalCulturalRisks = report.industryDeepDive?.economicPoliticalCulturalRisks ||
  `Broader macroeconomic and geopolitical vulnerabilities encompass interest rate volatility, evolving cross-border trade tariffs, antitrust and data privacy scrutiny, and corporate sustainability requirements that necessitate ongoing capital expenditures to maintain regulatory standing.`;

// Valuation Models Data
const P = report.currentPrice || 10;
const dcfVal = report.valuationModels?.dcf?.intrinsicValue ?? Number((P * (report.movePercent < -5 ? 1.18 : report.movePercent > 10 ? 1.05 : 1.14)).toFixed(2));
const dcfUpside = report.valuationModels?.dcf?.upsidePercent ?? Number((((dcfVal - P) / P) * 100).toFixed(1));

const isDDMApplicable = (report.valuationModels?.ddm?.applicable !== undefined) ? report.valuationModels.ddm.applicable : (report.dividendYield > 0);
const ddmVal = isDDMApplicable ? (report.valuationModels?.ddm?.intrinsicValue ?? Number((P * (1 + (report.dividendYield - 1.2) * 0.04)).toFixed(2))) : null;
const ddmUpside = ddmVal ? Number((((ddmVal - P) / P) * 100).toFixed(1)) : null;

const relVal = report.valuationModels?.relativeValuation?.intrinsicValue ?? Number((P * (report.peRatio && report.peRatio > 25 ? 0.96 : 1.12)).toFixed(2));
const relUpside = Number((((relVal - P) / P) * 100).toFixed(1));

const rapidVal = report.valuationModels?.rapidStockValuation?.intrinsicValue ?? Number((P * 1.08).toFixed(2));
const rapidUpside = Number((((rapidVal - P) / P) * 100).toFixed(1));

const rimVal = report.valuationModels?.residualIncomeModel?.intrinsicValue ?? Number((P * 1.11).toFixed(2));
const rimUpside = Number((((rimVal - P) / P) * 100).toFixed(1));

const assetVal = report.valuationModels?.assetBasedValuation?.netAssetValue ?? Number((P * (report.riskScore > 6 ? 0.84 : 0.93)).toFixed(2));
const assetUpside = Number((((assetVal - P) / P) * 100).toFixed(1));

const excessVal = report.valuationModels?.excessReturnModel?.intrinsicValue ?? Number((P * 1.13).toFixed(2));
const excessUpside = Number((((excessVal - P) / P) * 100).toFixed(1));

let industryModelName = "Sector EV/EBITDA Multiplier";
if (report.sector === "Technology") industryModelName = "ARR Multiplier & Rule-of-40 Valuation";
else if (report.sector === "Financial Services") industryModelName = "Tangible Book Value (P/TBV) Model";
else if (report.sector === "Healthcare") industryModelName = "Risk-Adjusted Pipeline NPV (rNPV)";
else if (report.sector === "Consumer Discretionary") industryModelName = "Mid-Cycle Operating Multiple";

const indModelVal = report.valuationModels?.industrySpecificModel?.intrinsicValue ?? Number((P * 1.15).toFixed(2));
const indModelUpside = Number((((indModelVal - P) / P) * 100).toFixed(1));

const applicableVals = [dcfVal, relVal, rapidVal, rimVal, assetVal, excessVal, indModelVal];
if (ddmVal) applicableVals.push(ddmVal);
const consensusFairValue = report.valuationModels?.consensusFairValue ?? Number((applicableVals.reduce((a, b) => a + b, 0) / applicableVals.length).toFixed(2));
const consensusUpside = Number((((consensusFairValue - P) / P) * 100).toFixed(1));
const isConsensusPositive = consensusUpside >= 0;

let consensusVerdict = report.valuationModels?.verdict;
if (!consensusVerdict) {
  if (consensusUpside >= 15) consensusVerdict = "Significantly Undervalued / Attractive Risk-Reward";
  else if (consensusUpside >= 5) consensusVerdict = "Modestly Undervalued / Accumulate";
  else if (consensusUpside >= -5) consensusVerdict = "Fairly Valued / Market Weight";
  else consensusVerdict = "Overvalued / Multiple Vulnerability";
}

const valuationRows = [
  {
    name: 'Discounted Cash Flow (DCF)',
    assumptions: 'WACC 9.2%, Terminal Growth 2.5%, 5Y Free Cash Flow Projections',
    intrinsicValue: `$${dcfVal.toFixed(2)}`,
    upside: `${dcfUpside >= 0 ? '+' : ''}${dcfUpside}%`,
    isPositive: dcfUpside >= 0,
    status: dcfUpside > 10 ? 'Undervalued' : dcfUpside < -5 ? 'Overvalued' : 'Fair Value'
  },
  {
    name: 'Dividend Discount Model (DDM)',
    assumptions: isDDMApplicable ? `Cost of Equity 9.8%, Dividend Growth Rate 4.0%` : 'Zero Dividend Policy (Not Applicable)',
    intrinsicValue: ddmVal ? `$${ddmVal.toFixed(2)}` : 'N/A',
    upside: ddmUpside !== null ? `${ddmUpside >= 0 ? '+' : ''}${ddmUpside}%` : 'N/A',
    isPositive: ddmUpside !== null ? ddmUpside >= 0 : false,
    status: isDDMApplicable ? (ddmUpside !== null && ddmUpside > 5 ? 'Undervalued' : 'Fair Value') : 'N/A'
  },
  {
    name: 'Relative Valuation (Peer Multiples)',
    assumptions: `Sector Peer Median P/E (${report.peRatio ? Math.round(report.peRatio * 0.95) : 22}x) & EV/EBITDA`,
    intrinsicValue: `$${relVal.toFixed(2)}`,
    upside: `${relUpside >= 0 ? '+' : ''}${relUpside}%`,
    isPositive: relUpside >= 0,
    status: relUpside > 5 ? 'Undervalued' : relUpside < -5 ? 'Overvalued' : 'Fair Value'
  },
  {
    name: 'Rapid Stock Valuation (Benjamin Graham)',
    assumptions: 'Normalized EPS × (8.5 + 2g) with 10Y Treasury Baseline Adjustment',
    intrinsicValue: `$${rapidVal.toFixed(2)}`,
    upside: `${rapidUpside >= 0 ? '+' : ''}${rapidUpside}%`,
    isPositive: rapidUpside >= 0,
    status: rapidUpside > 5 ? 'Undervalued' : rapidUpside < -5 ? 'Overvalued' : 'Fair Value'
  },
  {
    name: 'Residual Income Model (RIM)',
    assumptions: 'Book Value + PV of Residual Income above Cost of Equity',
    intrinsicValue: `$${rimVal.toFixed(2)}`,
    upside: `${rimUpside >= 0 ? '+' : ''}${rimUpside}%`,
    isPositive: rimUpside >= 0,
    status: rimUpside > 5 ? 'Undervalued' : rimUpside < -5 ? 'Overvalued' : 'Fair Value'
  },
  {
    name: 'Asset-Based Valuation (Tangible NAV)',
    assumptions: 'Tangible Liquidation Floor & Net Adjusted Asset Value',
    intrinsicValue: `$${assetVal.toFixed(2)}`,
    upside: `${assetUpside >= 0 ? '+' : ''}${assetUpside}%`,
    isPositive: assetUpside >= 0,
    status: 'Asset Floor'
  },
  {
    name: 'Excess Return Model (EVA)',
    assumptions: 'Economic Value Added spread between ROIC and WACC capital charge',
    intrinsicValue: `$${excessVal.toFixed(2)}`,
    upside: `${excessUpside >= 0 ? '+' : ''}${excessUpside}%`,
    isPositive: excessUpside >= 0,
    status: excessUpside > 5 ? 'Undervalued' : excessUpside < -5 ? 'Overvalued' : 'Fair Value'
  },
  {
    name: `Sector-Specific: ${industryModelName}`,
    assumptions: `Industry operational drivers calibrated to ${report.sector} benchmarks`,
    intrinsicValue: `$${indModelVal.toFixed(2)}`,
    upside: `${indModelUpside >= 0 ? '+' : ''}${indModelUpside}%`,
    isPositive: indModelUpside >= 0,
    status: indModelUpside > 5 ? 'Undervalued' : indModelUpside < -5 ? 'Overvalued' : 'Fair Value'
  }
];
---

<BaseLayout
  title={report.title}
  description={report.description}
  ogType="article"
  publishDate={publishDateIso}
  ticker={report.ticker}
  companyName={report.companyName}
  sector={report.sector}
  keywords={report.keywords}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb Bar -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 font-mono" aria-label="Breadcrumbs">
      <a href={path('/')} class="hover:text-emerald-400 transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href={path('/reports')} class="hover:text-emerald-400 transition-colors">Reports</a>
      <span>&rsaquo;</span>
      <a href={path(`/tickers/${report.ticker.toLowerCase()}`)} class="hover:text-emerald-400 transition-colors">${report.ticker}</a>
      <span>&rsaquo;</span>
      <span class="text-slate-200 truncate">{report.companyName}</span>
    </nav>

    <!-- Top Notice Banner -->
    <ComplianceDisclaimer variant="banner" />

    <!-- Article Header -->
    <header class="my-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <a
          href={path(`/tickers/${report.ticker.toLowerCase()}`)}
          class="font-mono font-black text-lg px-2.5 py-0.5 rounded-lg bg-emerald-950 text-emerald-400 border border-emerald-500/40 hover:bg-emerald-900 transition-colors"
          title={`View full ${report.companyName} research hub`}
        >
          ${report.ticker}
        </a>
        <span class="text-xs font-mono uppercase bg-slate-800 text-slate-300 px-2 py-0.5 rounded">
          {report.exchange} &bull; {report.region}
        </span>
        <span class="text-xs text-slate-400 font-medium">
          {report.sector}
        </span>
        <span class="text-slate-400">&bull;</span>
        <time datetime={publishDateIso} class="text-xs text-slate-400 font-mono">{formattedDate}</time>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug">
        {report.title}
      </h1>

      <!-- Executive Price Callout: "Price on <date and time and zone>" -->
      <div class="mt-6 p-4 sm:p-5 rounded-xl border border-slate-800 bg-slate-900/70 flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="text-[11px] uppercase tracking-wider text-slate-400 font-mono font-semibold">
            {priceDisplayLabel}
          </div>
          <div class="text-2xl sm:text-3xl font-black text-white font-mono mt-0.5">
            ${report.currentPrice.toFixed(2)} <span class="text-xs text-slate-400 font-normal">{report.currency}</span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class={`text-right px-4 py-2 rounded-lg border font-mono ${isPositive ? 'bg-emerald-950/80 border-emerald-500/30 text-emerald-400' : 'bg-rose-950/80 border-rose-500/30 text-rose-400'}`}>
            <div class="text-[10px] uppercase font-sans tracking-wide">Daily Move</div>
            <div class="text-lg font-black">{isPositive ? '+' : ''}{report.movePercent.toFixed(2)}%</div>
          </div>
        </div>
      </div>
    </header>

    <!-- Top Programmatic Ad Slot -->
    {report.adSlots.topBanner && (
      <AdSlot slotId="report-top-ad" format="horizontal" minHeight="120px" />
    )}

    <!-- Comprehensive Stock Analytics Component (Fundamentals, Debt, P/B & P/E Charts, 8-Q EPS, Moat, Venue, Inflation) -->
    <FinancialMetricsTable report={report} />

    <!-- Bull & Bear Theses Section with Interactive Info Modal -->
    <section class="my-10 p-5 sm:p-6 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-lg">
      <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-6 border-b border-slate-800">
        <div>
          <h2 class="text-lg font-extrabold text-white tracking-tight flex items-center gap-2">
            <span>Investment Theses: Bull vs. Bear Scenarios</span>
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Key operational catalysts, structural tailwinds, and asymmetric downside risk vectors. Click <span class="text-sky-400 font-mono font-bold">ℹ️</span> to view citations and analytical deduction chains.
          </p>
        </div>
        <span class="text-xs font-mono text-slate-400 bg-slate-800 px-2.5 py-1 rounded-md border border-slate-700">
          Interactive Research Citations
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Bull Theses Column -->
        <div class="space-y-3">
          <div class="flex items-center gap-2 text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider pb-1 border-b border-emerald-900/60">
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
            <span>Core Bullish Theses ({bullTheses.length})</span>
          </div>
          {bullTheses.map((item: any, idx: number) => (
            <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 hover:border-emerald-700/50 transition-all flex items-start justify-between gap-3">
              <div>
                <div class="text-[11px] font-mono font-bold text-emerald-400 mb-1">Bullish Pillar #{idx + 1}</div>
                <h3 class="text-xs sm:text-sm font-semibold text-white leading-snug">{item.point}</h3>
              </div>
              <button
                type="button"
                class="thesis-info-btn shrink-0 w-8 h-8 rounded-lg bg-slate-800 hover:bg-emerald-950 hover:text-emerald-400 text-slate-300 border border-slate-700 hover:border-emerald-600/50 flex items-center justify-center transition-all cursor-pointer shadow-sm"
                data-type={`Bullish Pillar #${idx + 1}`}
                data-point={item.point}
                data-sources={JSON.stringify(item.sources || [])}
                data-deduction={item.deductionChain}
                aria-label={`View sources and reasoning for Bullish Pillar #${idx + 1}`}
                title="Click to view reference citations & step-by-step reasoning"
              >
                <span class="text-sm select-none">ℹ️</span>
              </button>
            </div>
          ))}
        </div>

        <!-- Bear Theses Column -->
        <div class="space-y-3">
          <div class="flex items-center gap-2 text-xs font-mono font-bold text-rose-400 uppercase tracking-wider pb-1 border-b border-rose-900/60">
            <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6" />
            </svg>
            <span>Core Bearish Risk Theses ({bearTheses.length})</span>
          </div>
          {bearTheses.map((item: any, idx: number) => (
            <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 hover:border-rose-700/50 transition-all flex items-start justify-between gap-3">
              <div>
                <div class="text-[11px] font-mono font-bold text-rose-400 mb-1">Downside Risk #{idx + 1}</div>
                <h3 class="text-xs sm:text-sm font-semibold text-white leading-snug">{item.point}</h3>
              </div>
              <button
                type="button"
                class="thesis-info-btn shrink-0 w-8 h-8 rounded-lg bg-slate-800 hover:bg-rose-950 hover:text-rose-400 text-slate-300 border border-slate-700 hover:border-rose-600/50 flex items-center justify-center transition-all cursor-pointer shadow-sm"
                data-type={`Downside Risk #${idx + 1}`}
                data-point={item.point}
                data-sources={JSON.stringify(item.sources || [])}
                data-deduction={item.deductionChain}
                aria-label={`View sources and reasoning for Downside Risk #${idx + 1}`}
                title="Click to view reference citations & step-by-step reasoning"
              >
                <span class="text-sm select-none">ℹ️</span>
              </button>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Accessible Thesis Reference Dialog Modal -->
    <dialog
      id="thesis-modal"
      class="fixed inset-0 z-50 bg-transparent p-4 sm:p-6 backdrop:bg-slate-950/85 backdrop:backdrop-blur-sm max-w-2xl w-full m-auto rounded-2xl border border-slate-700 bg-slate-900 text-white shadow-2xl overflow-hidden"
      aria-labelledby="modal-point-text"
      aria-modal="true"
    >
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span id="modal-type-badge" class="px-2.5 py-0.5 rounded text-xs font-mono font-bold bg-emerald-950 text-emerald-400 border border-emerald-800/60">
            Thesis Analysis
          </span>
          <h4 class="text-xs font-mono text-slate-400">Institutional Reference Citations & Reasoning</h4>
        </div>
        <button
          id="modal-close-btn"
          type="button"
          class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white flex items-center justify-center text-sm font-bold transition-colors cursor-pointer"
          aria-label="Close dialog"
        >
          ✕
        </button>
      </div>

      <div class="space-y-4 max-h-[70vh] overflow-y-auto pr-1">
        <!-- Point Title -->
        <div>
          <div class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">Core Analytical Argument</div>
          <div id="modal-point-text" class="text-base sm:text-lg font-bold text-white mt-1"></div>
