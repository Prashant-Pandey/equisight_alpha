      <!-- Pre-Drafted Social Hooks Preview Box -->
      {report.socialHooks?.twitter && report.socialHooks.twitter.length > 0 && (
        <details class="group mt-4 rounded-xl border border-slate-800 bg-slate-950/60 p-4 transition-all">
          <summary class="flex items-center justify-between cursor-pointer text-xs font-semibold text-slate-300 hover:text-white">
            <div class="flex items-center gap-2">
              <span class="font-mono text-emerald-400">🧵</span>
              <span>View Pre-Composed Twitter / X Thread ({report.socialHooks.twitter.length} Tweets)</span>
            </div>
            <span class="text-slate-400 group-open:rotate-180 transition-transform">&darr;</span>
          </summary>
          <div class="mt-4 space-y-3 pt-3 border-t border-slate-800/80">
            {report.socialHooks.twitter.map((tweet: string) => (
              <div class="p-3 rounded-lg bg-slate-900 border border-slate-800 text-xs text-slate-300 font-sans leading-relaxed flex items-start justify-between gap-3">
                <span class="flex-1">{tweet}</span>
                <button
                  type="button"
                  class="copy-raw-text-btn shrink-0 px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 text-[10px] font-mono text-slate-300 hover:text-white border border-slate-700 transition-colors cursor-pointer"
                  data-raw={tweet}
                >
                  Copy
                </button>
              </div>
            ))}
