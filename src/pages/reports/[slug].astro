    <!-- Main Markdown Body (Typography-styled) -->
    <div class="prose prose-invert prose-emerald max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-emerald-400 hover:prose-a:text-emerald-300 prose-table:border prose-table:border-slate-800 prose-th:bg-slate-900 prose-th:p-3 prose-td:p-3 prose-td:border prose-td:border-slate-800">
      <ContentComponent />
    </div>

    <!-- Permanent Ticker Hub Cross-Link Callout -->
    <div class="my-8 p-4 rounded-xl border border-slate-800 bg-slate-900/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h4 class="text-sm font-bold text-white">Tracking ${report.ticker} ({report.companyName})?</h4>
        <p class="text-xs text-slate-400 mt-0.5">Explore the historical coverage hub with multi-quarter valuation trends and solvency stress tests.</p>
      </div>
