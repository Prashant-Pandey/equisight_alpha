  /* Make markdown tables horizontally scrollable on mobile/smaller screens */
  :global(.prose table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    white-space: nowrap;
    -webkit-overflow-scrolling: touch;
  }
</style>

<script>
  function setupGlobalShortcuts() {
    // Keyboard shortcut for exporting institutional PDF
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'p') {
        const btn = document.getElementById('export-pdf-action-btn') as HTMLAnchorElement | null;
        if (btn && btn.href) {
          e.preventDefault();
          window.open(btn.href, '_blank');
        }
      }
    });

    // Copy report URL handler
    document.querySelectorAll<HTMLElement>('.copy-report-link-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const label = btn.querySelector('.copy-btn-label');
          if (label) {
            const orig = label.textContent;
            label.textContent = 'Copied!';
            setTimeout(() => { label.textContent = orig; }, 2000);
          }
        } catch (e) {
          console.warn('Clipboard write failed', e);
        }
      });
    });
  }

  setupGlobalShortcuts();
  document.addEventListener('astro:page-load', setupGlobalShortcuts);
</script>
