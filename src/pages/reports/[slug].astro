---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinancialMetricsTable from '../../components/FinancialMetricsTable.astro';
import ComplianceDisclaimer from '../../components/ComplianceDisclaimer.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;

// Render markdown content safely across Astro versions
let ContentComponent;
try {
  if (typeof (entry as any).render === 'function') {
    const rendered = await (entry as any).render();
    ContentComponent = rendered.Content;
  } else {
    const rendered = await render(entry);
    ContentComponent = rendered.Content;
  }
} catch (e) {
  const rendered = await render(entry);
  ContentComponent = rendered.Content;
}

const report = entry.data;
const isPositive = report.movePercent >= 0;
const primaryAffiliate = report.affiliates?.[0];
const secondaryAffiliate = report.affiliates?.[1];

const formattedDate = new Date(report.publishDate).toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout
  title={report.title}
  description={report.description}
  ogType="article"
  publishDate={typeof report.publishDate === 'string' ? report.publishDate : report.publishDate.toISOString()}
  ticker={report.ticker}
  companyName={report.companyName}
  sector={report.sector}
  keywords={report.keywords}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb Bar -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 font-mono">
      <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href="/reports" class="hover:text-emerald-400 transition-colors">Reports</a>
      <span>&rsaquo;</span>
      <a href={`/tickers/${report.ticker}`} class="hover:text-emerald-400 transition-colors">${report.ticker}</a>
      <span>&rsaquo;</span>
      <span class="text-slate-200 truncate">{report.ticker} Analysis</span>
    </nav>

    <!-- Top Notice Banner -->
    <ComplianceDisclaimer variant="banner" />

    <!-- Article Header -->
    <header class="my-8">
      <div class="flex flex-wrap items-center gap-2.5 mb-4">
        <span class="font-mono font-black text-lg px-2.5 py-0.5 rounded-lg bg-emerald-950 text-emerald-400 border border-emerald-500/40">
          ${report.ticker}
        </span>
        <span class="text-xs font-mono uppercase bg-slate-800 text-slate-300 px-2 py-0.5 rounded">
          {report.exchange} &bull; {report.region}
        </span>
        <span class="text-xs text-slate-400 font-medium">
          {report.sector}
        </span>
        <span class="text-slate-600">&bull;</span>
        <time class="text-xs text-slate-400 font-mono">{formattedDate}</time>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug">
        {report.title}
      </h1>

      <!-- Executive Price Callout -->
      <div class="mt-6 p-4 rounded-xl border border-slate-800 bg-slate-900/70 flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="text-[11px] uppercase tracking-wider text-slate-400 font-mono">Latest Market Session</div>
          <div class="text-2xl font-black text-white font-mono mt-0.5">
            ${report.currentPrice.toFixed(2)} <span class="text-xs text-slate-400 font-normal">{report.currency}</span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class={`text-right px-4 py-2 rounded-lg border font-mono ${isPositive ? 'bg-emerald-950/80 border-emerald-500/30 text-emerald-400' : 'bg-rose-950/80 border-rose-500/30 text-rose-400'}`}>
            <div class="text-[10px] uppercase font-sans tracking-wide">Daily Move</div>
            <div class="text-lg font-black">{isPositive ? '+' : ''}{report.movePercent.toFixed(2)}%</div>
          </div>
        </div>
      </div>
    </header>

    <!-- Top Programmatic Ad Slot -->
    {report.adSlots.topBanner && (
      <AdSlot slotId="report-top-ad" format="horizontal" minHeight="120px" />
    )}

    <!-- Fundamental Snapshot Component -->
    <FinancialMetricsTable
      metrics={{
        marketCap: report.marketCap,
        peRatio: report.peRatio,
        forwardPE: report.forwardPE,
        dividendYield: report.dividendYield,
        currentPrice: report.currentPrice,
        currency: report.currency,
        movePercent: report.movePercent,
        riskScore: report.riskScore
      }}
    />

    <!-- Main Markdown Body (Typography-styled) -->
    <div class="prose prose-invert prose-emerald max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-emerald-400 hover:prose-a:text-emerald-300 prose-table:border prose-table:border-slate-800 prose-th:bg-slate-900 prose-th:p-3 prose-td:p-3 prose-td:border prose-td:border-slate-800">
      <ContentComponent />
    </div>

    <!-- Contextual Affiliate Offer -->
    {primaryAffiliate && (
      <div class="my-10">
        <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-3">Contextual Market Resources</h3>
        <AffiliateBanner affiliate={primaryAffiliate} />
      </div>
    )}

    <!-- Bottom Native Ad Slot -->
    {report.adSlots.bottomBanner && (
      <AdSlot slotId="report-bottom-ad" format="rectangle" minHeight="250px" />
    )}

    <!-- Social Distribution Hooks Container -->
    <div class="my-10 p-5 rounded-xl border border-slate-800 bg-slate-900/50">
      <h3 class="text-sm font-bold text-white mb-2">Share & Distribute Research</h3>
      <p class="text-xs text-slate-400 mb-4">Export key metrics and evidence-based analysis directly to your financial network.</p>
      <div class="flex flex-wrap gap-3">
        <a
          href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(report.socialHooks?.twitter?.[0] || report.title)}&url=${encodeURIComponent(Astro.url.href)}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white transition-colors"
        >
          <span>Share Thread on X</span>
        </a>
        <a
          href={`https://www.reddit.com/submit?url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(report.title)}`}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-white transition-colors"
        >
          <span>Submit to Reddit</span>
        </a>
      </div>
    </div>

    <!-- Statutory Publisher's Exemption Footer -->
    <ComplianceDisclaimer variant="full" />
  </article>
</BaseLayout>
