              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.16.16-.295.295-.605.295l.213-3.053 5.56-5.023c.242-.213-.054-.333-.373-.121l-6.87 4.326-2.96-.924c-.643-.204-.657-.643.136-.953l11.57-4.458c.535-.194 1.006.128.832.923z"/></svg>
            </div>
            <div>
              <div class="text-xs font-bold text-white group-hover:text-sky-400 transition-colors">Telegram Alert</div>
              <div class="text-[10px] text-slate-400">Broadcast Channel Link</div>
