---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

import BaseLayout from '../../layouts/BaseLayout.astro';
import QuickViewDashboard from '../../components/report/QuickViewDashboard.astro';
import ReportTabsNav from '../../components/report/ReportTabsNav.astro';
import ThesisModule from '../../components/report/ThesisModule.astro';
import ValuationModule from '../../components/report/ValuationModule.astro';
import SolvencyModule from '../../components/report/SolvencyModule.astro';
import MicrostructureModule from '../../components/report/MicrostructureModule.astro';
import ComplianceDisclaimer from '../../components/ComplianceDisclaimer.astro';
import AffiliateBanner from '../../components/AffiliateBanner.astro';
import AdSlot from '../../components/AdSlot.astro';
import { path } from '../../utils/paths';
import { formatPriceTimestamp } from '../../utils/formatters';
import { getStarRatingString } from '../../utils/financialClassification';

const { entry } = Astro.props;

// Render markdown content safely across Astro versions
let ContentComponent;
try {
  if (typeof (entry as any).render === 'function') {
    const rendered = await (entry as any).render();
    ContentComponent = rendered.Content;
  } else {
    const rendered = await render(entry);
    ContentComponent = rendered.Content;
  }
} catch (e) {
  const rendered = await render(entry);
  ContentComponent = rendered.Content;
}

const report = entry.data;
const isPositive = report.movePercent >= 0;
const primaryAffiliate = report.affiliates?.[0];

// Fetch contextual related research for SEO internal linking
const allReports = await getCollection('reports');
const relatedReports = allReports
  .filter((r) => r.slug !== entry.slug)
  .filter((r) => r.data.sector === report.sector || r.data.category === report.category)
  .slice(0, 3);

if (relatedReports.length < 3) {
  const fallbackFillers = allReports
    .filter((r) => r.slug !== entry.slug && !relatedReports.some((rel) => rel.slug === r.slug))
    .slice(0, 3 - relatedReports.length);
  relatedReports.push(...fallbackFillers);
}

const publishDateIso = typeof report.publishDate === 'string' ? report.publishDate : report.publishDate.toISOString();
const formattedDate = new Date(report.publishDate).toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const priceDisplayLabel = formatPriceTimestamp(report.publishDate, report.priceTimestamp);

const reportUrl = new URL(Astro.url.pathname, Astro.site || 'https://equisight-alpha.com').href;
const printUrl = path(`/reports/${entry.slug}/print`);
const xShareText = report.socialHooks?.twitter?.[0] || `${report.companyName} ($${report.ticker}) ${isPositive ? 'surged' : 'dropped'} ${isPositive ? '+' : ''}${report.movePercent.toFixed(1)}% today. Read our institutional fundamental research deep dive:`;
const redditShareTitle = report.socialHooks?.redditTitle || report.title;
const telegramShareText = report.socialHooks?.telegram || `🚨 $${report.ticker} Research: ${report.title}`;

const starRating = report.starRating || report.morningstarRating?.starRating || null;
const starRatingString = getStarRatingString(
  report.starRatingString || report.morningstarRating?.starRatingString,
  starRating
);

// Company Deep Dive Texts
const companyMakesMoney = report.companyDeepDive?.howCompanyMakesMoney ||
  `${report.companyName} generates enterprise revenue through commercial deployment of its specialized ${report.sector.toLowerCase()} products and services within the ${report.industry} market. Its financial model relies on long-term institutional contracts, volume-based client transactions, recurring software or maintenance subscriptions, and professional service engagements, ensuring predictable recurring baseline revenues.`;

function parseBulletSection(text: string) {
  if (!text) return { intro: '', bullets: [], outro: '' };
  const clean = text.replace(/^Title:\s*How Does .* Make Money\??\s*\n+/i, '').trim();
  const lines = clean.split('\n');
  const bulletLines: string[] = [];
  const introLines: string[] = [];
  const outroLines: string[] = [];
  let foundFirstBullet = false;

  for (const line of lines) {
    const trimmed = line.trim();
    if (!trimmed) continue;
    if (trimmed.startsWith('- ') || trimmed.startsWith('* ') || trimmed.startsWith('• ')) {
      foundFirstBullet = true;
      bulletLines.push(trimmed.replace(/^[-*•]\s*/, '').trim());
    } else if (!foundFirstBullet) {
      introLines.push(trimmed);
    } else {
      outroLines.push(trimmed);
    }
  }

  if (bulletLines.length === 0) {
    return { intro: clean, bullets: [], outro: '' };
  }

  return {
    intro: introLines.join(' ').trim(),
    bullets: bulletLines,
    outro: outroLines.join(' ').trim()
  };
}

const parsedMakesMoney = parseBulletSection(companyMakesMoney);

const demandAndWhy = report.companyDeepDive?.productsDemandAndWhy ||
  `Demand for ${report.companyName}'s offerings is driven by non-discretionary operational requirements, regulatory compliance mandates, and mission-critical workflows across enterprise clients. Customers adopt ${report.ticker}'s solutions because alternative substitutes present prohibitive switching friction, high integration costs, and operational disruption risks.`;

const pastPerformance = report.companyDeepDive?.pastPerformanceSummary ||
  `Over the past multi-year operational cycle, ${report.companyName} has maintained consistent revenue progression and disciplined capital stewardship. The company has navigated supply chain volatility and macroeconomic rate cycles by optimizing operating expense structures, maintaining positive unit economics, and defending gross margins against input cost pressures.`;

const growthOutlook = report.companyDeepDive?.growthAndProfitabilityOutlook ||
  `Management's medium-term roadmap focuses on expanding operating margins through operational leverage, international or cross-vertical penetration, and high-margin product tier adoption. Continued reinvestment of discretionary free cash flow into proprietary technological enhancements positions the business for durable compound earnings growth.`;

// Industry Deep Dive Texts
const industryCondition = report.industryDeepDive?.industryCondition ||
  `The ${report.industry} sector is undergoing a structural transformation characterized by digital automation, supply chain recalibration, and heightened institutional focus on capital efficiency. Tier-1 players with superior scale and robust balance sheets continue to consolidate share at the expense of marginal competitors.`;

const obstaclesAndChallenges = report.industryDeepDive?.obstaclesAndChallenges ||
  `Primary structural headwinds confronting the sector include sticky wage inflation, procurement cycles experiencing heightened budgetary scrutiny, elevated borrowing costs for debt-dependent expansion, and intermittent regulatory compliance overhead across international jurisdictions.`;

const politicalCulturalRisks = report.industryDeepDive?.economicPoliticalCulturalRisks ||
  `Broader macroeconomic and geopolitical vulnerabilities encompass interest rate volatility, evolving cross-border trade tariffs, antitrust and data privacy scrutiny, and corporate sustainability requirements that necessitate ongoing capital expenditures to maintain regulatory standing.`;
---

<BaseLayout
  title={report.title}
  description={report.description}
  ogType="article"
  publishDate={publishDateIso}
  ticker={report.ticker}
  companyName={report.companyName}
  sector={report.sector}
  keywords={report.keywords}
>
  <!-- [SECTION 1] STICKY ACTION & METADATA BAR -->
  <aside
    class="sticky top-0 z-40 bg-slate-950/90 backdrop-blur-md border-b border-slate-800 shadow-lg px-4 sm:px-6 py-2 transition-all no-print"
    id="sticky-action-bar"
    aria-label="Institutional Quick Action Bar"
  >
    <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-3 text-xs">
      <!-- Left: Ticker & Price Snapshot -->
      <div class="flex items-center gap-2.5 min-w-0">
        <a
          href={path(`/tickers/${report.ticker.toLowerCase()}`)}
          class="font-mono font-black text-xs px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-500/40 hover:bg-emerald-900 transition-colors shrink-0"
        >
          ${report.ticker}
        </a>
        <div class="flex items-baseline gap-1.5 font-mono">
          <span class="text-sm font-black text-white">${report.currentPrice.toFixed(2)}</span>
          <span class={`font-bold text-[11px] ${isPositive ? 'text-emerald-400' : 'text-rose-400'}`}>
            {isPositive ? '+' : ''}{report.movePercent.toFixed(2)}%
          </span>
        </div>
        {starRatingString && (
          <span class="hidden sm:inline-block font-mono text-[11px] text-amber-300 font-bold px-2 py-0.5 rounded bg-amber-950/70 border border-amber-700/50">
            {starRatingString}
          </span>
        )}
      </div>

      <!-- Right: Action Buttons & Institutional PDF Export -->
      <div class="flex items-center gap-2">
        <!-- PDF Export Button -->
        <a
          href={`${printUrl}?autoprint=true`}
          target="_blank"
          rel="noopener"
          id="export-pdf-action-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-xs font-bold transition-all shadow-md cursor-pointer border border-emerald-400/30"
          title="Download institutional research PDF formatted to Morningstar 7-Module standards (Shortcut: Cmd+P / Ctrl+P)"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6 2a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V7.414A2 2 0 0015.414 6L12 2.586A2 2 0 0010.586 2H6zm5 2l3 3h-3V4zm-1 9V9h-2v4H6l4 4 4-4h-2z" clip-rule="evenodd"/>
          </svg>
          <span>Export Institutional PDF</span>
          <span class="hidden md:inline-block text-[10px] text-emerald-200 font-normal px-1 rounded bg-emerald-700/50">⌘P</span>
        </a>

        <!-- Copy Link Quick Button -->
        <button
          type="button"
          class="copy-report-link-btn inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white border border-slate-700 text-xs font-mono transition-all cursor-pointer"
          title="Copy report URL"
        >
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
          <span class="copy-btn-label hidden sm:inline">Copy</span>
        </button>
      </div>
    </div>
  </aside>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb Bar -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 font-mono no-print" aria-label="Breadcrumbs">
      <a href={path('/')} class="hover:text-emerald-400 transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href={path('/reports')} class="hover:text-emerald-400 transition-colors">Reports</a>
      <span>&rsaquo;</span>
      <a href={path(`/tickers/${report.ticker.toLowerCase()}`)} class="hover:text-emerald-400 transition-colors">${report.ticker}</a>
      <span>&rsaquo;</span>
      <span class="text-slate-200 truncate">{report.companyName}</span>
    </nav>

    <!-- Top Notice Banner -->
    <ComplianceDisclaimer variant="banner" />

    <!-- Article Header -->
    <header class="my-6">
      <div class="flex flex-wrap items-center gap-2.5 mb-3">
        <a
          href={path(`/tickers/${report.ticker.toLowerCase()}`)}
          class="font-mono font-black text-lg px-2.5 py-0.5 rounded-lg bg-emerald-950 text-emerald-400 border border-emerald-500/40 hover:bg-emerald-900 transition-colors"
          title={`View full ${report.companyName} research hub`}
        >
          ${report.ticker}
        </a>
        <span class="text-xs font-mono uppercase bg-slate-800 text-slate-300 px-2 py-0.5 rounded">
          {report.exchange} &bull; {report.region}
        </span>
        <span class="text-xs text-slate-400 font-medium">
          {report.sector}
        </span>
        <span class="text-slate-400">&bull;</span>
        <time datetime={publishDateIso} class="text-xs text-slate-400 font-mono">{formattedDate}</time>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-snug">
        {report.title}
      </h1>

      <!-- Executive Price Callout: "Price on <date and time and zone>" -->
      <div class="mt-4 p-4 rounded-xl border border-slate-800 bg-slate-900/70 flex flex-wrap items-center justify-between gap-4">
        <div>
          <div class="text-[11px] uppercase tracking-wider text-slate-400 font-mono font-semibold">
            {priceDisplayLabel}
          </div>
          <div class="text-2xl sm:text-3xl font-black text-white font-mono mt-0.5">
            ${report.currentPrice.toFixed(2)} <span class="text-xs text-slate-400 font-normal">{report.currency}</span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class={`text-right px-4 py-2 rounded-lg border font-mono ${isPositive ? 'bg-emerald-950/80 border-emerald-500/30 text-emerald-400' : 'bg-rose-950/80 border-rose-500/30 text-rose-400'}`}>
            <div class="text-[10px] uppercase font-sans tracking-wide">Daily Move</div>
            <div class="text-lg font-black">{isPositive ? '+' : ''}{report.movePercent.toFixed(2)}%</div>
          </div>
        </div>
      </div>
    </header>

    <!-- [SECTION 2] FIRST-GLANCE QUICK-VIEW DASHBOARD (< 5-Sec Scan) -->
    <QuickViewDashboard report={report} />

    <!-- Top Programmatic Ad Slot -->
    {report.adSlots.topBanner && (
      <div class="my-4 no-print">
        <AdSlot slotId="report-top-ad" format="horizontal" minHeight="100px" />
      </div>
    )}

    <!-- [SECTION 3] INTERACTIVE TABBED DEEP-DIVE WORKSPACE -->
    <div class="no-print">
      <ReportTabsNav defaultTab="overview" />
    </div>

    <!-- TAB PANEL 1: OVERVIEW & OUTLOOK -->
    <div id="tab-panel-overview" class="report-tab-panel space-y-8 my-6">
      
      <!-- Company Research Deep Dive: 4 Key Core Questions -->
      <section class="p-5 sm:p-6 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-lg space-y-4">
        <div class="pb-3 border-b border-slate-800">
          <h2 class="text-lg font-extrabold text-white tracking-tight">
            Company Research Deep-Dive: Core Business Architecture
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Fundamental dissection of monetization, resilient demand drivers, execution history, and operating roadmap.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Question 1 -->
          <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 space-y-2">
            <div class="text-xs font-mono font-bold text-emerald-400 flex items-center gap-1.5 uppercase">
              <span>01</span> &bull; <span>How Does {report.companyName} Make Money?</span>
            </div>
            {parsedMakesMoney.intro && (
              <p class="text-xs text-slate-300 leading-relaxed">
                {parsedMakesMoney.intro}
              </p>
            )}
            {parsedMakesMoney.bullets.length > 0 && (
              <ul class="space-y-1.5 my-2 pl-1">
                {parsedMakesMoney.bullets.map((bullet) => (
                  <li class="text-xs text-slate-300 leading-relaxed flex items-start gap-2">
                    <span class="text-emerald-400 font-bold shrink-0 mt-0.5">&bull;</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
            {parsedMakesMoney.outro && (
              <p class="text-xs text-slate-300 leading-relaxed">
                {parsedMakesMoney.outro}
              </p>
            )}
          </div>

          <!-- Question 2 -->
          <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 space-y-2">
            <div class="text-xs font-mono font-bold text-sky-400 flex items-center gap-1.5 uppercase">
              <span>02</span> &bull; <span>Core Products & Resilient Demand Rationale</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {demandAndWhy}
            </p>
          </div>

          <!-- Question 3 -->
          <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 space-y-2">
            <div class="text-xs font-mono font-bold text-amber-400 flex items-center gap-1.5 uppercase">
              <span>03</span> &bull; <span>Historical Operational & Financial Performance</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {pastPerformance}
            </p>
          </div>

          <!-- Question 4 -->
          <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 space-y-2">
            <div class="text-xs font-mono font-bold text-indigo-400 flex items-center gap-1.5 uppercase">
              <span>04</span> &bull; <span>Medium-Term Growth & Profitability Roadmap</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {growthOutlook}
            </p>
          </div>
        </div>
      </section>

      <!-- Industry Research Deep Dive: 3 Key Sector Questions -->
      <section class="p-5 sm:p-6 rounded-2xl border border-slate-800 bg-slate-900/60 shadow-lg space-y-4">
        <div class="pb-3 border-b border-slate-800">
          <h2 class="text-lg font-extrabold text-white tracking-tight">
            Industry Research Deep-Dive: Sector Dynamics & Headwinds
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Macro landscape, structural industry bottlenecks, and regulatory/geopolitical vulnerabilities.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <!-- Industry Q1 -->
          <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 space-y-2">
            <div class="text-xs font-mono font-bold text-emerald-400 flex items-center gap-1.5 uppercase">
              <span>A</span> &bull; <span>Industry Macro Condition</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {industryCondition}
            </p>
          </div>

          <!-- Industry Q2 -->
          <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 space-y-2">
            <div class="text-xs font-mono font-bold text-amber-400 flex items-center gap-1.5 uppercase">
              <span>B</span> &bull; <span>Structural Obstacles</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {obstaclesAndChallenges}
            </p>
          </div>

          <!-- Industry Q3 -->
          <div class="p-4 rounded-xl border border-slate-800/80 bg-slate-950/60 space-y-2">
            <div class="text-xs font-mono font-bold text-rose-400 flex items-center gap-1.5 uppercase">
              <span>C</span> &bull; <span>Economic & Policy Risks</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {politicalCulturalRisks}
            </p>
          </div>
        </div>
      </section>

      <!-- Main Markdown Body (Typography-styled) -->
      <div class="prose prose-invert prose-emerald max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-emerald-400 hover:prose-a:text-emerald-300 prose-table:border prose-table:border-slate-800 prose-th:bg-slate-900 prose-th:p-3 prose-td:p-3 prose-td:border prose-td:border-slate-800">
        <ContentComponent />
      </div>

      <!-- Permanent Ticker Hub Cross-Link Callout -->
      <div class="my-8 p-4 rounded-xl border border-slate-800 bg-slate-900/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h4 class="text-sm font-bold text-white">Tracking ${report.ticker} ({report.companyName})?</h4>
          <p class="text-xs text-slate-400 mt-0.5">Explore the historical coverage hub with multi-quarter valuation trends and balance sheet tests.</p>
        </div>
        <a
          href={path(`/tickers/${report.ticker.toLowerCase()}`)}
          class="inline-flex shrink-0 items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-950 text-emerald-400 border border-emerald-500/30 hover:bg-emerald-900 transition-colors text-xs font-semibold"
        >
          <span>View ${report.ticker} Research Hub</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Contextual Affiliate Offer -->
      {primaryAffiliate && (
        <div class="my-8 no-print">
          <h3 class="text-sm font-bold text-slate-300 uppercase tracking-wider mb-3">Contextual Market Resources</h3>
          <AffiliateBanner affiliate={primaryAffiliate} />
        </div>
      )}

      <!-- Bottom Native Ad Slot -->
      {report.adSlots.bottomBanner && (
        <div class="no-print">
          <AdSlot slotId="report-bottom-ad" format="rectangle" minHeight="250px" />
        </div>
      )}

      <!-- Related Market Research (High-Value Internal Linking) -->
      {relatedReports.length > 0 && (
        <section class="my-10 border-t border-slate-800/80 pt-8 no-print">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-base font-bold text-white">Related Equity Deep Dives</h3>
            <a href={path('/reports')} class="text-xs text-emerald-400 hover:text-emerald-300">View Archive &rarr;</a>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {relatedReports.map((rel) => (
              <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/40 hover:border-slate-700 transition-all flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between text-xs mb-1.5">
                    <span class="font-mono font-bold text-emerald-400">${rel.data.ticker}</span>
                    <span class={`font-mono text-[11px] ${rel.data.movePercent >= 0 ? 'text-emerald-400' : 'text-rose-400'}`}>
                      {rel.data.movePercent >= 0 ? '+' : ''}{rel.data.movePercent.toFixed(1)}%
                    </span>
                  </div>
                  <h4 class="text-xs font-semibold text-white hover:text-emerald-400 transition-colors line-clamp-2">
                    <a href={path(`/reports/${rel.slug}`)}>{rel.data.title}</a>
                  </h4>
                </div>
                <a
                  href={path(`/reports/${rel.slug}`)}
                  class="mt-3 text-[11px] text-emerald-400 hover:text-emerald-300 font-medium inline-flex items-center gap-1"
                >
                  Read Deep Dive &rarr;
                </a>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Social Distribution & Network Syndication Section -->
      <section class="my-10 p-6 rounded-2xl border border-slate-700 bg-gradient-to-b from-slate-900/90 to-slate-950 shadow-xl no-print" id="social-distribution">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 mb-6 border-b border-slate-800">
          <div>
            <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-emerald-950/80 border border-emerald-500/40 text-[11px] font-mono font-semibold text-emerald-400 mb-2">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Institutional Syndication Hub
            </div>
            <h3 class="text-lg font-extrabold text-white tracking-tight">Social Distribution & Network Syndication</h3>
            <p class="text-xs text-slate-300 mt-1 max-w-2xl leading-relaxed">
              Distribute verified equity research, multi-model valuation figures, and balance sheet stress tests directly to active market participants and professional communities.
            </p>
          </div>
        </div>

        <!-- Social Links Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 mb-6">
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(xShareText)}&url=${encodeURIComponent(reportUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3.5 rounded-xl bg-black hover:bg-slate-900 border border-slate-700 hover:border-slate-500 transition-all group flex items-center justify-between shadow-sm"
          >
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-lg bg-slate-800 flex items-center justify-center text-white shrink-0 group-hover:scale-105 transition-transform">
