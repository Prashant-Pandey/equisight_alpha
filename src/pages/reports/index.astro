---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { path } from '../../utils/paths';
import { formatFCF } from '../../utils/formatters';
import { isPennyStock as checkPennyStock } from '../../utils/financialClassification';

const allReports = await getCollection('reports');
const sortedReports = allReports.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const allSectors = Array.from(new Set(sortedReports.map((r) => r.data.sector).filter(Boolean))).sort();

const pageTitle = "Complete Equity Research | EquiSight Alpha";
const pageDescription = "Algorithmic equity index. Institutional Morningstar 5-Star valuations, DCF intrinsic targets, economic moats, and catalyst transmission dynamics covering US and European equities.";

function formatCap(val: number | null | undefined): string {
  if (!val || isNaN(val)) return 'N/A';
  if (val >= 1e12) return `$${(val / 1e12).toFixed(2)}T`;
  if (val >= 1e9) return `$${(val / 1e9).toFixed(1)}B`;
  if (val >= 1e6) return `$${(val / 1e6).toFixed(0)}M`;
  return `$${val.toLocaleString()}`;
}

function getVerdictBadgeClass(verdict?: string | null): string {
  const v = (verdict || '').toLowerCase();
  if (v.includes('undervalued')) return 'text-[#00cc66] border-[#00cc66]';
  if (v.includes('overvalued')) return 'text-[#ff3344] border-[#ff3344]';
  return 'text-[#8e8e8e] border-[#3a3a3a]';
}

function getMoatBadgeClass(rating?: string | null): string {
  const r = (rating || '').toLowerCase();
  if (r.includes('wide')) return 'text-[#38bdf8] border-[#38bdf8]';
  if (r.includes('narrow')) return 'text-[#e5e5e5] border-[#444444]';
  return 'text-[#8e8e8e] border-[#4b5563]';
}
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-6 pb-4 border-b border-[#2e2e2e]">
      <div class="inline-block px-2 py-0.5 text-xs font-mono font-bold bg-[#181818] border border-[#38bdf8] text-[#38bdf8] mb-2 uppercase">
        ARCHIVE REPOSITORY // FULL REGISTRY
      </div>
      <h1 class="text-2xl sm:text-3xl font-mono font-black text-white tracking-tight uppercase">
        Equity Research Database
      </h1>
      <p class="text-xs font-mono text-[#8e8e8e] mt-1 max-w-3xl leading-relaxed">
        Institutional equity index. Standardized Morningstar 5-Star valuations, multi-model DCF intrinsic targets, competitive economic moats, and volume-catalyst transmission dynamics.
      </p>
    </div>

    <!-- Institutional Filter & Trading Engine -->
    <section class="mb-6 p-4 border border-[#2e2e2e] bg-[#181818] space-y-4" aria-label="Research Filters">
      <!-- 1-Click Strategy Presets Bar -->
      <div class="space-y-2">
        <div class="text-[10px] font-mono text-[#8e8e8e] uppercase tracking-wider flex items-center justify-between">
          <span>INSTITUTIONAL STRATEGY PRESETS (1-CLICK QUICK SCREENS)</span>
          <span id="active-preset-label" class="text-[#38bdf8] font-bold">ALL SECURITIES</span>
        </div>
        <div class="flex flex-wrap gap-1.5" id="preset-buttons-container">
          <button
            type="button"
            data-preset="all"
            class="preset-btn px-2.5 py-1 text-xs font-mono font-bold border transition-none cursor-pointer bg-[#38bdf8] text-slate-950 border-[#38bdf8]"
          >
            [ ALL SECURITIES ]
          </button>
          <button
            type="button"
            data-preset="buy-5star"
            class="preset-btn px-2.5 py-1 text-xs font-mono font-bold border transition-none cursor-pointer bg-[#121212] text-[#00cc66] border-[#2e2e2e] hover:border-[#00cc66]"
          >
            🟢 STRONG BUY / 5-STAR BARGAINS
          </button>
          <button
            type="button"
            data-preset="wide-moat"
            class="preset-btn px-2.5 py-1 text-xs font-mono font-bold border transition-none cursor-pointer bg-[#121212] text-[#38bdf8] border-[#4b5563] hover:border-[#38bdf8]"
          >
            🛡️ WIDE MOAT COMPOUNDERS
          </button>
          <button
            type="button"
            data-preset="catalyst-drift"
            class="preset-btn px-2.5 py-1 text-xs font-mono font-bold border transition-none cursor-pointer bg-[#121212] text-[#ffaa00] border-[#2e2e2e] hover:border-[#ffaa00]"
          >
            ⚡ PEAD &amp; CATALYST DRIFT
          </button>
          <button
            type="button"
            data-preset="contrarian-dip"
            class="preset-btn px-2.5 py-1 text-xs font-mono font-bold border transition-none cursor-pointer bg-[#121212] text-[#00e5ff] border-[#2e2e2e] hover:border-[#00e5ff]"
          >
            🔄 CONTRARIAN PULLBACKS
          </button>
          <button
            type="button"
            data-preset="sell-overvalued"
            class="preset-btn px-2.5 py-1 text-xs font-mono font-bold border transition-none cursor-pointer bg-[#121212] text-[#ff3344] border-[#2e2e2e] hover:border-[#ff3344]"
          >
            🔴 OVERVALUED / SELL CANDIDATES
          </button>
          <button
            type="button"
            data-preset="squeeze-traps"
            class="preset-btn px-2.5 py-1 text-xs font-mono font-bold border transition-none cursor-pointer bg-[#121212] text-[#ff8800] border-[#2e2e2e] hover:border-[#ff8800]"
          >
            ⚠️ SQUEEZE &amp; TRAP WARNINGS
          </button>
        </div>
      </div>

      <!-- Search & Sort Bar -->
      <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3 pt-3 border-t border-[#222222]">
        <!-- Text Search -->
        <div class="relative flex-1">
          <input
            type="text"
            id="filter-search"
            placeholder="FILTER TICKER (e.g. AAPL, NVDA, ADBE) OR COMPANY NAME..."
            class="w-full px-3 py-2 bg-[#121212] border border-[#4b5563] text-white placeholder-slate-400 text-xs font-mono focus:outline-none focus:border-[#38bdf8] transition-none tap-target"
          />
        </div>

        <!-- Sort Select & Reset Button -->
        <div class="flex items-center gap-2">
          <div class="relative min-w-[220px]">
            <select
              id="filter-sort"
              class="w-full px-3 py-2 bg-[#121212] border border-[#4b5563] text-white text-xs font-mono focus:outline-none focus:border-[#38bdf8] cursor-pointer appearance-none pr-8 tap-target"
            >
              <option value="newest">SORT: NEWEST COVERAGE</option>
              <option value="oldest">SORT: OLDEST COVERAGE</option>
              <option value="discount">SORT: DEEPEST DISCOUNT (LOWEST P/FV)</option>
              <option value="star-desc">SORT: HIGHEST STAR RATING (5★ → 1★)</option>
              <option value="rvol-desc">SORT: HIGHEST RVOL (VOLUME SURGE)</option>
              <option value="top-gainers">SORT: TOP GAINERS (+%)</option>
              <option value="top-losers">SORT: TOP LOSERS (-%)</option>
              <option value="market-cap">SORT: MARKET CAP (LARGEST FIRST)</option>
            </select>
          </div>

          <button
            id="filter-reset-btn"
            type="button"
            class="px-3 py-2 bg-[#222222] hover:bg-[#2e2e2e] text-[#e5e5e5] hover:text-white text-xs font-mono font-bold transition-none whitespace-nowrap cursor-pointer border border-[#2e2e2e] tap-target"
          >
            [ RESET ALL ]
          </button>
        </div>
      </div>

      <!-- 6-Column Institutional Parameter Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5 pt-3 border-t border-[#222222]">
        <!-- 1. Valuation Stance & Stars -->
        <div>
          <label for="filter-stance" class="block text-[10px] font-mono text-[#8e8e8e] uppercase tracking-wider mb-1">
            VALUATION STANCE
          </label>
          <select
            id="filter-stance"
            class="w-full px-2 py-1.5 bg-[#121212] border border-[#4b5563] text-xs font-mono text-[#e5e5e5] focus:outline-none focus:border-[#38bdf8]"
          >
            <option value="all">ALL VALUATIONS</option>
            <option value="5star">5-STAR BARGAIN (DEEP DISCOUNT)</option>
            <option value="undervalued">UNDERVALUED (4-5★ / P/FV &lt; 0.95)</option>
            <option value="fair">FAIR VALUE (3★ / P/FV 0.95-1.15)</option>
            <option value="overvalued">OVERVALUED (1-2★ / P/FV &gt; 1.25)</option>
            <option value="extreme-overvalued">EXTREME OVERVALUED (P/FV &gt; 1.50)</option>
            <option value="speculative">SPECULATIVE / UNRATED</option>
          </select>
        </div>

        <!-- 2. Economic Moat & Quality -->
        <div>
          <label for="filter-moat" class="block text-[10px] font-mono text-[#8e8e8e] uppercase tracking-wider mb-1">
            MOAT &amp; QUALITY
          </label>
          <select
            id="filter-moat"
            class="w-full px-2 py-1.5 bg-[#121212] border border-[#4b5563] text-xs font-mono text-[#e5e5e5] focus:outline-none focus:border-[#38bdf8]"
          >
            <option value="all">ALL MOATS &amp; QUALITY</option>
            <option value="wide">WIDE MOAT (DURABLE ADVANTAGE)</option>
            <option value="narrow">NARROW MOAT</option>
            <option value="positive-trend">EXPANDING MOAT (POSITIVE TREND)</option>
            <option value="high-roe">HIGH ROE (EFFICIENCY &ge; 20%)</option>
            <option value="no-moat">NO MOAT / COMMODITY</option>
          </select>
        </div>

        <!-- 3. Catalyst & Volume Flow -->
        <div>
          <label for="filter-catalyst" class="block text-[10px] font-mono text-[#8e8e8e] uppercase tracking-wider mb-1">
            CATALYST &amp; FLOW
          </label>
          <select
            id="filter-catalyst"
            class="w-full px-2 py-1.5 bg-[#121212] border border-[#4b5563] text-xs font-mono text-[#e5e5e5] focus:outline-none focus:border-[#38bdf8]"
          >
            <option value="all">ALL FLOW &amp; CATALYSTS</option>
            <option value="high-rvol">VOLUME SURGE (RVOL &ge; 1.5x)</option>
            <option value="aligned">FUNDAMENTALLY ALIGNED (HIGH CONVICTION)</option>
            <option value="sell-the-news">SELL-THE-NEWS DIVERGENCE (REVERSAL)</option>
            <option value="relief-rally">RELIEF RALLY (SHORT COVER)</option>
            <option value="speculation">NOISE / SPECULATIVE HYPE</option>
          </select>
        </div>

        <!-- 4. Market Cap Tier & Scale -->
        <div>
          <label for="filter-cap" class="block text-[10px] font-mono text-[#8e8e8e] uppercase tracking-wider mb-1">
            MARKET CAP TIER
          </label>
          <select
            id="filter-cap"
            class="w-full px-2 py-1.5 bg-[#121212] border border-[#4b5563] text-xs font-mono text-[#e5e5e5] focus:outline-none focus:border-[#38bdf8]"
          >
            <option value="all">ALL CAPITALIZATIONS</option>
            <option value="mega">MEGA CAP (&gt; $200B)</option>
            <option value="large">LARGE CAP ($10B - $200B)</option>
            <option value="mid">MID CAP ($2B - $10B)</option>
            <option value="small">SMALL / MICRO (&lt; $2B)</option>
            <option value="non-penny">EXCLUDE PENNY STOCKS</option>
          </select>
        </div>

        <!-- 5. Solvency & Risk Profile -->
        <div>
          <label for="filter-risk-profile" class="block text-[10px] font-mono text-[#8e8e8e] uppercase tracking-wider mb-1">
            SOLVENCY &amp; RISK
          </label>
          <select
            id="filter-risk-profile"
            class="w-full px-2 py-1.5 bg-[#121212] border border-[#4b5563] text-xs font-mono text-[#e5e5e5] focus:outline-none focus:border-[#38bdf8]"
          >
            <option value="all">ALL RISK PROFILES</option>
            <option value="low-risk">LOW RISK SCORE (&le; 4/10)</option>
            <option value="cash-cow">HIGH FCF GENERATOR (&gt; $1B FCF)</option>
            <option value="positive-fcf">POSITIVE FREE CASH FLOW</option>
            <option value="cash-burning">CASH BURN (NEGATIVE FCF)</option>
            <option value="squeeze-risk">HIGH GAMMA / SQUEEZE RISK</option>
            <option value="high-inflation">HIGH ARTIFICIAL INFLATION RISK</option>
          </select>
        </div>

        <!-- 6. Sector Universe -->
        <div>
          <label for="filter-sector" class="block text-[10px] font-mono text-[#8e8e8e] uppercase tracking-wider mb-1">
            SECTOR UNIVERSE
          </label>
          <select
            id="filter-sector"
            class="w-full px-2 py-1.5 bg-[#121212] border border-[#4b5563] text-xs font-mono text-[#e5e5e5] focus:outline-none focus:border-[#38bdf8]"
          >
            <option value="all">ALL SECTORS</option>
            {allSectors.map((sector) => (
              <option value={sector}>{sector.toUpperCase()}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- Bottom Bar: Active Filters Counter -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-3 border-t border-[#222222]">
        <div class="text-[11px] font-mono text-[#8e8e8e]">
          SCREENING STATUS: <span id="filter-status-desc" class="text-white font-bold">ALL COVERED EQUITIES</span>
        </div>

        <!-- Dynamic Counter -->
        <div class="text-xs font-mono text-[#8e8e8e]">
          MATCHED: <span id="visible-count" class="font-bold text-[#38bdf8]">{sortedReports.length}</span> / <span id="total-count" class="font-bold text-white">{sortedReports.length}</span> SECURITIES
        </div>
      </div>
    </section>

    <!-- Empty State Container -->
    <div id="filter-empty-state" class="hidden my-8 p-6 border border-[#2e2e2e] bg-[#181818] text-center space-y-3 font-mono">
      <h3 class="text-sm font-bold text-white uppercase">[ ZERO MATCHING SECURITIES ]</h3>
      <p class="text-xs text-[#8e8e8e] max-w-md mx-auto">
        No equities meet active strategy criteria and parameter filters. Reset parameters to inspect full coverage universe.
      </p>
      <button
        id="empty-reset-btn"
        type="button"
        class="px-4 py-1.5 bg-[#38bdf8] hover:bg-[#7dd3fc] text-slate-950 text-xs font-mono font-bold border border-[#38bdf8] transition-none cursor-pointer tap-target"
      >
        [ RESET ALL FILTERS ]
      </button>
    </div>

    <!-- Reports Grid (High-Density Utilitarian Cards with 1px borders) -->
    <div id="reports-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {sortedReports.map((report) => {
        const d = report.data;
        const isPenny = checkPennyStock(d.currentPrice, d.exchange, d.isPennyStock);
        const fcfVal = d.cashFlow?.freeCashFlow ?? d.freeCashFlow ?? (d.marketCap ? Math.round(d.marketCap * 0.054) : 180000000);
        const priceVal = d.currentPrice ?? 0;
        const moveVal = d.movePercent ?? 0;
        const isPos = moveVal >= 0;
        const pubTimestamp = new Date(d.publishDate).getTime();
        const marketCap = d.marketCap ?? 0;

        // Institutional valuation metrics
        const stars = d.starRating ?? 3;
        const pfv = typeof d.priceToFairValue === 'number' && !isNaN(d.priceToFairValue) ? d.priceToFairValue : 1.0;
        const consensusFV = d.valuationModels?.consensusFairValue ?? null;
        const verdict = d.valuationModels?.verdict ?? d.fundamentalRating ?? 'Fairly Valued';

        // Moat & Quality
        const moatRating = d.competitiveMoat?.rating ?? 'None';
        const moatTrend = d.moatTrend ?? 'Stable';
        const roe = typeof d.returnOnEquity === 'number' ? d.returnOnEquity : 0;

        // Catalyst & Flow
        const catalyst = d.catalystAlignment ?? 'ALIGNED';
        const rvol = typeof d.volumeAnomalyRatio === 'number' ? d.volumeAnomalyRatio : 1.0;
        const gammaRisk = d.optionGammaImbalance?.riskLevel ?? 'Low';
        const inflationRisk = d.artificialInflationRisk ?? 'Low';
        const category = d.category ?? (isPos ? 'gainer' : 'loser');
        const riskVal = d.riskScore ?? 5;
        const sector = d.sector ?? 'Unassigned';

        return (
          <article
            class="report-card p-4 border border-[#2e2e2e] bg-[#181818] hover:border-[#38bdf8] transition-none flex flex-col justify-between"
            data-ticker={d.ticker.toLowerCase()}
            data-company={d.companyName.toLowerCase()}
            data-title={d.title.toLowerCase()}
            data-price={priceVal}
            data-move={moveVal}
            data-category={category}
            data-cap={marketCap}
            data-stars={stars}
            data-pfv={pfv}
            data-verdict={verdict.toLowerCase()}
            data-moat={moatRating}
            data-moat-trend={moatTrend}
            data-roe={roe}
            data-catalyst={catalyst}
            data-rvol={rvol}
            data-gamma={gammaRisk}
            data-inflation={inflationRisk}
            data-risk={riskVal}
            data-fcf={fcfVal}
            data-sector={sector}
            data-date={pubTimestamp}
            data-penny={isPenny ? 'true' : 'false'}
          >
            <div>
              <!-- Top Row: Ticker, Moat Badge, Stars & PFV, Date -->
              <div class="flex items-center justify-between text-xs mb-2.5 gap-2 font-mono flex-wrap">
                <div class="flex items-center gap-1.5 flex-wrap">
                  <a
                    href={path(`/tickers/${d.ticker.toLowerCase()}`)}
                    class="font-black text-white bg-[#121212] px-2 py-0.5 border border-[#2e2e2e] hover:border-[#38bdf8] transition-none"
                    title={`View all research for $${d.ticker}`}
                  >
                    ${d.ticker}
                  </a>

                  <!-- Moat Badge -->
                  <span class={`px-1.5 py-0.5 text-[10px] font-bold border uppercase ${getMoatBadgeClass(moatRating)} bg-[#121212]`}>
                    {moatRating}
                  </span>

                  <!-- Star Rating & P/FV -->
                  <span class={`px-1.5 py-0.5 text-[10px] font-bold border ${stars >= 4 ? 'text-[#00cc66] border-[#00cc66]' : stars <= 2 ? 'text-[#ff3344] border-[#ff3344]' : 'text-[#e5e5e5] border-[#3a3a3a]'} bg-[#121212]`}>
                    {'★'.repeat(stars)}{'☆'.repeat(5 - stars)} ({pfv.toFixed(2)}x FV)
                  </span>
                </div>

                <time datetime={new Date(d.publishDate).toISOString()} class="text-[#8e8e8e] text-[10px]">
                  {new Date(d.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
              </div>

              <!-- Report Title -->
              <h2 class="text-sm font-mono font-bold text-white hover:text-[#38bdf8] transition-none line-clamp-2 leading-snug">
                <a href={path(`/reports/${report.slug}`)}>{d.title}</a>
              </h2>

              <!-- Description -->
              <p class="text-xs text-[#8e8e8e] mt-1.5 line-clamp-2 leading-relaxed">
                {d.description}
              </p>

              <!-- Key Institutional Metrics Grid (3-Box Strip) -->
              <div class="mt-3 pt-2.5 border-t border-[#222222] grid grid-cols-3 gap-2 text-[11px] font-mono">
                <!-- Price & Session Move -->
                <div class="p-2 bg-[#121212] border border-[#222222]">
                  <div class="text-[9px] text-[#8e8e8e] uppercase">PRICE / MOVE</div>
                  <div class="font-bold text-white mt-0.5">${priceVal.toFixed(2)}</div>
                  <div class={`text-[10px] font-bold ${isPos ? 'text-[#00cc66]' : 'text-[#ff3344]'}`}>
                    {isPos ? '+' : ''}{moveVal.toFixed(1)}%
                  </div>
                </div>

                <!-- Valuation & Stance -->
                <div class="p-2 bg-[#121212] border border-[#222222]">
                  <div class="text-[9px] text-[#8e8e8e] uppercase">FAIR VALUE</div>
                  <div class="font-bold text-white mt-0.5">{consensusFV ? `$${consensusFV.toFixed(2)}` : 'N/A'}</div>
                  <div class={`text-[10px] font-bold truncate ${getVerdictBadgeClass(verdict)}`}>
                    {pfv < 0.95 ? 'Undervalued' : pfv > 1.25 ? 'Overvalued' : 'Fair Value'}
                  </div>
                </div>

                <!-- Flow & Solvency -->
                <div class="p-2 bg-[#121212] border border-[#222222]">
                  <div class="text-[9px] text-[#8e8e8e] uppercase">RVOL · RISK</div>
                  <div class="font-bold text-[#e5e5e5] mt-0.5">{rvol.toFixed(2)}x RVOL</div>
                  <div class="text-[10px] text-[#8e8e8e]">
                    Risk: <span class="text-white font-bold">{riskVal}</span>/10
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Bottom Bar -->
            <div class="mt-3 pt-2.5 border-t border-[#222222] flex items-center justify-between text-xs font-mono">
              <span class="text-[10px] text-[#8e8e8e] truncate max-w-[200px]" title={`${d.sector} · ${d.exchange} · ${formatCap(marketCap)}`}>
                {d.sector} · {formatCap(marketCap)}
              </span>
              <a
                href={path(`/reports/${report.slug}`)}
                class="text-[#38bdf8] hover:text-slate-950 hover:bg-[#38bdf8] px-2 py-0.5 border border-[#4b5563] font-bold text-xs transition-none tap-target"
              >
                [ VIEW REPORT ]
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>

<!-- Client Script for Interactive Archive Filter Engine -->
<script>
  function initArchiveFilter() {
    const searchInput = document.getElementById('filter-search') as HTMLInputElement | null;
    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement | null;
    const stanceSelect = document.getElementById('filter-stance') as HTMLSelectElement | null;
    const moatSelect = document.getElementById('filter-moat') as HTMLSelectElement | null;
    const catalystSelect = document.getElementById('filter-catalyst') as HTMLSelectElement | null;
    const capSelect = document.getElementById('filter-cap') as HTMLSelectElement | null;
    const riskSelect = document.getElementById('filter-risk-profile') as HTMLSelectElement | null;
    const sectorSelect = document.getElementById('filter-sector') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('filter-reset-btn');
    const emptyResetBtn = document.getElementById('empty-reset-btn');
    const visibleCountEl = document.getElementById('visible-count');
    const totalCountEl = document.getElementById('total-count');
    const emptyStateEl = document.getElementById('filter-empty-state');
    const statusDescEl = document.getElementById('filter-status-desc');
    const activePresetLabel = document.getElementById('active-preset-label');
    const presetButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.preset-btn'));
    const cardsContainer = document.getElementById('reports-grid');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.report-card'));

    if (!cardsContainer || cards.length === 0) return;

    let activePreset = 'all';

    const presetLabels: Record<string, string> = {
      'all': 'ALL SECURITIES',
      'buy-5star': '🟢 STRONG BUY / 5-STAR BARGAINS',
      'wide-moat': '🛡️ WIDE MOAT COMPOUNDERS',
      'catalyst-drift': '⚡ PEAD & CATALYST DRIFT',
      'contrarian-dip': '🔄 CONTRARIAN PULLBACKS',
      'sell-overvalued': '🔴 OVERVALUED / SELL CANDIDATES',
      'squeeze-traps': '⚠️ SQUEEZE & TRAP WARNINGS'
    };

    function updatePresetButtonStyles() {
      presetButtons.forEach((btn) => {
        const preset = btn.dataset.preset;
        if (preset === activePreset) {
          btn.className = 'preset-btn px-2.5 py-1 text-xs font-mono font-bold border transition-none cursor-pointer bg-[#38bdf8] text-slate-950 border-[#38bdf8]';
        } else {
          // Restore thematic button outlines
          let textClass = 'text-[#e5e5e5]';
          let borderHover = 'hover:border-[#38bdf8]';
          if (preset === 'buy-5star') { textClass = 'text-[#00cc66]'; borderHover = 'hover:border-[#00cc66]'; }
          else if (preset === 'wide-moat') { textClass = 'text-[#38bdf8]'; borderHover = 'hover:border-[#38bdf8]'; }
          else if (preset === 'catalyst-drift') { textClass = 'text-[#ffaa00]'; borderHover = 'hover:border-[#ffaa00]'; }
          else if (preset === 'contrarian-dip') { textClass = 'text-[#00e5ff]'; borderHover = 'hover:border-[#00e5ff]'; }
          else if (preset === 'sell-overvalued') { textClass = 'text-[#ff3344]'; borderHover = 'hover:border-[#ff3344]'; }
          else if (preset === 'squeeze-traps') { textClass = 'text-[#ff8800]'; borderHover = 'hover:border-[#ff8800]'; }

          btn.className = `preset-btn px-2.5 py-1 text-xs font-mono font-bold border transition-none cursor-pointer bg-[#121212] ${textClass} border-[#2e2e2e] ${borderHover}`;
        }
      });

      if (activePresetLabel) {
        activePresetLabel.textContent = presetLabels[activePreset] || activePreset.toUpperCase();
      }
      if (statusDescEl) {
        statusDescEl.textContent = presetLabels[activePreset] || 'CUSTOM SCREENING';
      }
    }

    function applyFilters() {
      const query = searchInput?.value.trim().toLowerCase() || '';
      const stance = stanceSelect?.value || 'all';
      const moat = moatSelect?.value || 'all';
      const catalyst = catalystSelect?.value || 'all';
      const cap = capSelect?.value || 'all';
      const riskProfile = riskSelect?.value || 'all';
      const sector = sectorSelect?.value || 'all';
      const sortVal = sortSelect?.value || 'newest';

      let visibleCount = 0;

      cards.forEach((card) => {
        const ticker = card.dataset.ticker || '';
        const company = card.dataset.company || '';
        const title = card.dataset.title || '';
        const price = parseFloat(card.dataset.price || '0');
        const move = parseFloat(card.dataset.move || '0');
        const stars = parseInt(card.dataset.stars || '3', 10);
        const pfv = parseFloat(card.dataset.pfv || '1.0');
        const verdict = card.dataset.verdict || '';
        const moatRating = card.dataset.moat || '';
        const moatTrend = card.dataset.moatTrend || '';
        const roe = parseFloat(card.dataset.roe || '0');
        const catalystAlign = card.dataset.catalyst || '';
        const rvol = parseFloat(card.dataset.rvol || '1.0');
        const marketCap = parseFloat(card.dataset.cap || '0');
        const risk = parseInt(card.dataset.risk || '5', 10);
        const fcf = parseFloat(card.dataset.fcf || '0');
        const gamma = card.dataset.gamma || '';
        const inflation = card.dataset.inflation || '';
        const cardSector = card.dataset.sector || '';
        const isPenny = card.dataset.penny === 'true';

        // 1. Text Search Filter
        if (query && !ticker.includes(query) && !company.includes(query) && !title.includes(query)) {
          card.style.display = 'none';
          return;
        }

        // 2. Active Strategy Preset Rule
        if (activePreset === 'buy-5star') {
          const isBuy = stars >= 4 || pfv <= 0.85 || verdict.includes('undervalued');
          if (!isBuy) {
            card.style.display = 'none';
            return;
          }
        } else if (activePreset === 'wide-moat') {
          if (!moatRating.includes('Wide') || fcf <= 0) {
            card.style.display = 'none';
            return;
          }
        } else if (activePreset === 'catalyst-drift') {
          if (catalystAlign !== 'ALIGNED' || move < 0 || rvol < 1.0) {
            card.style.display = 'none';
            return;
          }
        } else if (activePreset === 'contrarian-dip') {
          if (move >= 0 || (stars < 3 && !moatRating.includes('Wide') && pfv > 1.1) || risk > 6) {
            card.style.display = 'none';
            return;
          }
        } else if (activePreset === 'sell-overvalued') {
          const isSell = stars <= 2 || pfv >= 1.25 || verdict.includes('overvalued');
          if (!isSell) {
            card.style.display = 'none';
            return;
          }
        } else if (activePreset === 'squeeze-traps') {
          const isTrap = gamma === 'High' || gamma === 'Severe' || inflation === 'High' || inflation === 'Severe' || catalystAlign === 'NOISE_SPECULATION';
          if (!isTrap) {
            card.style.display = 'none';
            return;
          }
        }

        // 3. Valuation Stance Filter
        if (stance === '5star' && !(stars === 5 || pfv <= 0.80)) {
          card.style.display = 'none';
          return;
        }
        if (stance === 'undervalued' && !(stars >= 4 || pfv < 0.95 || verdict.includes('undervalued'))) {
          card.style.display = 'none';
          return;
        }
        if (stance === 'fair' && !((stars === 3 && pfv >= 0.85 && pfv <= 1.20) || verdict.includes('fairly'))) {
          card.style.display = 'none';
          return;
        }
        if (stance === 'overvalued' && !(stars <= 2 || pfv > 1.20 || verdict.includes('overvalued'))) {
          card.style.display = 'none';
          return;
        }
        if (stance === 'extreme-overvalued' && !(stars === 1 || pfv > 1.50)) {
          card.style.display = 'none';
          return;
        }
        if (stance === 'speculative' && !(verdict.includes('speculative') || isPenny)) {
          card.style.display = 'none';
          return;
        }

        // 4. Moat & Quality Filter
        if (moat === 'wide' && !moatRating.includes('Wide')) {
          card.style.display = 'none';
          return;
        }
        if (moat === 'narrow' && !moatRating.includes('Narrow')) {
          card.style.display = 'none';
          return;
        }
        if (moat === 'positive-trend' && moatTrend !== 'Positive') {
          card.style.display = 'none';
          return;
        }
        if (moat === 'high-roe' && roe < 20) {
          card.style.display = 'none';
          return;
        }
        if (moat === 'no-moat' && (moatRating.includes('Wide') || moatRating.includes('Narrow'))) {
          card.style.display = 'none';
          return;
        }

        // 5. Catalyst & Volume Flow Filter
        if (catalyst === 'high-rvol' && rvol < 1.5) {
          card.style.display = 'none';
          return;
        }
        if (catalyst === 'aligned' && catalystAlign !== 'ALIGNED') {
          card.style.display = 'none';
          return;
        }
        if (catalyst === 'sell-the-news' && catalystAlign !== 'DIVERGENT_SELL_THE_NEWS') {
          card.style.display = 'none';
          return;
        }
        if (catalyst === 'relief-rally' && catalystAlign !== 'DIVERGENT_RELIEF_RALLY') {
          card.style.display = 'none';
          return;
        }
        if (catalyst === 'speculation' && !(catalystAlign === 'NOISE_SPECULATION' || inflation === 'Severe' || gamma === 'Severe')) {
          card.style.display = 'none';
          return;
        }

        // 6. Market Cap Tier Filter
        if (cap === 'mega' && marketCap < 200e9) {
          card.style.display = 'none';
          return;
        }
        if (cap === 'large' && (marketCap < 10e9 || marketCap >= 200e9)) {
          card.style.display = 'none';
          return;
        }
        if (cap === 'mid' && (marketCap < 2e9 || marketCap >= 10e9)) {
          card.style.display = 'none';
          return;
        }
        if (cap === 'small' && marketCap >= 2e9) {
          card.style.display = 'none';
          return;
        }
        if (cap === 'non-penny' && (isPenny || price < 5)) {
          card.style.display = 'none';
          return;
        }

        // 7. Solvency & Risk Profile Filter
        if (riskProfile === 'low-risk' && risk > 4) {
          card.style.display = 'none';
          return;
        }
        if (riskProfile === 'cash-cow' && fcf < 1e9) {
          card.style.display = 'none';
          return;
        }
        if (riskProfile === 'positive-fcf' && fcf <= 0) {
          card.style.display = 'none';
          return;
        }
        if (riskProfile === 'cash-burning' && fcf > 0) {
          card.style.display = 'none';
          return;
        }
        if (riskProfile === 'squeeze-risk' && !(gamma === 'High' || gamma === 'Severe')) {
          card.style.display = 'none';
          return;
        }
        if (riskProfile === 'high-inflation' && !(inflation === 'High' || inflation === 'Severe')) {
          card.style.display = 'none';
          return;
        }

        // 8. Sector Filter
        if (sector !== 'all' && cardSector.toLowerCase() !== sector.toLowerCase()) {
          card.style.display = 'none';
          return;
        }

        // Passed all active criteria!
        card.style.display = '';
        visibleCount++;
      });

      // Handle Sorting of cards in DOM
      const sorted = [...cards].sort((a, b) => {
        const dateA = parseInt(a.dataset.date || '0', 10);
        const dateB = parseInt(b.dataset.date || '0', 10);
        const moveA = parseFloat(a.dataset.move || '0');
        const moveB = parseFloat(b.dataset.move || '0');
        const pfvA = parseFloat(a.dataset.pfv || '1.0');
        const pfvB = parseFloat(b.dataset.pfv || '1.0');
        const starA = parseInt(a.dataset.stars || '3', 10);
        const starB = parseInt(b.dataset.stars || '3', 10);
        const rvolA = parseFloat(a.dataset.rvol || '1.0');
        const rvolB = parseFloat(b.dataset.rvol || '1.0');
        const capA = parseFloat(a.dataset.cap || '0');
        const capB = parseFloat(b.dataset.cap || '0');

        if (sortVal === 'oldest') return dateA - dateB;
        if (sortVal === 'discount') return pfvA - pfvB; // Lowest P/FV (deepest discount first)
        if (sortVal === 'star-desc') return starB - starA; // 5 stars down to 1
        if (sortVal === 'rvol-desc') return rvolB - rvolA; // Highest RVOL first
        if (sortVal === 'top-gainers') return moveB - moveA;
        if (sortVal === 'top-losers') return moveA - moveB;
        if (sortVal === 'market-cap') return capB - capA;
        return dateB - dateA; // default newest
      });

      sorted.forEach((card) => {
        cardsContainer.appendChild(card);
      });

      if (visibleCountEl) visibleCountEl.textContent = visibleCount.toString();
      if (emptyStateEl) {
        if (visibleCount === 0) {
          emptyStateEl.classList.remove('hidden');
        } else {
          emptyStateEl.classList.add('hidden');
        }
      }
    }

    function resetFilters() {
      activePreset = 'all';
      if (searchInput) searchInput.value = '';
      if (sortSelect) sortSelect.value = 'newest';
      if (stanceSelect) stanceSelect.value = 'all';
      if (moatSelect) moatSelect.value = 'all';
      if (catalystSelect) catalystSelect.value = 'all';
      if (capSelect) capSelect.value = 'all';
      if (riskSelect) riskSelect.value = 'all';
      if (sectorSelect) sectorSelect.value = 'all';
      updatePresetButtonStyles();
      applyFilters();
    }

    // Attach Preset Button Listeners
    presetButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const preset = btn.dataset.preset || 'all';
        activePreset = preset;

        // Smart-sync default sort when picking specific presets
        if (preset === 'buy-5star' && sortSelect) sortSelect.value = 'discount';
        else if (preset === 'catalyst-drift' && sortSelect) sortSelect.value = 'rvol-desc';
        else if (preset === 'contrarian-dip' && sortSelect) sortSelect.value = 'top-losers';
        else if (preset === 'sell-overvalued' && sortSelect) sortSelect.value = 'top-gainers';
        else if (preset === 'all' && sortSelect) sortSelect.value = 'newest';

        updatePresetButtonStyles();
        applyFilters();
      });
    });

    // Attach Parameter Input Listeners
    searchInput?.addEventListener('input', applyFilters);
    sortSelect?.addEventListener('change', applyFilters);
    stanceSelect?.addEventListener('change', () => {
      if (activePreset !== 'all' && stanceSelect.value !== 'all') {
        // user is customizing
      }
      applyFilters();
    });
    moatSelect?.addEventListener('change', applyFilters);
    catalystSelect?.addEventListener('change', applyFilters);
    capSelect?.addEventListener('change', applyFilters);
    riskSelect?.addEventListener('change', applyFilters);
    sectorSelect?.addEventListener('change', applyFilters);
    resetBtn?.addEventListener('click', resetFilters);
    emptyResetBtn?.addEventListener('click', resetFilters);

    if (totalCountEl) totalCountEl.textContent = cards.length.toString();
    if (visibleCountEl) visibleCountEl.textContent = cards.length.toString();
    updatePresetButtonStyles();
  }

  initArchiveFilter();
  document.addEventListener('astro:page-load', initArchiveFilter);
</script>
