---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allReports = await getCollection('reports');
  const tickers = new Set<string>();

  for (const report of allReports) {
    tickers.add(report.data.ticker.toUpperCase());
  }

  return Array.from(tickers).map((ticker) => {
    const tickerReports = allReports
      .filter((r) => r.data.ticker.toUpperCase() === ticker)
      .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

    return {
      params: { ticker: ticker.toLowerCase() },
      props: { ticker, reports: tickerReports }
    };
  });
}

const { ticker, reports } = Astro.props;
const latestReport = reports[0];
const companyName = latestReport ? latestReport.data.companyName : ticker;
const sector = latestReport ? latestReport.data.sector : 'Equities';

const pageTitle = `${companyName} ($${ticker}) Fundamental Analysis & Research Hub`;
const pageDescription = `Historical equity research reports, valuation multiples, balance sheet stress tests, and financial health trends for ${companyName} (${ticker}).`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ticker={ticker}
  companyName={companyName}
  sector={sector}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb Bar -->
    <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 font-mono">
      <a href="/" class="hover:text-emerald-400 transition-colors">Home</a>
      <span>&rsaquo;</span>
      <a href="/reports" class="hover:text-emerald-400 transition-colors">Reports</a>
      <span>&rsaquo;</span>
      <span class="text-slate-200">${ticker} Research Hub</span>
    </nav>

    <!-- Header -->
    <div class="mb-10 pb-6 border-b border-slate-800">
      <div class="flex items-center gap-3 mb-2">
        <span class="font-mono font-black text-2xl text-emerald-400 bg-emerald-950 px-3 py-1 rounded-xl border border-emerald-500/40">
          ${ticker}
        </span>
        <div>
          <h1 class="text-3xl font-extrabold text-white tracking-tight">{companyName}</h1>
          <p class="text-xs text-slate-400 font-mono mt-0.5">
            {latestReport ? `${latestReport.data.exchange} • ${sector} • ${latestReport.data.industry}` : 'Equities Research'}
          </p>
        </div>
      </div>
      <p class="text-sm text-slate-300 mt-4 max-w-3xl leading-relaxed">
        Comprehensive institutional research archive for {companyName}. In-depth fundamental reports evaluate balance sheet solvency, cash flow generation, and macroeconomic sensitivity over time.
      </p>
    </div>

    <!-- Coverage History Feed -->
    <div>
      <h2 class="text-xl font-bold text-white mb-6">Historical Research Coverage ({reports.length} Reports)</h2>
      
      <div class="space-y-4">
        {reports.map((report) => (
          <article class="p-5 rounded-xl border border-slate-800 bg-slate-900/40 hover:border-slate-700 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-3 text-xs text-slate-400 mb-1">
                <time datetime={new Date(report.data.publishDate).toISOString()} class="font-mono">
                  {new Date(report.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span class={`font-mono font-bold ${report.data.movePercent >= 0 ? 'text-emerald-400' : 'text-rose-400'}`}>
                  {report.data.movePercent >= 0 ? '+' : ''}{report.data.movePercent.toFixed(2)}% Move
                </span>
                <span class="text-slate-600">&bull;</span>
                <span>P/E: <strong class="text-slate-200">{report.data.peRatio ? `${report.data.peRatio.toFixed(1)}x` : 'N/A'}</strong></span>
                <span class="text-slate-600">&bull;</span>
                <span>Cap: <strong class="text-slate-200">${(report.data.marketCap / 1e9).toFixed(1)}B</strong></span>
              </div>
              <h3 class="text-base font-bold text-white hover:text-emerald-400 transition-colors">
                <a href={`/reports/${report.slug}`}>{report.data.title}</a>
              </h3>
            </div>
            <a
              href={`/reports/${report.slug}`}
              class="shrink-0 px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-emerald-400 transition-colors"
            >
              Read Report &rarr;
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
