---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { path } from '../../utils/paths';

export async function getStaticPaths() {
  const allReports = await getCollection('reports');
  const tickers = new Set<string>();

  for (const report of allReports) {
    tickers.add(report.data.ticker.toUpperCase());
  }

  return Array.from(tickers).map((ticker) => {
    const tickerReports = allReports
      .filter((r) => r.data.ticker.toUpperCase() === ticker)
      .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

    return {
      params: { ticker: ticker.toLowerCase() },
      props: { ticker, reports: tickerReports }
    };
  });
}

const { ticker, reports } = Astro.props;
const latestReport = reports[0];
const companyName = latestReport ? latestReport.data.companyName : ticker;
const sector = latestReport ? latestReport.data.sector : 'Equities';

const pageTitle = `${companyName} ($${ticker}) Fundamental Analysis & Research Hub`;
const pageDescription = `Historical equity research reports, valuation multiples, balance sheet stress tests, and financial health trends for ${companyName} (${ticker}).`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ticker={ticker}
  companyName={companyName}
  sector={sector}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb Bar -->
    <nav class="flex items-center gap-2 text-xs text-[#8e8e8e] mb-4 font-mono">
      <a href={path('/')} class="hover:text-[#38bdf8] transition-none">RADAR</a>
      <span>&rsaquo;</span>
      <a href={path('/reports')} class="hover:text-[#38bdf8] transition-none">DATABASE</a>
      <span>&rsaquo;</span>
      <span class="text-white">${ticker} ARCHIVE</span>
    </nav>

    <!-- Header -->
    <div class="mb-6 pb-4 border-b border-[#2e2e2e] font-mono">
      <div class="flex items-center gap-3 mb-2">
        <span class="font-black text-xl text-white bg-[#181818] px-3 py-1 border border-[#38bdf8]">
          ${ticker}
        </span>
        <div>
          <h1 class="text-2xl font-bold text-white tracking-tight uppercase">{companyName}</h1>
          <p class="text-xs text-[#8e8e8e] mt-0.5">
            {latestReport ? `${latestReport.data.exchange} · ${sector} · ${latestReport.data.industry}` : 'EQUITY RESEARCH'}
          </p>
        </div>
      </div>
      <p class="text-xs text-[#8e8e8e] mt-2 max-w-3xl leading-relaxed">
        Systematic equity dossier for {companyName}. Evaluation of balance sheet solvency, cash flow generation, and consensus valuation models.
      </p>
    </div>

    <!-- Coverage History Feed -->
    <div>
      <div class="flex items-center justify-between pb-3 mb-4 border-b border-[#2e2e2e] font-mono">
        <h2 class="text-sm font-bold text-white uppercase">Historical Research Coverage ({reports.length} Reports)</h2>
        <span class="text-xs text-[#8e8e8e]">SORT: CHRONOLOGICAL DESCENDING</span>
      </div>
      
      <div class="divide-y divide-[#222222] border border-[#2e2e2e] bg-[#181818]">
        {reports.map((report) => (
          <article class="p-3.5 hover:bg-[#1f1f1f] transition-none flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono text-xs">
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 text-[10px] text-[#8e8e8e] mb-1">
                <time datetime={new Date(report.data.publishDate).toISOString()}>
                  {new Date(report.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span>&bull;</span>
                <span class={`font-bold ${report.data.movePercent >= 0 ? 'text-[#00cc66]' : 'text-[#ff3344]'}`}>
                  {report.data.movePercent >= 0 ? '+' : ''}{report.data.movePercent.toFixed(2)}% MOVE
                </span>
                <span>&bull;</span>
                <span>P/E: <strong class="text-white">{report.data.peRatio ? `${report.data.peRatio.toFixed(1)}x` : 'N/A'}</strong></span>
                <span>&bull;</span>
                <span>CAP: <strong class="text-white">${(report.data.marketCap / 1e9).toFixed(1)}B</strong></span>
              </div>
              <h3 class="text-sm font-bold text-white hover:text-[#38bdf8] transition-none truncate">
                <a href={path(`/reports/${report.slug}`)}>{report.data.title}</a>
              </h3>
            </div>
            <a
              href={path(`/reports/${report.slug}`)}
              class="shrink-0 px-3 py-1 bg-[#121212] hover:bg-[#38bdf8] hover:text-slate-950 text-[#38bdf8] border border-[#4b5563] font-bold text-xs transition-none tap-target"
            >
              [ VIEW REPORT ]
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
